    interviewQuestions: [
      {
        question: "What is multi-cloud architecture?",
        answer: "Multi-cloud architecture uses services from two or more cloud providers within an organization's technology environment. It can support business requirements such as geographic coverage, regulatory needs, specialized services or resilience. It also introduces additional networking, identity, data, cost and operational complexity. A good design has clear workload placement and ownership rather than distributing services across providers without a reason."
      },
      {
        question: "Does multi-cloud automatically provide high availability?",
        answer: "No. A second provider does not automatically provide high availability. The application must have deployable capacity, accessible and consistent data, working identity, valid network paths, tested traffic steering and operational procedures in the recovery provider. Teams must test real application transactions during failover and measure whether recovery meets the required RTO and RPO."
      },
      {
        question: "How do you connect two cloud providers securely?",
        answer: "Connectivity can use supported private interconnects, site-to-site VPN or secured application APIs depending on bandwidth, latency and security requirements. The design needs non-overlapping CIDR ranges, controlled route exchange, firewall restrictions, encryption, monitoring and redundant paths where required. Private connectivity is not a replacement for identity checks or application authorization."
      },
      {
        question: "What are the main challenges of multi-cloud data replication?",
        answer: "The main challenges include different database capabilities, consistency models, replication lag, data ownership, schema compatibility, transfer costs and data residency requirements. Teams should identify the system of record, define acceptable data loss, prevent conflicting writes and test restoration. Replication should be selected according to business recovery objectives rather than assumed to provide identical copies."
      },
      {
        question: "How can an organization reduce multi-cloud operational complexity?",
        answer: "Organizations can reduce complexity through clear workload ownership, reusable infrastructure modules, federated identity, common tagging and naming rules, correlated observability, documented provider-specific runbooks and cost governance. Standardization should focus on common operational outcomes while allowing provider-specific implementations where necessary. Regular recovery exercises help prove that these controls work."
      },
      {
        question: "What should a multi-cloud disaster recovery test validate?",
        answer: "A recovery test should validate that the secondary environment has sufficient capacity, correct application versions, working identity, network connectivity, secrets, certificates and access to usable data. It should also verify global traffic changes, user transactions, monitoring and incident ownership. Measure actual RTO and RPO, record gaps and test failback only after data consistency is confirmed."
      }
    ]
  },};

export function getArchitectureTopic(topic: string) {
  const key = topic.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  return architectureTopicContent[key] ?? null;
}

