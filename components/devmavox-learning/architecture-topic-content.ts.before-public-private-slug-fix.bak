      {
        decision: "Single Availability Zone or multiple Availability Zones?",
        guidance: "Use multiple Availability Zones for production workloads where zone-level failure must not stop the service. A single-zone design may be acceptable for disposable development environments."
      },
      {
        decision: "Public or private application instances?",
        guidance: "Prefer private application instances behind a public load balancer unless the workload has a specific, reviewed reason to expose compute directly."
      },
      {
        decision: "NAT Gateway or VPC endpoints?",
        guidance: "Use NAT for required outbound internet access. Consider VPC endpoints for supported AWS services to keep service traffic on private connectivity paths and reduce NAT dependency."
      },
      {
        decision: "Multi-AZ database or read replicas?",
        guidance: "Choose Multi-AZ for availability and failover requirements. Choose read replicas when supported read-scaling or a separate replication use case is required; validate engine-specific behavior."
