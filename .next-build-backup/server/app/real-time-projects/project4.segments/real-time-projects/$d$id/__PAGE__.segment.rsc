3b:["$","h1","h1-6",{"children":"⚠️ 6. Before You Start — AWS Cost and Safety"}]
3c:["$","p","p-9",{"children":"You can create the repository, read the code, format Terraform, render a plan with suitable local setup, and validate Ansible without creating an EC2 instance. Some Terraform validation steps may need provider plugins to be downloaded."}]
3d:["$","h2","h2-5",{"children":"🔐 Safety rules"}]
3e:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":"Do not commit AWS access keys, SSH private keys, passwords, or Terraform state."}],"\n",["$","li","li-1",{"children":"Do not use the AWS root account for routine automation."}],"\n",["$","li","li-2",{"children":"Use an IAM identity with only the permissions needed for the exercise."}],"\n",["$","li","li-3",{"children":"Review every plan before applying."}],"\n",["$","li","li-4",{"children":["Do not open SSH (",["$","code","code-0",{"children":"22"}],") to the entire internet (",["$","code","code-1",{"children":"0.0.0.0/0"}],") as a default."]}],"\n",["$","li","li-5",{"children":"Prefer private networking and controlled access for real workloads."}],"\n",["$","li","li-6",{"children":"Do not create NAT gateways, load balancers, or multiple instances unless the project needs them; they may add cost."}],"\n",["$","li","li-7",{"children":"Set a budget alert, but remember that alerts do not automatically stop charges."}],"\n",["$","li","li-8",{"children":"Confirm the AWS region and active account before running commands."}],"\n",["$","li","li-9",{"children":"Run cleanup only after verifying that resources belong to this project."}],"\n"]}]
3f:["$","h2","h2-6",{"children":"💸 Cost awareness"}]
40:["$","p","p-10",{"children":"AWS charges depend on region, resource type, storage, networking, and usage. An EC2 instance, public IPv4 address, EBS volume, NAT gateway, and data transfer may have separate costs. Check current pricing before provisioning. A resource being small or used for a short time does not guarantee it is free."}]
41:["$","hr","hr-6",{}]
42:["$","h1","h1-7",{"children":"🧩 7. Prerequisites and Version Checks"}]
43:["$","p","p-11",{"children":"Install the tools on your local machine or a suitable development environment."}]
44:["$","pre","pre-4",{"children":["$","code","code-0",{"className":"language-bash","children":"git --version\r\nterraform version\r\nansible --version\r\naws --version\r\nssh -V\n"}]}]
45:["$","p","p-12",{"children":"For GitHub Actions, CI can run code checks without AWS credentials if it only formats and validates the repository. Do not add cloud credentials merely to make a basic validation workflow pass."}]
46:["$","h2","h2-7",{"children":"7.1 Confirm AWS identity (only if AWS access is configured)"}]
47:["$","pre","pre-5",{"children":["$","code","code-0",{"className":"language-bash","children":"aws sts get-caller-identity\r\naws configure list\n"}]}]
48:["$","p","p-13",{"children":"Check the returned account and identity before making changes. Never paste credential values into the repository or public issue."}]
49:["$","h2","h2-8",{"children":"7.2 Choose a region"}]
4a:["$","p","p-14",{"children":["For example, you might use ",["$","code","code-0",{"children":"ap-south-1"}]," (Mumbai) if that is suitable for your use case. Availability and pricing vary. Use one region consistently throughout this exercise."]}]
4b:["$","hr","hr-7",{}]
4c:["$","h1","h1-8",{"children":"🟪 8. Terraform — Build the Infrastructure Layer"}]
4d:["$","h2","h2-9",{"children":["8.1 ",["$","code","code-0",{"children":"terraform/versions.tf"}]]}]
4e:["$","pre","pre-6",{"children":["$","code","code-0",{"className":"language-hcl","children":"terraform {\r\n  required_version = \">= 1.6.0, < 2.0.0\"\r\n\r\n  required_providers {\r\n    aws = {\r\n      source  = \"hashicorp/aws\"\r\n      version = \"~> 5.0\"\r\n    }\r\n  }\r\n}\n"}]}]
4f:["$","p","p-15",{"children":["This declares compatible version constraints. In a real team repository, use a reviewed provider version and commit ",["$","code","code-0",{"children":".terraform.lock.hcl"}]," to improve reproducibility."]}]
50:["$","h2","h2-10",{"children":["8.2 ",["$","code","code-0",{"children":"terraform/providers.tf"}]]}]
51:["$","pre","pre-7",{"children":["$","code","code-0",{"className":"language-hcl","children":"provider \"aws\" {\r\n  region = var.aws_region\r\n\r\n  default_tags {\r\n    tags = {\r\n      Project     = var.project_name\r\n      Environment = var.environment\r\n      ManagedBy   = \"Terraform\"\r\n    }\r\n  }\r\n}\n"}]}]
52:["$","h2","h2-11",{"children":["8.3 ",["$","code","code-0",{"children":"terraform/variables.tf"}]]}]
10d:T521,variable "aws_region" {
  description = "AWS region for this environment"
  type        = string
  default     = "ap-south-1"
}

variable "project_name" {
  description = "Short project name used in resource naming and tags"
  type        = string
  default     = "cloudkart"
}

variable "environment" {
  description = "Environment name"
  type        = string
  default     = "dev"
}

variable "vpc_cidr" {
  description = "CIDR range for the project VPC"
  type        = string
  default     = "10.20.0.0/16"
}

variable "public_subnet_cidr" {
  description = "CIDR range for the demo public subnet"
  type        = string
  default     = "10.20.1.0/24"
}

variable "ssh_allowed_cidr" {
  description = "Your trusted public IP in CIDR notation, e.g. 203.0.113.10/32"
  type        = string

  validation {
    condition     = can(cidrhost(var.ssh_allowed_cidr, 0)) && !contains(["0.0.0.0/0"], var.ssh_allowed_cidr)
    error_message = "Provide a valid, restricted CIDR. Do not use 0.0.0.0/0 for SSH."
  }
}

variable "instance_type" {
  description = "EC2 instance type for the learning environment"
  type        = string
  default     = "t3.micro"
}

variable "ami_id" {
  description = "A valid Linux AMI ID for the selected region"
  type        = string
}
53:["$","pre","pre-8",{"children":["$","code","code-0",{"className":"language-hcl","children":"$10d"}]}]
54:["$","p","p-16",{"children":["The ",["$","code","code-0",{"children":"ami_id"}]," is deliberately an input because AMI IDs differ by region and are updated over time. Supply a verified ID for the chosen Linux distribution and region. Do not assume an AMI ID works everywhere."]}]
55:["$","h2","h2-12",{"children":["8.4 ",["$","code","code-0",{"children":"terraform/network.tf"}]]}]
56:["$","pre","pre-9",{"children":["$","code","code-0",{"className":"language-hcl","children":"resource \"aws_vpc\" \"main\" {\r\n  cidr_block           = var.vpc_cidr\r\n  enable_dns_support   = true\r\n  enable_dns_hostnames = true\r\n\r\n  tags = {\r\n    Name = \"${var.project_name}-${var.environment}-vpc\"\r\n  }\r\n}\r\n\r\nresource \"aws_internet_gateway\" \"main\" {\r\n  vpc_id = aws_vpc.main.id\r\n\r\n  tags = {\r\n    Name = \"${var.project_name}-${var.environment}-igw\"\r\n  }\r\n}\r\n\r\nresource \"aws_subnet\" \"public\" {\r\n  vpc_id                  = aws_vpc.main.id\r\n  cidr_block              = var.public_subnet_cidr\r\n  map_public_ip_on_launch = true\r\n\r\n  tags = {\r\n    Name = \"${var.project_name}-${var.environment}-public-subnet\"\r\n  }\r\n}\r\n\r\nresource \"aws_route_table\" \"public\" {\r\n  vpc_id = aws_vpc.main.id\r\n\r\n  route {\r\n    cidr_block = \"0.0.0.0/0\"\r\n    gateway_id = aws_internet_gateway.main.id\r\n  }\r\n\r\n  tags = {\r\n    Name = \"${var.project_name}-${var.environment}-public-rt\"\r\n  }\r\n}\r\n\r\nresource \"aws_route_table_association\" \"public\" {\r\n  subnet_id      = aws_subnet.public.id\r\n  route_table_id = aws_route_table.public.id\r\n}\n"}]}]
57:["$","blockquote","blockquote-3",{"children":["\n",["$","p","p-0",{"children":["🟥 ",["$","strong","strong-0",{"children":"Learning environment warning:"}]," This is a deliberately simple public-subnet demonstration. A production architecture should assess whether servers can remain private, how administrators connect, and which controlled egress path is appropriate. A public IP alone does not guarantee reachability; routing and security rules also matter."]}],"\n"]}]
58:["$","h2","h2-13",{"children":["8.5 ",["$","code","code-0",{"children":"terraform/security_groups.tf"}]]}]
59:["$","pre","pre-10",{"children":["$","code","code-0",{"className":"language-hcl","children":"resource \"aws_security_group\" \"web\" {\r\n  name        = \"${var.project_name}-${var.environment}-web-sg\"\r\n  description = \"Restricted SSH and HTTP access for the demo\"\r\n  vpc_id      = aws_vpc.main.id\r\n\r\n  ingress {\r\n    description = \"SSH from trusted administrator CIDR only\"\r\n    from_port   = 22\r\n    to_port     = 22\r\n    protocol    = \"tcp\"\r\n    cidr_blocks = [var.ssh_allowed_cidr]\r\n  }\r\n\r\n  ingress {\r\n    description = \"HTTP demo endpoint\"\r\n    from_port   = 80\r\n    to_port     = 80\r\n    protocol    = \"tcp\"\r\n    cidr_blocks = [\"0.0.0.0/0\"]\r\n  }\r\n\r\n  egress {\r\n    description = \"Outbound IPv4 for package download in this demo\"\r\n    from_port   = 0\r\n    to_port     = 0\r\n    protocol    = \"-1\"\r\n    cidr_blocks = [\"0.0.0.0/0\"]\r\n  }\r\n\r\n  tags = {\r\n    Name = \"${var.project_name}-${var.environment}-web-sg\"\r\n  }\r\n}\n"}]}]
5a:["$","p","p-17",{"children":"The HTTP rule is public for a simple demonstration. For production, put a suitable edge layer in front, use HTTPS, and restrict access as required. Security-group egress is broad in this learning example; tighten it where the architecture supports explicit destinations."}]
5b:["$","h2","h2-14",{"children":["8.6 ",["$","code","code-0",{"children":"terraform/compute.tf"}]]}]
5c:["$","pre","pre-11",{"children":["$","code","code-0",{"className":"language-hcl","children":"resource \"aws_instance\" \"web\" {\r\n  ami                         = var.ami_id\r\n  instance_type               = var.instance_type\r\n  subnet_id                   = aws_subnet.public.id\r\n  vpc_security_group_ids      = [aws_security_group.web.id]\r\n  associate_public_ip_address = true\r\n\r\n  metadata_options {\r\n    http_tokens = \"required\"\r\n  }\r\n\r\n  root_block_device {\r\n    encrypted             = true\r\n    delete_on_termination = true\r\n    volume_size           = 8\r\n    volume_type           = \"gp3\"\r\n  }\r\n\r\n  tags = {\r\n    Name = \"${var.project_name}-${var.environment}-web\"\r\n    Role = \"web\"\r\n  }\r\n}\n"}]}]
5d:["$","p","p-18",{"children":"This instance resource does not specify an SSH key pair. To use SSH/Ansible, you must configure a secure access method for the selected AMI and environment. Options include a preconfigured key pair or AWS Systems Manager where supported and configured. Do not place a private key in Terraform code or Git."}]
5e:["$","h2","h2-15",{"children":["8.7 ",["$","code","code-0",{"children":"terraform/outputs.tf"}]]}]
5f:["$","pre","pre-12",{"children":["$","code","code-0",{"className":"language-hcl","children":"output \"vpc_id\" {\r\n  description = \"ID of the project VPC\"\r\n  value       = aws_vpc.main.id\r\n}\r\n\r\noutput \"public_subnet_id\" {\r\n  description = \"ID of the public subnet\"\r\n  value       = aws_subnet.public.id\r\n}\r\n\r\noutput \"instance_id\" {\r\n  description = \"EC2 instance ID\"\r\n  value       = aws_instance.web.id\r\n}\r\n\r\noutput \"instance_public_ip\" {\r\n  description = \"Public IPv4 address of the demo instance\"\r\n  value       = aws_instance.web.public_ip\r\n}\n"}]}]
60:["$","p","p-19",{"children":"Outputs are useful for later steps, but avoid outputting credentials, private keys, or sensitive values. Treat Terraform state as sensitive even if your declared outputs look harmless."}]
61:["$","h2","h2-16",{"children":["8.8 ",["$","code","code-0",{"children":"terraform/terraform.tfvars.example"}]]}]
62:["$","pre","pre-13",{"children":["$","code","code-0",{"className":"language-hcl","children":"aws_region          = \"ap-south-1\"\r\nproject_name        = \"cloudkart\"\r\nenvironment         = \"dev\"\r\nvpc_cidr            = \"10.20.0.0/16\"\r\npublic_subnet_cidr  = \"10.20.1.0/24\"\r\nssh_allowed_cidr    = \"REPLACE_WITH_YOUR_PUBLIC_IP/32\"\r\ninstance_type       = \"t3.micro\"\r\nami_id              = \"REPLACE_WITH_VALID_AMI_ID\"\n"}]}]
63:["$","p","p-20",{"children":["Copy this file to ",["$","code","code-0",{"children":"terraform.tfvars"}]," and replace the placeholders locally. Do not commit your personal ",["$","code","code-1",{"children":"terraform.tfvars"}]," if it contains environment-specific or sensitive data. The example file should never contain secrets."]}]
64:["$","h2","h2-17",{"children":["8.9 ",["$","code","code-0",{"children":"terraform/README.md"}]]}]
