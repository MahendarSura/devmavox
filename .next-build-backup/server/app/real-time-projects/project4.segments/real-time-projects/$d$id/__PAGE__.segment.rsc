bc:["$","h1","h1-17",{"children":"🧹 17. Cleanup — Avoid Unwanted Charges"}]
bd:["$","p","p-44",{"children":"If you intentionally created resources for this project, remove them when finished."}]
be:["$","h2","h2-32",{"children":"Step 1 — Stop configuration activity"}]
bf:["$","p","p-45",{"children":"Do not run Ansible while the target host is being destroyed. Make sure no teammate or workflow is using the same environment."}]
c0:["$","h2","h2-33",{"children":"Step 2 — Review the destroy plan"}]
c1:["$","p","p-46",{"children":"Run from the same Terraform directory and with the correct state, workspace, AWS account, and region:"}]
c2:["$","pre","pre-29",{"children":["$","code","code-0",{"className":"language-bash","children":"terraform plan -destroy\n"}]}]
c3:["$","p","p-47",{"children":"Review every proposed deletion. If unrelated resources appear, stop and investigate."}]
c4:["$","h2","h2-34",{"children":"Step 3 — Destroy only the intended project resources"}]
c5:["$","pre","pre-30",{"children":["$","code","code-0",{"className":"language-bash","children":"terraform destroy\n"}]}]
c6:["$","p","p-48",{"children":"Confirm only after verifying the proposed resources and understanding the consequences."}]
c7:["$","h2","h2-35",{"children":"Step 4 — Verify in AWS"}]
c8:["$","p","p-49",{"children":"Inspect the relevant services for leftovers, including:"}]
c9:["$","ul","ul-10",{"children":["\n",["$","li","li-0",{"children":"EC2 instances"}],"\n",["$","li","li-1",{"children":"EBS volumes and snapshots"}],"\n",["$","li","li-2",{"children":"Elastic/public IP allocations"}],"\n",["$","li","li-3",{"children":"VPC and subnets"}],"\n",["$","li","li-4",{"children":"Internet gateways and route tables"}],"\n",["$","li","li-5",{"children":"Security groups"}],"\n",["$","li","li-6",{"children":"Any additional resources you created"}],"\n"]}]
ca:["$","p","p-50",{"children":["Terraform may not manage manually created or separately managed resources. Do not assume ",["$","code","code-0",{"children":"terraform destroy"}]," removes every resource in an AWS account."]}]
cb:["$","blockquote","blockquote-6",{"children":["\n",["$","p","p-0",{"children":"🛑 Never run destroy against a shared or production state without an approved change process, a verified backup/recovery plan, and explicit authorization."}],"\n"]}]
cc:["$","hr","hr-17",{}]
cd:["$","h1","h1-18",{"children":"🎤 18. DevOps Interview Questions and Answers"}]
ce:["$","h3","h3-9",{"children":"Q1. What is Infrastructure as Code?"}]
cf:["$","p","p-51",{"children":"Infrastructure as Code means describing infrastructure in version-controlled configuration files so it can be reviewed, repeated, and managed systematically rather than relying entirely on manual console steps."}]
d0:["$","h3","h3-10",{"children":"Q2. What is Terraform?"}]
d1:["$","p","p-52",{"children":"Terraform is an IaC tool that compares declared configuration with tracked and observed infrastructure to propose and apply changes through providers."}]
d2:["$","h3","h3-11",{"children":"Q3. What is Ansible?"}]
d3:["$","p","p-53",{"children":"Ansible is an automation and configuration-management tool that uses inventories and playbooks to perform repeatable tasks on managed hosts."}]
d4:["$","h3","h3-12",{"children":"Q4. Terraform vs Ansible?"}]
d5:["$","p","p-54",{"children":"Terraform is commonly used to provision cloud infrastructure. Ansible is commonly used to configure operating systems, packages, files, and services. They can be combined in one workflow."}]
d6:["$","h3","h3-13",{"children":"Q5. What is Terraform state?"}]
d7:["$","p","p-55",{"children":"State records Terraform's mapping between configuration and managed objects, along with resource attributes needed to plan changes. It can contain sensitive data, so it must be protected and access-controlled."}]
d8:["$","h3","h3-14",{"children":["Q6. What is the difference between ",["$","code","code-0",{"children":"plan"}]," and ",["$","code","code-1",{"children":"apply"}],"?"]}]
d9:["$","p","p-56",{"children":[["$","code","code-0",{"children":"plan"}]," previews proposed changes. ",["$","code","code-1",{"children":"apply"}]," executes changes after confirmation or according to the configured automation. Apply can create, modify, or delete billable resources."]}]
da:["$","h3","h3-15",{"children":"Q7. What is a VPC?"}]
db:["$","p","p-57",{"children":"A Virtual Private Cloud is a logically isolated network in AWS where you define IP ranges, subnets, routes, and network controls."}]
dc:["$","h3","h3-16",{"children":"Q8. What is a subnet?"}]
dd:["$","p","p-58",{"children":"A subnet is an IP range within a VPC associated with an Availability Zone. Its routing and related configuration influence whether resources have public or private connectivity."}]
de:["$","h3","h3-17",{"children":"Q9. What is a security group?"}]
df:["$","p","p-59",{"children":"A security group is a stateful virtual firewall associated with supported AWS resources. Its rules control allowed inbound and outbound traffic."}]
e0:["$","h3","h3-18",{"children":"Q10. What is an Ansible inventory?"}]
e1:["$","p","p-60",{"children":"An inventory identifies the hosts or groups that Ansible should target and can include connection details and variables."}]
e2:["$","h3","h3-19",{"children":"Q11. What does idempotence mean in Ansible?"}]
e3:["$","p","p-61",{"children":"An idempotent task converges the system to a declared state and, when run again without relevant drift, generally makes no additional change."}]
e4:["$","h3","h3-20",{"children":"Q12. Why is SSH open to the internet risky?"}]
e5:["$","p","p-62",{"children":"A public SSH endpoint increases exposure to scanning and attack attempts. Restrict the source, use strong key-based or approved managed access, keep systems updated, and avoid broad access rules."}]
e6:["$","h3","h3-21",{"children":"Q13. What is the purpose of GitHub Actions in this project?"}]
e7:["$","p","p-63",{"children":"It automatically checks formatting and configuration syntax/validity on code changes. The sample workflow does not provision infrastructure or prove that a live deployment is healthy."}]
e8:["$","h3","h3-22",{"children":"Q14. How do you troubleshoot Terraform when the plan wants to destroy a resource?"}]
e9:["$","p","p-64",{"children":"I stop before applying, inspect the plan, verify the current workspace/backend and resource addresses, check configuration changes and state, and only proceed once I understand the intended impact."}]
ea:["$","h3","h3-23",{"children":"Q15. How would you improve this project for production?"}]
eb:["$","p","p-65",{"children":"I would evaluate private subnets, managed access, remote state with locking and encryption, least-privilege IAM, short-lived CI credentials, policy checks, image/application deployment automation, monitoring, backup/recovery, environment separation, and an approved change process."}]
ec:["$","h2","h2-36",{"children":"🗣️ Sample project explanation"}]
ed:["$","blockquote","blockquote-7",{"children":["\n",["$","p","p-0",{"children":"“I created a Terraform and Ansible infrastructure automation project. Terraform defines the AWS network, security group, and EC2 resources as code. Ansible configures a Linux web server through a controlled management connection. GitHub Actions checks Terraform formatting and validation plus Ansible syntax on changes. I documented state protection, IAM least privilege, network restrictions, troubleshooting, real execution evidence, and cleanup. I validate and review the plan before creating billable AWS resources.”"}],"\n"]}]
ee:["$","p","p-66",{"children":"Use this explanation only for the parts you actually implemented and verified. Be transparent if you completed validation locally but did not deploy to AWS."}]
ef:["$","hr","hr-18",{}]
