10e:T522,---
- name: Configure the CloudKart web server
  hosts: webservers
  become: true
  gather_facts: true

  tasks:
    - name: Install Nginx on Debian-based systems
      ansible.builtin.apt:
        name: "{{ web_package_name }}"
        state: present
        update_cache: true
      when: ansible_os_family == "Debian"

    - name: Install Nginx on Red Hat-based systems
      ansible.builtin.package:
        name: "{{ web_package_name }}"
        state: present
      when: ansible_os_family == "RedHat"

    - name: Ensure the web document root exists
      ansible.builtin.file:
        path: "{{ web_document_root }}"
        state: directory
        owner: root
        group: root
        mode: "0755"

    - name: Deploy the home page
      ansible.builtin.template:
        src: ../templates/index.html.j2
        dest: "{{ web_document_root }}/index.html"
        owner: root
        group: root
        mode: "0644"
      notify: Restart web service

    - name: Ensure Nginx is enabled and running
      ansible.builtin.service:
        name: "{{ web_service_name }}"
        state: started
        enabled: true

  handlers:
    - name: Restart web service
      ansible.builtin.service:
        name: "{{ web_service_name }}"
        state: restarted
