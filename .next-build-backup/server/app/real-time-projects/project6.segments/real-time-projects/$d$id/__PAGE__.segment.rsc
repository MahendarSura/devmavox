4a:["$","p","p-29",{"children":"A VPC is a logically isolated network in AWS."}]
4b:["$","p","p-30",{"children":[["$","strong","strong-0",{"children":"Why use it?"}]," It provides IP address ranges and a network boundary for resources."]}]
4c:["$","p","p-31",{"children":["Example CIDR: ",["$","code","code-0",{"children":"10.20.0.0/16"}],"."]}]
4d:["$","p","p-32",{"children":"A VPC alone does not make a workload public or private. Subnets, route tables, gateways, addressing, and security controls determine connectivity."}]
4e:["$","h3","h3-15",{"children":"🧩 6.4 Subnet"}]
4f:["$","p","p-33",{"children":"A subnet is a range of IP addresses inside a VPC, associated with one Availability Zone."}]
50:["$","p","p-34",{"children":["Example: ",["$","code","code-0",{"children":"10.20.1.0/24"}],"."]}]
51:["$","p","p-35",{"children":"A subnet is commonly called public when its route table has a route to an internet gateway; an instance also needs suitable public addressing and security rules to be reachable from the internet."}]
52:["$","h3","h3-16",{"children":"🚪 6.5 Internet Gateway and Route Table"}]
53:["$","p","p-36",{"children":"An internet gateway provides a target for routes between a VPC and the internet. A route table decides where traffic is sent."}]
