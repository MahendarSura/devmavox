af:["$","ul","ul-7",{"className":"contains-task-list","children":["\n",["$","li","li-0",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Use least-privilege IAM permissions."]}],"\n",["$","li","li-1",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Prefer short-lived credentials or approved role assumption."]}],"\n",["$","li","li-2",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Never commit AWS access keys, state files, plan files, or secrets."]}],"\n",["$","li","li-3",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Restrict SSH to a trusted IP, or use Session Manager."]}],"\n",["$","li","li-4",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Require IMDSv2 on EC2 instances where supported."]}],"\n",["$","li","li-5",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Encrypt storage where appropriate."]}],"\n",["$","li","li-6",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Review all inbound and outbound network rules."]}],"\n",["$","li","li-7",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Protect remote state with access controls, encryption, versioning, and locking."]}],"\n",["$","li","li-8",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Review Terraform plans before applying changes."]}],"\n",["$","li","li-9",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":