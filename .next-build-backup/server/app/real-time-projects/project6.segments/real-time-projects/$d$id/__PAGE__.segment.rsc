55:["$","pre","pre-3",{"children":["$","code","code-0",{"className":"language-text","children":"0.0.0.0/0 -> Internet Gateway\n"}]}]
56:["$","p","p-38",{"children":"That route alone does not guarantee an instance is reachable. Public addressing, security groups, network ACLs, OS firewall rules, and the service listening on the port also matter."}]
