32:["$","table","table-2",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"children":"Stage"}],["$","th","th-1",{"children":"Purpose"}],["$","th","th-2",{"children":"Why it matters"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":["$","code","code-0",{"children":"fmt"}]}],["$","td","td-1",{"children":"Formats configuration"}],["$","td","td-2",{"children":"Keeps code consistent"}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":["$","code","code-0",{"children":"init"}]}],["$","td","td-1",{"children":"Installs providers and initializes backend"}],["$","td","td-2",{"children":"Prepares the working directory"}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":["$","code","code-0",{"children":"validate"}]}],["$","td","td-1",{"children":"Checks configuration structure"}],["$","td","td-2",{"children":"Finds many configuration errors"}]]}],["$","tr","tr-3",{"children":[["$","td","td-0",{"children":["$","code","code-0",{"children":"plan"}]}],["$","td","td-1",{"children":"Previews intended changes"}],["$","td","td-2",{"children":"Gives the engineer a chance to catch mistakes"}]]}],["$","tr","tr-4",{"children":[["$","td","td-0",{"children":["$","code","code-0",{"children":"apply"}]}],["$","td","td-1",{"children":"Applies approved changes"}],["$","td","td-2",{"children":"Creates or updates infrastructure"}]]}],["$","tr","tr-5",{"children":[["$","td","td-0",{"children":["$","code","code-0",{"children":"destroy"}]}],["$","td","td-1",{"children":"Plans and removes managed resources"}],["$","td","td-2",{"children":"Helps clean up a temporary lab"}]]}]]}]]}]
33:["$","h2","h2-7",{"children":"🧠 5. Infrastructure as Code — The Main Concept"}]
34:["$","p","p-19",{"children":"Infrastructure as Code (IaC) means defining infrastructure through machine-readable configuration instead of relying only on manual console steps."}]
35:["$","h3","h3-9",{"children":"Why use IaC?"}]
36:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Repeatability:"}]," Recreate an environment from reviewed configuration."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Version control:"}]," Track who changed the infrastructure definition and when."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Review:"}]," Inspect proposed changes before applying them."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Consistency:"}]," Reuse modules and variables across environments."]}],"\n",["$","li","li-4",{"children":[["$","strong","strong-0",{"children":"Automation:"}]," Run formatting and validation in CI."]}],"\n",["$","li","li-5",{"children":[["$","strong","strong-0",{"children":"Recovery:"}]," Rebuild supported resources from code and state, subject to data and dependency requirements."]}],"\n"]}]
37:["$","h3","h3-10",{"children":"Declarative vs imperative"}]
38:["$","p","p-20",{"children":"Terraform is primarily declarative. You describe the desired end state, and Terraform determines the actions needed to move managed resources toward that state."}]
39:["$","p","p-21",{"children":"For example, you declare an EC2 instance resource. You do not need to write every low-level AWS API call to create it."}]
