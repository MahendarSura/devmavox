6b:["$","pre","pre-5",{"children":["$","code","code-0",{"className":"language-hcl","children":"terraform {\r\n  required_version = \">= 1.6.0\"\r\n\r\n  required_providers {\r\n    aws = {\r\n      source  = \"hashicorp/aws\"\r\n      version = \"~> 5.0\"\r\n    }\r\n  }\r\n}\n"}]}]
6c:["$","p","p-49",{"children":["Provider versions should be tested and updated deliberately. Commit the dependency lock file (",["$","code","code-0",{"children":".terraform.lock.hcl"}],") for reproducible provider selection."]}]
