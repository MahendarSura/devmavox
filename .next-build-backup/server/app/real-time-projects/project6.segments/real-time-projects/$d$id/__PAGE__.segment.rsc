30:["$","pre","pre-1",{"children":["$","code","code-0",{"className":"language-text","children":"Write .tf files\r\n      |\r\n      v\r\nterraform fmt\r\n      |\r\n      v\r\nterraform init\r\n      |\r\n      v\r\nterraform validate\r\n      |\r\n      v\r\nterraform plan\r\n      |\r\n      v\r\nReview every proposed change\r\n      |\r\n      v\r\nterraform apply\r\n      |\r\n      v\r\nVerify AWS resources\r\n      |\r\n      v\r\nterraform destroy (when lab is finished)\n"}]}]
