41:["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":["Write resources and variables in ",["$","code","code-0",{"children":".tf"}]," files."]}],"\n",["$","li","li-1",{"children":["Run ",["$","code","code-0",{"children":"terraform init"}]," to initialize the project."]}],"\n",["$","li","li-2",{"children":["Run ",["$","code","code-0",{"children":"terraform validate"}]," to check the configuration."]}],"\n",["$","li","li-3",{"children":["Run ",["$","code","code-0",{"children":"terraform plan"}]," to preview changes."]}],"\n",["$","li","li-4",{"children":"Review the plan and apply only when authorized."}],"\n",["$","li","li-5",{"children":"Verify the result and manage future changes through code."}],"\n"]}]
