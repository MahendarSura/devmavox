6e:["$","pre","pre-6",{"children":["$","code","code-0",{"className":"language-hcl","children":"provider \"aws\" {\r\n  region = var.aws_region\r\n}\n"}]}]
6f:["$","p","p-50",{"children":"Terraform can use credentials supplied through the AWS CLI profile, environment, or an approved role-assumption setup. Do not place access keys in the provider block."}]
70:["$","h3","h3-23",{"children":["8.3 ",["$","code","code-0",{"children":"variables.tf"}]]}]
71:["$","pre","pre-7",{"children":["$","code","code-0",{"className":"language-hcl","children":"variable \"aws_region\" {\r\n  description = \"AWS region for this learning environment\"\r\n  type        = string\r\n  default     = \"ap-south-1\"\r\n}\r\n\r\nvariable \"project_name\" {\r\n  description = \"Short resource tag/name prefix\"\r\n  type        = string\r\n  default     = \"terraform-demo\"\r\n}\r\n\r\nvariable \"instance_type\" {\r\n  description = \"EC2 instance type; check current pricing\"\r\n  type        = string\r\n  default     = \"t3.micro\"\r\n}\r\n\r\nvariable \"ami_id\" {\r\n  description = \"Valid Linux AMI ID in the selected region\"\r\n  type        = string\r\n}\r\n\r\nvariable \"my_ip_cidr\" {\r\n  description = \"Trusted administrator IPv4 CIDR, ideally a single IP /32\"\r\n  type        = string\r\n\r\n  validation {\r\n    condition     = can(cidrhost(var.my_ip_cidr, 0))\r\n    error_message = \"Provide a valid IPv4 CIDR block.\"\r\n  }\r\n}\n"}]}]
72:["$","h3","h3-24",{"children":["8.4 ",["$","code","code-0",{"children":"main.tf"}]]}]
db:T917,data "aws_availability_zones" "available" {
  state = "available"
}

resource "aws_vpc" "main" {
  cidr_block           = "10.20.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = {
    Name    = "${var.project_name}-vpc"
    Project = var.project_name
  }
}

resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.20.1.0/24"
  availability_zone       = data.aws_availability_zones.available.names[0]
  map_public_ip_on_launch = true

  tags = {
    Name    = "${var.project_name}-public-subnet"
    Project = var.project_name
  }
}

resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "${var.project_name}-igw"
  }
}

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.main.id
  }

  tags = {
    Name = "${var.project_name}-public-rt"
  }
}

resource "aws_route_table_association" "public" {
  subnet_id      = aws_subnet.public.id
  route_table_id = aws_route_table.public.id
}

resource "aws_security_group" "ec2" {
  name        = "${var.project_name}-ec2-sg"
  description = "Restricted SSH for a learning demo"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "SSH from trusted administrator IP only"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.my_ip_cidr]
  }

  egress {
    description = "Outbound connections for the demo"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.project_name}-ec2-sg"
  }
}

resource "aws_instance" "demo" {
  ami                         = var.ami_id
  instance_type               = var.instance_type
  subnet_id                   = aws_subnet.public.id
  vpc_security_group_ids      = [aws_security_group.ec2.id]
  associate_public_ip_address = true

  metadata_options {
    http_endpoint               = "enabled"
    http_tokens                 = "required"
    http_put_response_hop_limit = 1
  }

  root_block_device {
    encrypted = true
  }

  tags = {
    Name    = "${var.project_name}-ec2"
    Project = var.project_name
  }
}
