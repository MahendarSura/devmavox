7d:["$","h2","h2-11",{"children":"⚙️ 9. GitHub Actions — Terraform Validation"}]
7e:["$","p","p-54",{"children":["Create ",["$","code","code-0",{"children":".github/workflows/terraform-check.yml"}],":"]}]
7f:["$","pre","pre-12",{"children":["$","code","code-0",{"className":"language-yaml","children":"name: Terraform Checks\r\n\r\non:\r\n  pull_request:\r\n    paths:\r\n      - \"**/*.tf\"\r\n      - \".github/workflows/terraform-check.yml\"\r\n  push:\r\n    branches: [main]\r\n    paths:\r\n      - \"**/*.tf\"\r\n      - \".github/workflows/terraform-check.yml\"\r\n  workflow_dispatch:\r\n\r\npermissions:\r\n  contents: read\r\n\r\njobs:\r\n  validate:\r\n    name: Format and Validate\r\n    runs-on: ubuntu-latest\r\n\r\n    steps:\r\n      - name: Checkout repository\r\n        uses: actions/checkout@v4\r\n\r\n      - name: Setup Terraform\r\n        uses: hashicorp/setup-terraform@v3\r\n        with:\r\n          terraform_version: \"1.6.6\"\r\n\r\n      - name: Terraform Format\r\n        run: terraform fmt -check -recursive\r\n\r\n      - name: Terraform Init\r\n        run: terraform init -backend=false\r\n\r\n      - name: Terraform Validate\r\n        run: terraform validate\n"}]}]
80:["$","p","p-55",{"children":["This workflow validates configuration; it does ",["$","strong","strong-0",{"children":"not"}]," authenticate to AWS, create resources, or prove that a deployment works. For stronger supply-chain controls, review third-party actions and pin them to verified full commit SHAs."]}]
