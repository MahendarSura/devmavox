52:["$","pre","pre-4",{"children":["$","code","code-0",{"className":"language-python","children":"from flask import Flask, jsonify\r\n\r\napp = Flask(__name__)\r\n\r\n\r\n@app.get(\"/\")\r\ndef index():\r\n    return jsonify(\r\n        service=\"shopeasy-api\",\r\n        status=\"running\",\r\n        project=\"end-to-end-devsecops-aws-eks\",\r\n    )\r\n\r\n\r\n@app.get(\"/health\")\r\ndef health():\r\n    return jsonify(status=\"healthy\"), 200\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    app.run(host=\"0.0.0.0\", port=8080)\n"}]}]
