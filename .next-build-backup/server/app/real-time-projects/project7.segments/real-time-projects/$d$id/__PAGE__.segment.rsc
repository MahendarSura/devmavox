71:["$","p","p-36",{"children":["Scanner output must be reviewed. A finding may be exploitable or not, but do not automatically ignore it. If using ",["$","code","code-0",{"children":".trivyignore"}],", document why each exception exists, who approved it, and when it should be reviewed."]}]
72:["$","h1","h1-16",{"children":"⚙️ 15. Secure AWS authentication with OIDC"}]
73:["$","p","p-37",{"children":"GitHub Actions OIDC lets a workflow request a short-lived identity token and exchange it with AWS STS to assume a configured IAM role. This can avoid storing long-lived AWS access keys in GitHub secrets."}]
74:["$","h3","h3-9",{"children":"Required configuration"}]
75:["$","ol","ol-2",{"children":["\n",["$","li","li-0",{"children":"Configure GitHub as an OIDC identity provider in AWS IAM."}],"\n",["$","li","li-1",{"children":"Create a role with a trust policy restricted to the intended repository and branch/environment."}],"\n",["$","li","li-2",{"children":"Grant only required ECR and EKS deployment permissions."}],"\n",["$","li","li-3",{"children":"Add the role ARN and region as non-secret repository/environment variables where appropriate."}],"\n",["$","li","li-4",{"children":"Ensure deployment runs only from approved refs and protected environments."}],"\n",["$","li","li-5",{"children":"Verify role assumption logs without exposing sensitive account information."}],"\n"]}]
76:["$","p","p-38",{"children":"Workflow permission requirement:"}]
77:["$","pre","pre-16",{"children":["$","code","code-0",{"className":"language-yaml","children":"permissions:\r\n  contents: read\r\n  id-token: write\n"}]}]
78:["$","p","p-39",{"children":"The trust policy must validate the expected OIDC audience and subject claims. Do not use an unrestricted subject such as a broad wildcard for production. Exact trust-policy values depend on repository, branch, and environment design."}]
79:["$","p","p-40",{"children":[["$","strong","strong-0",{"children":"Important:"}]," ",["$","code","code-0",{"children":"id-token: write"}]," permits requesting an OIDC token; it does not by itself grant AWS permissions. AWS trust and IAM permissions must also be configured correctly."]}]
7a:["$","h1","h1-17",{"children":"📦 16. Publish image to Amazon ECR"}]
7b:["$","p","p-41",{"children":"Create an ECR repository before running the publish workflow, or provision it through reviewed infrastructure code. Use a unique image tag tied to the commit SHA so the exact build can be identified."}]
7c:["$","p","p-42",{"children":"Example workflow steps for the publishing job:"}]
7d:["$","pre","pre-17",{"children":["$","code","code-0",{"className":"language-yaml","children":"- name: Configure AWS credentials\r\n  uses: aws-actions/configure-aws-credentials@v4\r\n  with:\r\n    role-to-assume: ${{ vars.AWS_ROLE_ARN }}\r\n    aws-region: ${{ vars.AWS_REGION }}\r\n\r\n- name: Login to Amazon ECR\r\n  id: login-ecr\r\n  uses: aws-actions/amazon-ecr-login@v2\r\n\r\n- name: Build and push image\r\n  env:\r\n    REGISTRY: ${{ steps.login-ecr.outputs.registry }}\r\n    REPOSITORY: shopeasy-api\r\n    IMAGE_TAG: ${{ github.sha }}\r\n  run: |\r\n    docker build -t \"$REGISTRY/$REPOSITORY:$IMAGE_TAG\" .\r\n    docker push \"$REGISTRY/$REPOSITORY:$IMAGE_TAG\"\n"}]}]
7e:["$","p","p-43",{"children":"This is a snippet, not a complete workflow by itself. Put it in a correctly gated job after tests and security checks, and configure the role permissions and repository name. Pin third-party actions to reviewed full commit SHAs for stronger supply-chain controls."}]
7f:["$","p","p-44",{"children":"Use the full image URI in Kubernetes configuration. In more controlled release systems, record and deploy the image digest as well as the tag."}]
80:["$","h1","h1-18",{"children":"☸️ 17. Deploy to AWS EKS"}]
81:["$","h2","h2-6",{"children":"17.1 Kubernetes Deployment"}]
82:["$","p","p-45",{"children":["Create ",["$","code","code-0",{"children":"k8s/deployment.yaml"}],":"]}]
c7:T506,apiVersion: apps/v1
kind: Deployment
metadata:
  name: shopeasy-api
  labels:
    app: shopeasy-api
spec:
  replicas: 2
  selector:
    matchLabels:
      app: shopeasy-api
  template:
    metadata:
      labels:
        app: shopeasy-api
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: api
          image: ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/shopeasy-api:REPLACE_WITH_COMMIT_SHA
          ports:
            - name: http
              containerPort: 8080
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: "100m"
              memory: "128Mi"
            limits:
              cpu: "500m"
              memory: "256Mi"
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 20
