9a:["$","ul","ul-9",{"children":["\n",["$","li","li-0",{"children":["Never commit AWS credentials, tokens, ",["$","code","code-0",{"children":".env"}]," files, or Kubernetes secrets."]}],"\n",["$","li","li-1",{"children":"Use OIDC and short-lived role credentials where possible."}],"\n",["$","li","li-2",{"children":"Restrict role trust to the expected repository and branch/environment."}],"\n",["$","li","li-3",{"children":"Separate pull-request validation permissions from deployment permissions."}],"\n",["$","li","li-4",{"children":"Use least-privilege IAM and EKS access."}],"\n",["$","li","li-5",{"children":"Scan dependencies, source, and container images."}],"\n",["$","li","li-6",{"children":"Use minimal base images and run as a non-root user."}],"\n",["$","li","li-7",{"children":"Drop Linux capabilities and disable privilege escalation where compatible."}],"\n",["$","li","li-8",{"children":"Set CPU/memory requests and limits."}],"\n",["$","li","li-9",{"children":"Use readiness/liveness probes thoughtfully."}],"\n",["$","li","li-10",{"children":"Use Kubernetes Secrets only with suitable encryption/access controls; consider an approved external secrets manager for sensitive workloads."}],"\n",["$","li","li-11",{"children":"Restrict network access and use TLS at the ingress/load balancer layer."}],"\n",["$","li","li-12",{"children":"Pin dependencies and GitHub Actions to reviewed versions/SHAs."}],"\n",["$","li","li-13",{"children":"Protect main branch and production environment with review/approval."}],"\n",["$","li","li-14",{"children":"Keep an exception register for accepted vulnerabilities."}],"\n",["$","li","li-15",{"children":"Enable audit/logging appropriate to the environment."}],"\n",["$","li","li-16",{"children":"Set AWS budgets and a cleanup plan."}],"\n"]}]
