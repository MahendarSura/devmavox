ae:["$","blockquote","blockquote-2",{"children":["\n",["$","p","p-0",{"children":"“I designed an end-to-end DevSecOps workflow for a Python API targeting AWS EKS. The pipeline runs automated tests and security checks, builds a Docker image, scans the image, and publishes a commit-specific artifact to Amazon ECR. For AWS authentication, I use GitHub OIDC with a scoped IAM role instead of long-lived access keys. Kubernetes manifests define the Deployment and Service with probes, resource requests/limits, and container security settings. After deployment, I verify rollout status and application health, inspect logs on failure, and document rollback and cleanup. I keep CI validation separate from actual AWS deployment evidence.”"}],"\n"]}]
af:["$","p","p-61",{"children":"If you only ran local tests and did not deploy to AWS EKS, say so clearly. Local validation is not proof of a live cluster deployment."}]
b0:["$","h2","h2-11",{"children":"Interview questions"}]
b1:["$","ol","ol-5",{"children":["\n",["$","li","li-0",{"children":"DevSecOps ante enti? DevOps tho difference enti?"}],"\n",["$","li","li-1",{"children":"Shift-left security ante enti?"}],"\n",["$","li","li-2",{"children":"CI and CD madhya difference enti?"}],"\n",["$","li","li-3",{"children":"GitHub Actions workflow, job, step, and runner ante enti?"}],"\n",["$","li","li-4",{"children":"Why should pull-request workflows not receive production credentials?"}],"\n",["$","li","li-5",{"children":"Docker image and container difference enti?"}],"\n",["$","li","li-6",{"children":"Why run containers as non-root?"}],"\n",["$","li","li-7",{"children":"Trivy image scan em identify chestundi?"}],"\n",["$","li","li-8",{"children":"Vulnerability exception ni ela manage chestaru?"}],"\n",["$","li","li-9",{"children":"GitHub OIDC and AWS IAM role ela work chestayi?"}],"\n",["$","li","li-10",{"children":"AWS access keys GitHub secrets lo store cheyyakunda enduku undali?"}],"\n",["$","li","li-11",{"children":"Amazon ECR purpose enti?"}],"\n",["$","li","li-12",{"children":"EKS and Kubernetes madhya relation enti?"}],"\n",["$","li","li-13",{"children":"Deployment, ReplicaSet, Pod, and Service ante enti?"}],"\n",["$","li","li-14",{"children":"Readiness and liveness probes madhya difference enti?"}],"\n",["$","li","li-15",{"children":[["$","code","code-0",{"children":"ImagePullBackOff"}]," ni ela troubleshoot chestaru?"]}],"\n",["$","li","li-16",{"children":[["$","code","code-0",{"children":"CrashLoopBackOff"}]," ni ela troubleshoot chestaru?"]}],"\n",["$","li","li-17",{"children":"Kubernetes resource requests and limits enduku?"}],"\n",["$","li","li-18",{"children":[["$","code","code-0",{"children":"kubectl rollout undo"}]," eppudu use chestaru?"]}],"\n",["$","li","li-19",{"children":"How do you prove that a release deployed the exact image that was scanned?"}],"\n",["$","li","li-20",{"children":"Why should deployment permissions be least-privilege?"}],"\n",["$","li","li-21",{"childre