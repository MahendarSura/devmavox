1c:["$","p","p-3",{"children":"A team needs a predictable way to create the same basic cloud infrastructure across development and testing environments. Manually creating a VPC, subnet, route table, security group, and EC2 instance is repetitive and can lead to configuration drift."}]
1d:["$","p","p-4",{"children":"Terraform lets the team describe the desired infrastructure in version-controlled files, review a plan, and apply approved changes."}]
1e:["$","h3","h3-3",{"children":"🟩 Project goals"}]
1f:["$","ul","ul-3",{"children":["\n",["$","li","li-0",{"children":"Create a custom network in AWS."}],"\n",["$","li","li-1",{"children":"Add a public subnet with internet routing."}],"\n",["$","li","li-2",{"children":"Allow SSH only from an explicitly configured trusted CIDR."}],"\n",["$","li","li-3",{"children":"Launch an EC2 instance using a selected AMI and instance type."}],"\n",["$","li","li-4",{"children":"Output the created resource IDs and public IP."}],"\n",["$","li","li-5",{"children":"Keep changes reviewable and cleanup documented."}],"\n"]}]
