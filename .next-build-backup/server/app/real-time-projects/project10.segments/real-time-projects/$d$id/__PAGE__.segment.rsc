2a:["$","p","p-6",{"children":"Use an AWS CLI profile or your organization's approved identity method. For a local learning machine, one option is:"}]
2b:["$","pre","pre-2",{"children":["$","code","code-0",{"className":"language-bash","children":"aws configure\r\naws sts get-caller-identity\n"}]}]
2c:["$","p","p-7",{"children":"The second command should return the identity associated with the credentials currently in use."}]
2d:["$","blockquote","blockquote-1",{"children":["\n",["$","p","p-0",{"children":["[!WARNING]\r\nDo not paste access keys into Terraform files, ",["$","code","code-0",{"children":"terraform.tfvars"}],", source control, screenshots, or chat. Prefer IAM roles or short-lived credentials where available. Grant only the permissions required for the lab."]}],"\n"]}]
2e:["$","h2","h2-7",{"children":"🧱 Build the Terraform configuration"}]
2f:["$","p","p-8",{"children":["Create a new folder named ",["$","code","code-0",{"children":"project-10-aws-terraform-iac"}]," and add the files below."]}]
30:["$","h3","h3-5",{"children":["1️⃣ ",["$","code","code-0",{"children":"versions.tf"}]]}]
31:["$","pre","pre-3",{"children":["$","code","code-0",{"className":"language-terraform","children":"terraform {\r\n  required_version = \">= 1.5.0\"\r\n\r\n  required_providers {\r\n    aws = {\r\n      source  = \"hashicorp/aws\"\r\n      version = \"~> 5.0\"\r\n    }\r\n  }\r\n}\n"}]}]
32:["$","p","p-9",{"children":"This pins the AWS provider to the 5.x minor line and specifies a minimum Terraform CLI version. Review and update version constraints deliberately when maintaining the project."}]
33:["$","h3","h3-6",{"children":["2️⃣ ",["$","code","code-0",{"children":"providers.tf"}]]}]
34:["$","pre","pre-4",{"children":["$","code","code-0",{"className":"language-terraform","children":"provider \"aws\" {\r\n  region = var.aws_region\r\n\r\n  default_tags {\r\n    tags = {\r\n      Project     = \"project-10-aws-terraform-iac\"\r\n      Environment = var.environment\r\n      ManagedBy   = \"Terraform\"\r\n    }\r\n  }\r\n}\n"}]}]
35:["$","h3","h3-7",{"children":["3️⃣ ",["$","code","code-0",{"children":"variables.tf"}]]}]
82:T4c8,variable "aws_region" {
  description = "AWS region in which to create the lab."
  type        = string
  default     = "ap-south-1"
}

variable "environment" {
  description = "Environment label used for tagging."
  type        = string
  default     = "dev"
}

variable "vpc_cidr" {
  description = "CIDR block for the VPC."
  type        = string
  default     = "10.10.0.0/16"
}

variable "public_subnet_cidr" {
  description = "CIDR block for the public subnet."
  type        = string
  default     = "10.10.1.0/24"
}

variable "instance_type" {
  description = "EC2 instance type; check current pricing and eligibility."
  type        = string
  default     = "t3.micro"
}

variable "ami_id" {
  description = "A valid Linux AMI ID for the selected AWS region."
  type        = string
}

variable "ssh_allowed_cidr" {
  description = "Trusted public IPv4 CIDR allowed to connect over SSH, e.g. your public IP followed by /32."
  type        = string

  validation {
    condition     = can(cidrhost(var.ssh_allowed_cidr, 0)) && endswith(var.ssh_allowed_cidr, "/32")
    error_message = "For this learning lab, ssh_allowed_cidr must be a single IPv4 address with /32."
  }
}
36:["$","pre","pre-5",{"children":["$","code","code-0",{"className":"language-terraform","children":"$82"}]}]
37:["$","h3","h3-8",{"children":["4️⃣ ",["$","code","code-0",{"children":"main.tf"}]]}]
83:T89b,resource "aws_vpc" "main" {
  cidr_block           = var.vpc_cidr
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = {
    Name = "${var.environment}-project10-vpc"
  }
}

resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "${var.environment}-project10-igw"
  }
}

resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = var.public_subnet_cidr
  map_public_ip_on_launch = true

  tags = {
    Name = "${var.environment}-project10-public-subnet"
  }
}

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.main.id
  }

  tags = {
    Name = "${var.environment}-project10-public-rt"
  }
}

resource "aws_route_table_association" "public" {
  subnet_id      = aws_subnet.public.id
  route_table_id = aws_route_table.public.id
}

resource "aws_security_group" "ec2" {
  name        = "${var.environment}-project10-ec2-sg"
  description = "SSH only from the explicitly allowed trusted IPv4 address"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "SSH from trusted IPv4 address only"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.ssh_allowed_cidr]
  }

  egress {
    description = "Outbound IPv4 traffic for this learning lab"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.environment}-project10-ec2-sg"
  }
}

resource "aws_instance" "web" {
  ami                         = var.ami_id
  instance_type               = var.instance_type
  subnet_id                   = aws_subnet.public.id
  vpc_security_group_ids      = [aws_security_group.ec2.id]
  associate_public_ip_address = true

  metadata_options {
    http_endpoint               = "enabled"
    http_tokens                 = "required"
    http_put_response_hop_limit = 1
  }

  root_block_device {
    encrypted = true
  }

  tags = {
    Name = "${var.environment}-project10-web"
    Role = "learning-lab"
  }
}
