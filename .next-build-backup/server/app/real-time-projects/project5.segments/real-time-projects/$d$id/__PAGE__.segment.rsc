131:["$","h1","h1-21",{"children":"⚙️ 21. CI Validation — GitHub Actions"}]
132:["$","p","p-107",{"children":"CI should catch configuration and application errors before changes are merged. It does not need AWS credentials to run basic tests or validate YAML and application code."}]
133:["$","p","p-108",{"children":"A sensible first CI stage can:"}]
134:["$","ul","ul-14",{"children":["\n",["$","li","li-0",{"children":"Check Python syntax."}],"\n",["$","li","li-1",{"children":"Install test dependencies."}],"\n",["$","li","li-2",{"children":"Run unit tests."}],"\n",["$","li","li-3",{"children":["Parse ",["$","code","code-0",{"children":"compose.yaml"}],"."]}],"\n",["$","li","li-4",{"children":"Check YAML configuration."}],"\n",["$","li","li-5",{"children":"Check Dockerfile or container image security using approved scanners."}],"\n",["$","li","li-6",{"children":"Run the app tests before a new image is published."}],"\n"]}]
135:["$","p","p-109",{"children":"Example workflow skeleton:"}]
136:["$","pre","pre-36",{"children":["$","code","code-0",{"className":"language-yaml","children":"name: Validate Observability Lab\r\n\r\non:\r\n  pull_request:\r\n  push:\r\n    branches: [\"main\"]\r\n  workflow_dispatch:\r\n\r\npermissions:\r\n  contents: read\r\n\r\njobs:\r\n  python-tests:\r\n    runs-on: ubuntu-latest\r\n    steps:\r\n      - name: Checkout\r\n        uses: actions/checkout@v4\r\n\r\n      - name: Set up Python\r\n        uses: actions/setup-python@v5\r\n        with:\r\n          python-version: \"3.12\"\r\n\r\n      - name: Install app dependencies\r\n        run: |\r\n          python -m pip install --upgrade pip\r\n          python -m pip install -r app/requirements.txt\r\n\r\n      - name: Run tests\r\n        working-directory: app\r\n        run: pytest -q\r\n\r\n  compose-validation:\r\n    runs-on: ubuntu-latest\r\n    steps:\r\n      - name: Checkout\r\n        uses: actions/checkout@v4\r\n\r\n      - name: Validate Compose model\r\n        run: docker compose config\n"}]}]
137:["$","p","p-110",{"children":"This skeleton assumes the Compose file and all referenced configuration files exist and are valid. GitHub Actions action versions should be reviewed and, for stronger supply-chain controls, pinned to verified commit SHAs. Add integration tests only after the stack configuration is complete and can be run safely in CI."}]
