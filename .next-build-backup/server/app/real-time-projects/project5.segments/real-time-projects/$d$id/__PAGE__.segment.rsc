s visible"}],["$","td","td-1",{"children":"Call test-only error route"}],["$","td","td-2",{"children":"HTTP 500 and corresponding metric/log appear"}]]}],["$","tr","tr-8",{"children":[["$","td","td-0",{"children":"Alert rule evaluates"}],["$","td","td-1",{"children":"Prometheus alert UI"}],["$","td","td-2",{"children":"Rule is loaded and state changes as expected"}]]}],["$","tr","tr-9",{"children":[["$","td","td-0",{"children":"Alertmanager receives alert"}],["$","td","td-1",{"children":"Alertmanager UI/logs"}],["$","td","td-2",{"children":"Alert group appears"}]]}],["$","tr","tr-10",{"children":[["$","td","td-0",{"children":"Notification delivery works"}],["$","td","td-1",{"children":"Test configured receiver"}],["$","td","td-2",{"children":"The actual receiver gets the test notification"}]]}],["$","tr","tr-11",{"children":[["$","td","td-0",{"children":"CI runs"}],["$","td","td-1",{"children":"GitHub Actions tab"}],["$","td","td-2",{"children":"Expected jobs complete successfully"}]]}],["$","tr","tr-12",{"children":[["$","td","td-0",{"children":"Cleanup is complete"}],["$","td","td-1",{"children":"Compose status and volume review"}],["$","td","td-2",{"children":"No unwanted lab containers/resources remain"}]]}]]}]]}]
