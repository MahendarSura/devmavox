22:["$","h2","h2-2",{"children":"📦 Company situation"}]
23:["$","p","p-9",{"children":["ShopEasy has a web application running in Docker containers. Customers complain that the product page sometimes takes 8–10 seconds to load. Some users receive ",["$","code","code-0",{"children":"500 Internal Server Error"}],"."]}]
24:["$","p","p-10",{"children":"Before monitoring is implemented, the team may only discover the issue when customers complain."}]
25:["$","p","p-11",{"children":"After this project is implemented, the team can see metrics, search logs, and receive an alert when an agreed threshold is exceeded."}]
26:["$","h3","h3-1",{"children":"🔴 10:00 AM — Application is healthy"}]
27:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"Requests are completing normally."}],"\n",["$","li","li-1",{"children":"CPU and memory usage are within the expected range."}],"\n",["$","li","li-2",{"children":"The application returns successful responses."}],"\n",["$","li","li-3",{"children":"Grafana dashboards show normal trends."}],"\n"]}]
28:["$","h3","h3-2",{"children":"🟠 10:15 AM — Traffic increases"}]
29:["$","p","p-12",{"children":"A promotion starts. More users open the product page."}]
2a:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":"Request rate increases."}],"\n",["$","li","li-1",{"children":"CPU usage begins to rise."}],"\n",["$","li","li-2",{"children":"Request latency becomes higher."}],"\n",["$","li","li-3",{"children":"Prometheus collects the measurements at regular intervals."}],"\n"]}]
2b:["$","h3","h3-3",{"children":"🔴 10:17 AM — Errors begin"}]
2c:["$","p","p-13",{"children":"A dependency used by the application starts timing out."}]
2d:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":"The application's error count rises."}],"\n",["$","li","li-1",{"children":"Logs show timeout messages."}],"\n",["$","li","li-2",{"children":"The error-rate alert condition becomes true and remains true for the configured duration."}],"\n",["$","li","li-3",{"children":"Alertmanager routes the alert to the configured receiver."}],"\n"]}]
2e:["$","h3","h3-4",{"children":"🧑‍💻 10:18 AM — DevOps Engineer investigates"}]
2f:["$","p","p-14",{"children":["The engineer does ",["$","strong","strong-0",{"children":"not"}]," randomly restart everything. The engineer follows evidence:"]}]
30:["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"Open Grafana and check the application error-rate and latency panels."}],"\n",["$","li","li-1",{"children":"Check whether CPU or memory pressure is also increasing."}],"\n",["$","li","li-2",{"children":"Search the application logs around the incident time."}],"\n",["$","li","li-3",{"children":"Compare the time of the errors with a recent deployment or configuration change."}],"\n",["$","li","li-4",{"children":"Check whether the application or a dependency is unhealthy."}],"\n",["$","li","li-5",{"children":"Apply the approved recovery action—for example, roll back a bad release or restore a failed dependency."}],"\n",["$","li","li-6",{"children":"Verify that error rate and latency return to normal."}],"\n",["$","li","li-7",{"children":"Record the incident, root cause, impact, and prevention steps."}],"\n"]}]
31:["$","h3","h3-5",{"children":"🟢 10:30 AM — Service recovered"}]
32:["$","p","p-15",{"children":"The dashboards return toward normal. The team confirms recovery with measurements rather than assuming that the problem is fixed simply because the alert stopped."}]
33:["$","blockquote","blockquote-1",{"children":["\n",["$","p","p-0",{"children":["🟨 ",["$","strong","strong-0",{"children":"Important:"}]," This is a realistic example of how a monitored incident can unfold. The times and symptoms above are illustrative, not evidence of a real production incident."]}],"\n"]}]
