125:["$","ul","ul-13",{"className":"contains-task-list","children":["\n",["$","li","li-0",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Bind local lab UIs to localhost unless remote access is deliberately secured."]}],"\n",["$","li","li-1",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Change default credentials and use supported secret management."]}],"\n",["$","li","li-2",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Do not commit ",["$","code","code-0",{"children":".env"}]," files, tokens, passwords, or webhook URLs containing secrets."]}],"\n",["$","li","li-3",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Restrict access to dashboards and logs by role."]}],"\n",["$","li","li-4",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Do not log credentials, access tokens, payment details, or unnecessary personal data."]}],"\n",["$","li","li-5",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Set appropriate retention and disk limits."]}],"\n",["$","li","li-6",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Pin and regularly update container images."]}],"\n",["$","li","li-7",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Scan images and dependencies."]}],"\n",["$","li","li-8",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Restrict alert receivers and protect notification credentials."]}],"\n",["$","li","li-9",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Monitor the monitoring stack itself."]}],"\n",["$","li","li-10",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Back up dashboard/configuration definitions in Git and protect any stateful data as required."]}],"\n",["$","li","li-11",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Test recovery and alert delivery rather than assuming they work."]}],"\n"]}]
