e2:["$","p","p-79",{"children":["The final ",["$","code","code-0",{"children":"compose.yaml"}]," connects the application, Prometheus, Grafana, Loki, Alloy, and Alertmanager. The service list below is the intended architecture; complete the pinned image versions and collector-specific configuration according to the versions you select."]}]
18f:T884,services:
  app:
    build: ./app
    container_name: shopeasy-app
    ports:
      - "127.0.0.1:8000:8000"
    restart: unless-stopped

  prometheus:
    image: prom/prometheus:PIN_A_TESTED_VERSION
    container_name: shopeasy-prometheus
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus/alert-rules.yml:/etc/prometheus/alert-rules.yml:ro
      - prometheus-data:/prometheus
    ports:
      - "127.0.0.1:9090:9090"
    depends_on:
      - app
    restart: unless-stopped

  grafana:
    image: grafana/grafana:PIN_A_TESTED_VERSION
    container_name: shopeasy-grafana
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
    ports:
      - "127.0.0.1:3000:3000"
    depends_on:
      - prometheus
      - loki
    restart: unless-stopped

  loki:
    image: grafana/loki:PIN_A_TESTED_VERSION
    container_name: shopeasy-loki
    command: ["-config.file=/etc/loki/local-config.yaml"]
    ports:
      - "127.0.0.1:3100:3100"
    volumes:
      - loki-data:/loki
    restart: unless-stopped

  alertmanager:
    image: prom/alertmanager:PIN_A_TESTED_VERSION
    container_name: shopeasy-alertmanager
    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"
    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
    ports:
      - "127.0.0.1:9093:9093"
    restart: unless-stopped

  alloy:
    image: grafana/alloy:PIN_A_TESTED_VERSION
    container_name: shopeasy-alloy
    # Add the current, tested Alloy configuration and required read-only log-source mounts.
    # The exact mounts depend on your host OS and chosen collection method.
    volumes:
      - ./alloy/config.alloy:/etc/alloy/config.alloy:ro
    command: ["run", "/etc/alloy/config.alloy"]
    depends_on:
      - loki
    restart: unless-stopped

volumes:
  prometheus-data:
  grafana-data:
  loki-data:
