78:["$","ol","ol-2",{"children":["\n",["$","li","li-0",{"children":"Open the dashboard after receiving a report or alert."}],"\n",["$","li","li-1",{"children":"Select the relevant time range."}],"\n",["$","li","li-2",{"children":"Compare the error and latency panels."}],"\n",["$","li","li-3",{"children":"Look at CPU/memory and target health."}],"\n",["$","li","li-4",{"children":"Open Explore to query logs in the same time window."}],"\n",["$","li","li-5",{"children":"Note the first abnormal timestamp."}],"\n",["$","li","li-6",{"children":"Compare it with deployment or configuration changes."}],"\n"]}]
79:["$","h3","h3-14",{"children":"Important distinction"}]
7a:["$","p","p-41",{"children":"A dashboard is not the same as monitoring coverage. A beautiful dashboard with missing metrics, bad labels, or no useful alert rules can still fail to detect a serious issue."}]
7b:["$","hr","hr-7",{}]
7c:["$","h2","h2-13",{"children":"📝 6.3 Loki — Centralized Log Storage and Query"}]
7d:["$","h3","h3-15",{"children":"What is Loki?"}]
7e:["$","p","p-42",{"children":"Loki is a log aggregation system in the Grafana ecosystem. It indexes labels associated with log streams and supports queries using LogQL."}]
7f:["$","h3","h3-16",{"children":["Why not just use ",["$","code","code-0",{"children":"docker logs"}],"?"]}]
80:["$","p","p-43",{"children":[["$","code","code-0",{"children":"docker logs"}]," is useful for a quick check on one container. In a larger environment, engineers may need to search multiple services, compare events across hosts, and investigate a time range from one place."]}]
81:["$","p","p-44",{"children":"Centralized logging makes that easier."}]
82:["$","h3","h3-17",{"children":"Example LogQL queries"}]
83:["$","p","p-45",{"children":["Show logs with a ",["$","code","code-0",{"children":"service"}]," label:"]}]
84:["$","pre","pre-9",{"children":["$","code","code-0",{"className":"language-logql","children":"{service=\"shopeasy\"}\n"}]}]
