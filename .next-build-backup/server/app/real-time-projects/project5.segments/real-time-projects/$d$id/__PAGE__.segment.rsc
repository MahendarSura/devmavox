8a:["$","h3","h3-18",{"children":"What does a DevOps Engineer do?"}]
8b:["$","ul","ul-6",{"children":["\n",["$","li","li-0",{"children":"Configure log collection and labels."}],"\n",["$","li","li-1",{"children":"Check whether logs are reaching Loki."}],"\n",["$","li","li-2",{"children":"Search for error patterns."}],"\n",["$","li","li-3",{"children":"Correlate logs with an alert's timestamp."}],"\n",["$","li","li-4",{"children":"Prevent high-cardinality labels from causing unnecessary load."}],"\n",["$","li","li-5",{"children":"Apply retention and access controls."}],"\n",["$","li","li-6",{"children":"Ensure secrets and personal data are not exposed in logs."}],"\n"]}]
8c:["$","p","p-49",{"children":[["$","strong","strong-0",{"children":"Label design matters:"}]," Avoid using a unique request ID, user ID, or arbitrary URL as a Loki stream label. Those can create a very large number of streams. Keep such values in the log content when appropriate and safe."]}]
8d:["$","hr","hr-8",{}]
8e:["$","h2","h2-14",{"children":"🚚 6.4 Grafana Alloy — Log Collection"}]
8f:["$","p","p-50",{"children":"Grafana Alloy is an observability collector that can receive, process, and forward telemetry, depending on its configured components."}]
90:["$","p","p-51",{"children":"In this learning architecture, Alloy is used to collect log data and send it to Loki."}]
91:["$","p","p-52",{"children":[["$","strong","strong-0",{"children":"Why use a collector?"}]," The application writes logs, but the log backend needs a way to receive them. A collector connects the source to the backend and can apply processing or filtering."]}]
92:["$","p","p-53",{"children":"Promtail was a widely used Loki log collector, but it reached end of life in 2026. For new learning work, follow current Grafana guidance and use Alloy or another currently supported collection method. Verify the current support status and configuration in the official documentation before building a production system."}]
93:["$","hr","hr-9",{}]
94:["$","h2","h2-15",{"children":"🚨 6.5 Alertmanager — Notification Routing"}]
95:["$","p","p-54",{"children":"Prometheus alert rules decide when an alert condition is active. Alertmanager handles grouping, routing, silencing, and notification delivery."}]
96:["$","h3","h3-19",{"children":"Example alert flow"}]
97:["$","pre","pre-12",{"children":["$","code","code-0",{"className":"language-text","children":"Prometheus evaluates a rule\r\n          |\r\n          v\r\nCondition remains true for configured duration\r\n          |\r\n          v\r\nAlert enters Firing state\r\n          |\r\n          v\r\nPrometheus sends alert to Alertmanager\r\n          |\r\n          v\r\nAlertmanager matches routing rules\r\n          |\r\n          v\r\nConfigured email / webhook / receiver gets notification\r\n          |\r\n          v\r\nEngineer investigates\n"}]}]
98:["$","h3","h3-20",{"children":"What does a DevOps Engineer configure?"}]
99:["$","ul","ul-7",{"children":["\n",["$","li","li-0",{"children":"Alert severity and ownership."}],"\n",["$","li","li-1",{"children":"Notification receiver."}],"\n",["$","li","li-2",{"children":"Grouping of related alerts."}],"\n",["$","li","li-3",{"children":"Repeat interval and timing."}],"\n",["$","li","li-4",{"children":"Maintenance silences."}],"\n",["$","li","li-5",{"children":"Links to dashboards and runbooks."}],"\n",["$","li","li-6",{"children":"Avoiding noisy or duplicate notifications."}],"\n"]}]
