6c:["$","pre","pre-7",{"children":["$","code","code-0",{"className":"language-promql","children":"sum(rate(http_requests_total{status=~\"5..\"}[5m]))\r\n/\r\nclamp_min(sum(rate(http_requests_total[5m])), 1)\n"}]}]
