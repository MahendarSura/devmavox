48:["$","h2","h2-7",{"children":"📈 Metrics"}]
49:["$","p","p-19",{"children":"Metrics are numerical measurements collected over time."}]
4a:["$","p","p-20",{"children":"Examples:"}]
4b:["$","ul","ul-3",{"children":["\n",["$","li","li-0",{"children":"Requests per second."}],"\n",["$","li","li-1",{"children":"Number of HTTP 500 responses."}],"\n",["$","li","li-2",{"children":"CPU and memory usage."}],"\n",["$","li","li-3",{"children":"Request duration."}],"\n",["$","li","li-4",{"children":"Number of active connections."}],"\n"]}]
4c:["$","p","p-21",{"children":"Example:"}]
4d:["$","pre","pre-4",{"children":["$","code","code-0",{"className":"language-text","children":"http_requests_total{method=\"GET\",status=\"200\"} 1250\r\nhttp_requests_total{method=\"GET\",status=\"500\"} 18\n"}]}]
4e:["$","p","p-22",{"children":"These are illustrative metric samples. The actual metric names and labels depend on the application instrumentation."}]
4f:["$","p","p-23",{"children":[["$","strong","strong-0",{"children":"Why metrics matter:"}]," They help identify patterns and answer questions like “When did errors increase?” or “Is latency getting worse?”"]}]
50:["$","h2","h2-8",{"children":"📝 Logs"}]
51:["$","p","p-24",{"children":"Logs are event records written by the application or platform."}]
52:["$","p","p-25",{"children":"Example:"}]
53:["$","pre","pre-5",{"children":["$","code","code-0",{"className":"language-text","children":"2026-10-25T10:17:42Z level=ERROR\r\nservice=shopeasy\r\nmessage=\"Inventory dependency timed out\"\r\nrequest_id=\"demo-123\"\n"}]}]
54:["$","p","p-26",{"children":"This is an illustrative log line, not a real captured event."}]
55:["$","p","p-27",{"children":[["$","strong","strong-0",{"children":"Why logs matter:"}]," Metrics may tell you that errors increased, while logs may show the error message and affected operation."]}]
56:["$","p","p-28",{"children":"Avoid logging passwords, tokens, session cookies, personal information, or other secrets."}]
57:["$","h2","h2-9",{"children":"🧵 Traces"}]
58:["$","p","p-29",{"children":"A distributed trace follows one request across multiple services. Traces are useful when one user action passes through an API, inventory service, payment service, and database."}]
59:["$","p","p-30",{"children":"This project's core implementation focuses on metrics and logs. Distributed tracing with OpenTelemetry can be a future extension."}]
5a:["$","h2","h2-10",{"children":"🚨 Alerts"}]
5b:["$","p","p-31",{"children":"An alert is a rule-based signal that a condition needs attention."}]
5c:["$","p","p-32",{"children":"For example:"}]
5d:["$","ul","ul-4",{"children":["\n",["$","li","li-0",{"children":"Error rate stays above an agreed threshold."}],"\n",["$","li","li-1",{"children":"A monitored target is unavailable."}],"\n",["$","li","li-2",{"children":"CPU stays unusually high for a sustained period."}],"\n"]}]
5e:["$","p","p-33",{"children":"An alert is not automatically a fix. It notifies the right person or system so investigation can start."}]
5f:["$","hr","hr-5",{}]
