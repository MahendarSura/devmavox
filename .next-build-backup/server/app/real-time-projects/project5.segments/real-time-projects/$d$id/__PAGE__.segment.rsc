1e:["$","table","table-0",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"children":"Human body"}],["$","th","th-1",{"children":"Software system"}],["$","th","th-2",{"children":"What it tells us"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":"🌡️ Temperature"}],["$","td","td-1",{"children":"CPU usage / latency"}],["$","td","td-2",{"children":"Is the system under stress?"}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":"❤️ Pulse"}],["$","td","td-1",{"children":"Request rate"}],["$","td","td-2",{"children":"How much traffic is arriving?"}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":"🩺 Blood test"}],["$","td","td-1",{"children":"Metrics and health checks"}],["$","td","td-2",{"children":"What measurements are abnormal?"}]]}],["$","tr","tr-3",{"children":[["$","td","td-0",{"children":"🗣️ Patient describing pain"}],["$","td","td-1",{"children":"Application logs"}],["$","td","td-2",{"children":"What happened and what error appeared?"}]]}],["$","tr","tr-4",{"children":[["$","td","td-0",{"children":"🚨 Hospital alarm"}],["$","td","td-1",{"children":"Alerting system"}],["$","td","td-2",{"children":"Who should be notified about a serious problem?"}]]}],["$","tr","tr-5",{"children":[["$","td","td-0",{"children":"👨‍⚕️ Doctor investigating"}],["$","td","td-1",{"children":"DevOps / SRE incident response"}],["$","td","td-2",{"children":"What is the root cause and how do we recover?"}]]}]]}]]}]
