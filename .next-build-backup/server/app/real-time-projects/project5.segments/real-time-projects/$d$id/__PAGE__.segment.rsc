a1:["$","ul","ul-8",{"children":["\n",["$","li","li-0",{"children":[["$","code","code-0",{"children":"config"}]," checks and renders the Compose configuration."]}],"\n",["$","li","li-1",{"children":[["$","code","code-0",{"children":"up -d"}]," starts the services in the background."]}],"\n",["$","li","li-2",{"children":[["$","code","code-0",{"children":"ps"}]," shows service/container status."]}],"\n",["$","li","li-3",{"children":[["$","code","code-0",{"children":"logs"}]," helps diagnose startup or runtime errors."]}],"\n",["$","li","li-4",{"children":[["$","code","code-0",{"children":"down"}]," stops and removes Compose-managed containers and networks; named volumes generally remain unless explicitly removed."]}],"\n"]}]
