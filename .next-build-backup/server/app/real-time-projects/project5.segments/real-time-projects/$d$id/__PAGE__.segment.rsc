61:["$","h2","h2-11",{"children":"📈 6.1 Prometheus — Metrics Collector"}]
62:["$","h3","h3-7",{"children":"What is Prometheus?"}]
63:["$","p","p-34",{"children":"Prometheus is a monitoring and time-series database system. It typically pulls metrics from targets by scraping their HTTP metrics endpoints at configured intervals."}]
64:["$","h3","h3-8",{"children":"How does it work?"}]
65:["$","ol","ol-1",{"children":["\n",["$","li","li-0",{"children":["The application exposes metrics at ",["$","code","code-0",{"children":"/metrics"}],"."]}],"\n",["$","li","li-1",{"children":"Prometheus reads its configuration."}],"\n",["$","li","li-2",{"children":"Prometheus connects to the configured target at the scrape interval."}],"\n",["$","li","li-3",{"children":"It records timestamped samples."}],"\n",["$","li","li-4",{"children":"PromQL queries those samples."}],"\n",["$","li","li-5",{"children":"Grafana can query Prometheus to draw panels."}],"\n",["$","li","li-6",{"children":"Alert rules can evaluate conditions based on those measurements."}],"\n"]}]
66:["$","h3","h3-9",{"children":"What does a DevOps Engineer do with it?"}]
67:["$","ul","ul-5",{"children":["\n",["$","li","li-0",{"children":"Add or update scrape targets."}],"\n",["$","li","li-1",{"children":["Check why a target is ",["$","code","code-0",{"children":"DOWN"}],"."]}],"\n",["$","li","li-2",{"children":"Build or review PromQL queries."}],"\n",["$","li","li-3",{"children":"Create alert rules based on service objectives."}],"\n",["$","li","li-4",{"children":"Investigate metric changes after a deployment."}],"\n",["$","li","li-5",{"children":"Manage retention, storage, and resource usage."}],"\n"]}]
68:["$","h3","h3-10",{"children":"Example PromQL queries"}]
69:["$","p","p-35",{"children":["Request rate, if the application exposes a counter named ",["$","code","code-0",{"children":"http_requests_total"}],":"]}]
6a:["$","pre","pre-6",{"children":["$","code","code-0",{"className":"language-promql","children":"sum(rate(http_requests_total[5m]))\n"}]}]
