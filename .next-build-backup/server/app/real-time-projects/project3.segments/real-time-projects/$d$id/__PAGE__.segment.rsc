ldren":"Health and rollout checks"}],["$","td","td-2",{"children":"Readiness/liveness behaviour validated"}]]}],["$","tr","tr-9",{"children":[["$","td","td-0",{"children":"10"}],["$","td","td-1",{"children":"Monitoring extension"}],["$","td","td-2",{"children":"Dashboard shows cluster/application metrics"}]]}]]}]]}]
