f7:["$","ul","ul-7",{"children":["\n",["$","li","li-0",{"children":"Run as a non-root user."}],"\n",["$","li","li-1",{"children":"Drop Linux capabilities not required by the application."}],"\n",["$","li","li-2",{"children":"Disable privilege escalation."}],"\n",["$","li","li-3",{"children":"Use a read-only root filesystem where compatible."}],"\n",["$","li","li-4",{"children":"Pin and update base images deliberately."}],"\n",["$","li","li-5",{"children":"Scan images for vulnerabilities."}],"\n",["$","li","li-6",{"children":"Do not bake passwords, cloud credentials, or API keys into an image."}],"\n",["$","li","li-7",{"children":"Prefer trusted registries and immutable image references."}],"\n"]}]
f8:["$","h3","h3-43",{"children":"Kubernetes security"}]
f9:["$","ul","ul-8",{"children":["\n",["$","li","li-0",{"children":"Use namespace-scoped permissions where possible."}],"\n",["$","li","li-1",{"children":"Apply least-privilege RBAC."}],"\n",["$","li","li-2",{"children":"Do not mount the ServiceAccount token unless the app needs it."}],"\n",["$","li","li-3",{"children":"Configure CPU/memory requests and limits."}],"\n",["$","li","li-4",{"children":"Use NetworkPolicies where the CNI supports them."}],"\n",["$","li","li-5",{"children":"Enforce suitable Pod Security standards."}],"\n",["$","li","li-6",{"children":"Encrypt sensitive data at rest where supported and restrict Secret access."}],"\n",["$","li","li-7",{"children":"Keep Kubernetes and add-on versions patched."}],"\n",["$","li","li-8",{"children":"Avoid exposing the Kubernetes API or Argo CD UI publicly without appropriate protections."}],"\n"]}]
fa:["$","h3","h3-44",{"children":"GitOps security"}]
fb:["$","ul","ul-9",{"children":["\n",["$","li","li-0",{"children":"Protect the main/deployment branch with reviews."}],"\n",["$","li","li-1",{"children":"Require CI checks before merge."}],"\n",["$","li","li-2",{"children":"Restrict who can change production manifests."}],"\n",["$","li","li-3",{"children":"Use a separate deployment repository or directories for environment-specific configuration when appropriate."}],"\n",["$","li","li-4",{"children":"Review Argo CD project permissions and repository access."}],"\n",["$","li","li-5",{"children":"Use explicit sync/prune policies."}],"\n",["$","li","li-6",{"children":"Audit changes and avoid committing secret values."}],"\n",["$","li","li-7",{"children":"Separate development, staging, and production permissions."}],"\n"]}]
