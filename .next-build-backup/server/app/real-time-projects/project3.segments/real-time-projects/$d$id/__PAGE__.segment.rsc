bc:["$","pre","pre-43",{"children":["$","code","code-0",{"className":"language-yaml","children":"apiVersion: argoproj.io/v1alpha1\r\nkind: Application\r\nmetadata:\r\n  name: shopsmart\r\n  namespace: argocd\r\nspec:\r\n  project: default\r\n  source:\r\n    repoURL: https://github.com/YOUR-USER/kubernetes-gitops-shop.git\r\n    targetRevision: main\r\n    path: helm/shopsmart\r\n    helm:\r\n      releaseName: shopsmart\r\n  destination:\r\n    server: https://kubernetes.default.svc\r\n    namespace: shopsmart\r\n  syncPolicy:\r\n    syncOptions:\r\n      - CreateNamespace=true\r\n    automated:\r\n      prune: false\r\n      selfHeal: true\n"}]}]
