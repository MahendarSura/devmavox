5d:["$","h2","h2-10",{"children":"2️⃣ Create a Sample Application"}]
5e:["$","p","p-24",{"children":"The sample API uses Flask. It exposes a health endpoint and a small product endpoint."}]
5f:["$","h3","h3-10",{"children":["$","code","code-0",{"children":"app/app.py"}]}]
60:["$","pre","pre-11",{"children":["$","code","code-0",{"className":"language-python","children":"from flask import Flask, jsonify\r\nimport os\r\n\r\napp = Flask(__name__)\r\n\r\nAPP_VERSION = os.getenv(\"APP_VERSION\", \"1.0.0\")\r\n\r\n\r\n@app.get(\"/health\")\r\ndef health():\r\n    return jsonify({\r\n        \"status\": \"ok\",\r\n        \"version\": APP_VERSION\r\n    }), 200\r\n\r\n\r\n@app.get(\"/api/products\")\r\ndef products():\r\n    return jsonify([\r\n        {\"id\": 1, \"name\": \"Laptop\", \"price\": 65000},\r\n        {\"id\": 2, \"name\": \"Keyboard\", \"price\": 1800},\r\n        {\"id\": 3, \"name\": \"Mouse\", \"price\": 700}\r\n    ]), 200\r\n\r\n\r\n@app.get(\"/\")\r\ndef home():\r\n    return jsonify({\r\n        \"application\": \"ShopSmart Product API\",\r\n        \"version\": APP_VERSION,\r\n        \"message\": \"Kubernetes + Helm + Argo CD GitOps demo\"\r\n    }), 200\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    # The container runs as a non-root user in the Dockerfile.\r\n    # Flask's development server is for this learning demo only.\r\n    app.run(host=\"0.0.0.0\", port=8080)\n"}]}]
61:["$","h3","h3-11",{"children":["$","code","code-0",{"children":"app/requirements.txt"}]}]
62:["$","pre","pre-12",{"children":["$","code","code-0",{"className":"language-text","children":"Flask>=3.0,<4.0\r\ngunicorn>=22.0,<24.0\n"}]}]
63:["$","h3","h3-12",{"children":["$","code","code-0",{"children":"tests/test_app.py"}]}]
64:["$","pre","pre-13",{"children":["$","code","code-0",{"className":"language-python","children":"import os\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nsys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"app\"))\r\n\r\nfrom app import app\r\n\r\n\r\ndef test_health_returns_ok():\r\n    client = app.test_client()\r\n    response = client.get(\"/health\")\r\n\r\n    assert response.status_code == 200\r\n    assert response.get_json()[\"status\"] == \"ok\"\r\n\r\n\r\ndef test_products_returns_list():\r\n    client = app.test_client()\r\n    response = client.get(\"/api/products\")\r\n\r\n    assert response.status_code == 200\r\n    assert isinstance(response.get_json(), list)\r\n    assert len(response.get_json()) >= 1\r\n\r\n\r\ndef test_home_contains_application_name():\r\n    client = app.test_client()\r\n    response = client.get(\"/\")\r\n\r\n    assert response.status_code == 200\r\n    assert response.get_json()[\"application\"] == \"ShopSmart Product API\"\n"}]}]
65:["$","p","p-25",{"children":"Install dependencies and run tests locally:"}]
66:["$","pre","pre-14",{"children":["$","code","code-0",{"className":"language-bash","children":"python -m pip install -r app/requirements.txt\r\npython -m pip install pytest\r\npython -m pytest -q\n"}]}]
67:["$","p","p-26",{"children":"Expected result: all three tests pass."}]
