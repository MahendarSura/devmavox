69:["$","h2","h2-11",{"children":"3️⃣ Build and Test the Docker Image"}]
6a:["$","h3","h3-13",{"children":["$","code","code-0",{"children":"Dockerfile"}]}]
6b:["$","pre","pre-15",{"children":["$","code","code-0",{"className":"language-dockerfile","children":"FROM python:3.12-slim\r\n\r\nENV PYTHONDONTWRITEBYTECODE=1 \\\r\n    PYTHONUNBUFFERED=1 \\\r\n    PORT=8080\r\n\r\nWORKDIR /app\r\n\r\nCOPY app/requirements.txt ./requirements.txt\r\nRUN pip install --no-cache-dir -r requirements.txt \\\r\n    && groupadd --system appgroup \\\r\n    && useradd --system --gid appgroup --home-dir /app appuser\r\n\r\nCOPY app/ ./\r\n\r\nUSER appuser\r\n\r\nEXPOSE 8080\r\n\r\nCMD [\"gunicorn\", \"--bind\", \"0.0.0.0:8080\", \"--workers\", \"2\", \"--threads\", \"4\", \"--timeout\", \"30\", \"app:app\"]\n"}]}]
6c:["$","h3","h3-14",{"children":["$","code","code-0",{"children":".dockerignore"}]}]
6d:["$","pre","pre-16",{"children":["$","code","code-0",{"className":"language-text","children":".git\r\n.github\r\n.venv\r\nvenv\r\n__pycache__\r\n*.py[cod]\r\n.pytest_cache\r\n.env\r\n.env.*\r\ntests\r\nREADME.md\n"}]}]
6e:["$","p","p-27",{"children":"Build the image:"}]
6f:["$","pre","pre-17",{"children":["$","code","code-0",{"className":"language-bash","children":"docker build -t shopsmart-api:1.0.0 .\n"}]}]
70:["$","p","p-28",{"children":"Run the container:"}]
71:["$","pre","pre-18",{"children":["$","code","code-0",{"className":"language-bash","children":"docker run --rm -d --name shopsmart-api -p 8080:8080 shopsmart-api:1.0.0\n"}]}]
