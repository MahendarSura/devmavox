23:["$","p","p-7",{"children":"The development team updates its product API. A DevOps engineer needs a repeatable way to deploy the application without manually running commands against production every time."}]
24:["$","h3","h3-2",{"children":"Without GitOps ❌"}]
25:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":"Someone changes Kubernetes resources manually."}],"\n",["$","li","li-1",{"children":"The Git repository and live cluster can become different."}],"\n",["$","li","li-2",{"children":"It may be unclear who changed what."}],"\n",["$","li","li-3",{"children":"Rollbacks and environment consistency become harder."}],"\n"]}]
26:["$","h3","h3-3",{"children":"With GitOps ✅"}]
27:["$","ol","ol-1",{"children":["\n",["$","li","li-0",{"children":"The engineer updates application or deployment configuration in Git."}],"\n",["$","li","li-1",{"children":"A reviewed commit is merged into the deployment branch."}],"\n",["$","li","li-2",{"children":"Argo CD detects the desired-state change."}],"\n",["$","li","li-3",{"children":"Argo CD applies the approved configuration to Kubernetes."}],"\n",["$","li","li-4",{"children":"Kubernetes gradually replaces old Pods when the Deployment changes."}],"\n",["$","li","li-5",{"children":"Probes and rollout status help confirm whether the application becomes healthy."}],"\n",["$","li","li-6",{"children":"Monitoring and logs help diagnose failures."}],"\n"]}]
28:["$","p","p-8",{"children":[["$","strong","strong-0",{"children":"Key principle:"}]," Git stores the declared desired state; Kubernetes runs the workload; Argo CD continuously works to make the cluster match the configured desired state."]}]
29:["$","hr","hr-3",{}]
2a:["$","h2","h2-3",{"children":"🧠 Concepts You Will Learn"}]
2b:["$","table","table-0",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"children":"Concept"}],["$","th","th-1",{"children":"Simple meaning"}],["$","th","th-2",{"children":"Why it matters"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":"Cluster"}],["$","td","td-1",{"children":"Kubernetes control plane and worker capacity"}],["$","td","td-2",{"children":"Runs and manages workloads"}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":"Pod"}],["$","td","td-1",{"children":"Smallest deployable Kubernetes unit"}],["$","td","td-2",{"children":"Runs one or more closely related containers"}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":"Deployment"}],["$","td","td-1",{"children":"Declares the desired number and version of Pods"}],["$","td","td-2",{"children":"Manages ReplicaSets and rolling updates"}]]}],["$","tr","tr-3",{"children":[["$","td","td-0",{"children":"ReplicaSet"}],["$","td","td-1",{"children":"Maintains a target number of matching Pods"}],["$","td","td-2",{"children":"Helps keep the desired replica count"}]]}],["$","tr","tr-4",{"children":[["$","td","td-0",{"children":"Service"}],["$","td","td-1",{"children":"Stable network endpoint for matching Pods"}],["$","td","td-2",{"children":"Pod IP addresses can change"}]]}],["$","tr","tr-5",{"children":[["$","td","td-0",{"children":"ConfigMap"}],["$","td","td-1",{"children":"Stores non-secret configuration"}],["$","td","td-2",{"children":"Separates configuration from image builds"}]]}],["$","tr","tr-6",{"children":[["$","td","td-0",{"children":"Secret"}],["$","td","td-1",{"children":"Kubernetes object intended for sensitive values"}],["$","td","td-2",{"children":"Requires careful access and encryption controls"}]]}],["$","tr","tr-7",{"children":[["$","td","td-0",{"children":"Namespace"}],["$","td","td-1",{"children":"Logical boundary for names and resources"}],["$","td","td-2",{"children":"Helps organize environments and teams"}]]}],["$","tr","tr-8",{"children":[["$","td","td-0",{"children":"Requests and limits"}],["$","td","td-1",{"children":"CPU/memory scheduling and runtime constraints"}],["$","td","td-2",{"children":"Supports scheduling and resource protection"}]]}],["$","tr","tr-9",{"children":[["$","td","td-0",{"children":"Liveness probe"}],["$","td","td-1",{"children":"Checks whether a container should be restarted"}],["$","td","td-2",{"children":"Can recover from certain stuck processes"}]]}],["$","tr","tr-10",{"children":[["$","td","td-0",{"children":"Readiness probe"}],["$","td","td-1",{"children":"Checks whether a Pod should receive traffic"}],["$","td","td-2",{"children":"Keeps unready Pods out of normal Service traffic"}]]}],["$","tr","tr-11",{"children":[["$","td","td-0",{"children":"Startup probe"}],["$","td","td-1",{"children":"Gives slow-starting applications time to initialize"}],["$","td","td-2",{"children":"Prevents premature liveness failures"}]]}],["$","tr","tr-12",{"children":[["$","td","td-0",{"children":"Helm chart"}],["$","td","td-1",{"children":"Reusable package of Kubernetes templates"}],["$","td","td-2",{"children":"Helps standardize deployments"}]]}],["$","tr","tr-13",{"children":[["$","td","td-0",{"children":"GitOps"}],["$","td","td-1",{"children":"Manages infrastructure/application desired state from Git"}],["$","td","td-2",{"children":"Improves reviewability and repeatability"}]]}],["$","tr","tr-14",{"children":[["$","td","td-0",{"children":"Argo CD"}],["$","td","td-1",{"children":"GitOps continuous delivery controller"}],["$","td","td-2",{"children":"Detects and reconciles drift"}]]}],["$","tr","tr-15",{"children":[["$","td","td-0",{"children":"Ingress"}],["$","td","td-1",{"children":"HTTP/HTTPS routing rules into the cluster"}],["$","td","td-2",{"children":"Provides host/path-based entry when an ingress controller is installed"}]]}],["$","tr","tr-16",{"children":[["$","td","td-0",{"children":"Observability"}],["$","td","td-1",{"children":"Metrics, logs, traces, and alerts"}],["$","td","td-2",{"children":"Helps explain system behaviour"}]]}]]}]]}]
2c:["$","hr","hr-4",{}]
2d:["$","h2","h2-4",{"children":"🏗️ Architecture"}]
2e:["$","h3","h3-4",{"children":"High-level workflow"}]
2f:["$","pre","pre-0",{"children":["$","code","code-0",{"className":"language-mermaid","children":"flowchart TD\r\n    DEV[Developer] -->|Commit and Pull Request| GIT[Git Repository]\r\n    GIT -->|Reviewed desired state| ARGO[Argo CD]\r\n    ARGO -->|Reconcile resources| K8S[Kubernetes Cluster]\r\n    K8S --> DEP[Deployment]\r\n    DEP --> RS[ReplicaSet]\r\n    RS --> PODS[Application Pods]\r\n    USER[Client / Browser] --> ING[Ingress Controller]\r\n    ING --> SVC[ClusterIP Service]\r\n    SVC --> PODS\r\n    PODS --> METRICS[Metrics / Logs]\r\n    METRICS --> PROM[Prometheus]\r\n    PROM --> GRAF[Grafana]\n"}]}]
30:["$","h3","h3-5",{"children":"Request path"}]
31:["$","pre","pre-1",{"children":["$","code","code-0",{"className":"language-text","children":"Client / Browser\r\n      |\r\n      v\r\nIngress Controller  (only after installed and configured)\r\n      |\r\n      v\r\nKubernetes Service\r\n      |\r\n      v\r\nReady Application Pod(s)\r\n      |\r\n      v\r\nContainer running the API\n"}]}]
32:["$","h3","h3-6",{"children":"GitOps reconciliation path"}]
33:["$","pre","pre-2",{"children":["$","code","code-0",{"className":"language-text","children":"Engineer changes Git\r\n        |\r\n        v\r\nPull Request review and merge\r\n        |\r\n        v\r\nArgo CD reads the declared state\r\n        |\r\n        v\r\nArgo CD compares Git state with live cluster state\r\n        |\r\n        +---- In Sync ----> No change required\r\n        |\r\n        +---- OutOfSync --> Reconciliation, if sync policy/approval permits\r\n                                  |\r\n                                  v\r\n                            Kubernetes resources\n"}]}]
34:["$","p","p-9",{"children":[["$","strong","strong-0",{"children":"Important distinction:"}]," Argo CD does not automatically build Docker images just because it watches a repository. Image build/publish is normally handled by a CI workflow; GitOps then updates the desired deployment configuration to refer to the intended image."]}]
35:["$","hr","hr-5",{}]
