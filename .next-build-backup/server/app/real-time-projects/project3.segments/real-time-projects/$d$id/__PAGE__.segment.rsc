37:["$","table","table-1",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"children":"Tool"}],["$","th","th-1",{"children":"Responsibility"}],["$","th","th-2",{"children":"Used in this project"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":"Git + GitHub"}],["$","td","td-1",{"children":"Version control and review"}],["$","td","td-2",{"children":"Yes"}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":"Docker"}],["$","td","td-1",{"children":"Package application"}],["$","td","td-2",{"children":"Yes"}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":"kind or minikube"}],["$","td","td-1",{"children":"Local Kubernetes cluster"}],["$","td","td-2",{"children":"Yes — choose one"}]]}],["$","tr","tr-3",{"children":[["$","td","td-0",{"children":"kubectl"}],["$","td","td-1",{"children":"Inspect and manage cluster resources"}],["$","td","td-2",{"children":"Yes"}]]}],["$","tr","tr-4",{"children":[["$","td","td-0",{"children":"Helm"}],["$","td","td-1",{"children":"Package and configure deployment"}],["$","td","td-2",{"children":"Yes"}]]}],["$","tr","tr-5",{"children":[["$","td","td-0",{"children":"Argo CD"}],["$","td","td-1",{"children":"GitOps reconciliation"}],["$","td","td-2",{"children":"Yes"}]]}],["$","tr","tr-6",{"children":[["$","td","td-0",{"children":"Ingress controller"}],["$","td","td-1",{"children":"Route HTTP traffic"}],["$","td","td-2",{"children":"Optional extension"}]]}],["$","tr","tr-7",{"children":[["$","td","td-0",{"children":"Prometheus"}],["$","td","td-1",{"children":"Collect metrics"}],["$","td","td-2",{"children":"Optional extension"}]]}],["$","tr","tr-8",{"children":[["$","td","td-0",{"children":"Grafana"}],["$","td","td-1",{"children":"Visualize metrics"}],["$","td","td-2",{"children":"Optional extension"}]]}],["$","tr","tr-9",{"children":[["$","td","td-0",{"children":"Amazon EKS"}],["$","td","td-1",{"children":"Managed Kubernetes on AWS"}],["$","td","td-2",{"children":"Optional later migration"}]]}]]}]]}]
