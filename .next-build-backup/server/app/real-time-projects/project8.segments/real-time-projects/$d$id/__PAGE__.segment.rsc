5b:["$","pre","pre-13",{"children":["$","code","code-0",{"className":"language-yaml","children":"apiVersion: v2\r\nname: web-app\r\ndescription: Helm chart for the Project 08 Kubernetes web application\r\ntype: application\r\nversion: 0.1.0\r\nappVersion: \"1.0.0\"\n"}]}]
