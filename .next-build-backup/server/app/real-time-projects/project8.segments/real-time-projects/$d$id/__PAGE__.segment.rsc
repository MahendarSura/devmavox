b3:["$","ul","ul-6",{"className":"contains-task-list","children":["\n",["$","li","li-0",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Docker image builds and starts locally."]}],"\n",["$","li","li-1",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Helm chart passes ",["$","code","code-0",{"children":"helm lint"}]," and renders valid manifests."]}],"\n",["$","li","li-2",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Application Pods become Ready in the local cluster."]}],"\n",["$","li","li-3",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Service responds through port-forwarding."]}],"\n",["$","li","li-4",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","NGINX Ingress routes the hostname when local ingress networking is configured."]}],"\n",["$","li","li-5",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Argo CD can access the repository and reports the app as Synced/Healthy."]}],"\n",["$","li","li-6",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","A Git change updates the intended configuration."]}],"\n",["$","li","li-7",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","GitOps recovery/rollback is understood and documented."]}],"\n",["$","li","li-8",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Troubleshooting commands and actual screenshots are added."]}],"\n",["$","li","li-9",{"className":"task-list-