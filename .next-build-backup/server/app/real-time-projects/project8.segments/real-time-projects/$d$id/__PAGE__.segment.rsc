th, values, live changes"}]]}],["$","tr","tr-6",{"children":[["$","td","td-0",{"children":"Argo CD cannot sync"}],["$","td","td-1",{"children":"Inspect Application events and controller logs"}],["$","td","td-2",{"children":"Invalid manifests, RBAC, repository access"}]]}],["$","tr","tr-7",{"children":[["$","td","td-0",{"children":"Service has no endpoints"}],["$","td","td-1",{"children":["$","code","code-0",{"children":"kubectl get endpoints -n production"}]}],["$","td","td-2",{"children":"Service selector versus Pod labels; Pod readiness"}]]}],["$","tr","tr-8",{"children":[["$","td","td-0",{"children":"Rollout stalls"}],["$","td","td-1",{"children":["$","code","code-0",{"children":"kubectl rollout status deployment/web-app -n production"}]}],["$","td","td-2",{"children":"Probe failures, resources, image availability"}]]}]]}]]}]
