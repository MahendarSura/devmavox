ab:["$","h2","h2-19",{"children":"💼 Interview Preparation"}]
ac:["$","h3","h3-18",{"children":"60-second project explanation"}]
ad:["$","blockquote","blockquote-4",{"children":["\n",["$","p","p-0",{"children":"“I deployed a containerized web application to Kubernetes using Helm for reusable configuration. I configured a Deployment with rolling updates, resource requests and limits, and health probes. I exposed the application through a Service and NGINX Ingress. I then configured Argo CD to watch the Git repository and reconcile the cluster with the declared Helm configuration. I verified the rollout, tested the health endpoint, and documented troubleshooting and GitOps recovery procedures.”"}],"\n"]}]
ae:["$","p","p-51",{"children":"Only describe the components you have personally configured and tested."}]
af:["$","h3","h3-19",{"children":"Interview questions"}]
b0:["$","ol","ol-2",{"children":["\n",["$","li","li-0",{"children":"What problem does Kubernetes solve?"}],"\n",["$","li","li-1",{"children":"What is the difference between a Pod, ReplicaSet, and Deployment?"}],"\n",["$","li","li-2",{"children":"Compare ClusterIP, NodePort, and LoadBalancer Services."}],"\n",["$","li","li-3",{"children":"What is an Ingress, and why is an Ingress Controller needed?"}],"\n",["$","li","li-4",{"children":"What are Helm charts, templates, and values files?"}],"\n",["$","li","li-5",{"children":"How does Argo CD implement GitOps?"}],"\n",["$","li","li-6",{"children":["What is the difference between ",["$","code","code-0",{"children":"OutOfSync"}]," and ",["$","code","code-1",{"children":"Degraded"}],"?"]}],"\n",["$","li","li-7",{"children":"How do readiness and liveness probes differ?"}],"\n",["$","li","li-8",{"children":"How does a rolling update work?"}],"\n",["$","li","li-9",{"children":["How would you troubleshoot ",["$","code","code-0",{"children":"ImagePullBackOff"}],"?"]}],"\n",["$","li","li-10",{"children":"What is configuration drift, and how can Argo CD self-heal help?"}],"\n",["$","li","li-11",{"children":"Why can a direct Helm rollback conflict with GitOps?"}],"\n",["$","li","li-12",{"children":"How do requests and limits affect Kubernetes scheduling?"}],"\n",["$","li","li-13",{"children":"How would you expose this app securely over HTTPS?"}],"\n",["$","li","li-14",{"children":"What additional controls would you implement before production?"}],"\n"]}]
