98:["$","ul","ul-5",{"className":"contains-task-list","children":["\n",["$","li","li-0",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Use a trusted image registry and immutable tags or image digests."]}],"\n",["$","li","li-1",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Run containers as non-root."]}],"\n",["$","li","li-2",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Drop unnecessary Linux capabilities and prevent privilege escalation."]}],"\n",["$","li","li-3",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Set resource requests and limits based on workload measurements."]}],"\n",["$","li","li-4",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Configure readiness, liveness, and (where needed) startup probes."]}],"\n",["$","li","li-5",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Use TLS for external traffic and plan certificate renewal."]}],"\n",["$","li","li-6",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Store secrets in an approved secret manager; do not commit them to Git."]}],"\n",["$","li","li-7",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Apply least-privilege Kubernetes RBAC."]}],"\n",["$","li","li-8",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Use NetworkPolicies where supported by the cluster's network plugin."]}],"\n",["$","li","li-9",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Scan images and dependencies and define a response process for critical findings."]}],"\n",["$","li","li-10",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Protect Git branches and require review for production changes."]}],"\n",["$","li","li-11",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Monitor application health, latency, errors, and resource saturation."]}],"\n",["$","li","li-12",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Test rollback, backup, restore, and disaster-recovery procedures."]}],"\n",["$","li","li-13",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Pin controller/tool versions and plan upgrades."]}],"\n",["$","li","li-14",{"className":"task-list-item","children":[["$","input","input-0",{"type":"checkbox","checked":false,"disabled":true}]," ","Evaluate PodDisruptionBudgets and autoscaling for the real workload."]}],"\n"]}]
