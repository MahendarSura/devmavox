81:["$","table","table-2",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"children":"Setting"}],["$","th","th-1",{"children":"Meaning"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":["$","code","code-0",{"children":"automated"}]}],["$","td","td-1",{"children":"Allows Argo CD to sync desired configuration automatically"}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":["$","code","code-0",{"children":"prune: true"}]}],["$","td","td-1",{"children":"Allows Argo CD to remove managed resources deleted from Git"}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":["$","code","code-0",{"children":"selfHeal: true"}]}],["$","td","td-1",{"children":"Reconciles supported live changes back toward the declared Git state"}]]}],["$","tr","tr-3",{"children":[["$","td","td-0",{"children":["$","code","code-0",{"children":"CreateNamespace=true"}]}],["$","td","td-1",{"children":"Creates the destination namespace if it does not exist"}]]}]]}]]}]
82:["$","blockquote","blockquote-3",{"children":["\n",["$","p","p-0",{"children":[["$","strong","strong-0",{"children":"Important:"}]," Pruning can delete resources. Protect production branches, use reviews and RBAC, and understand the impact of each Git change. For private repositories, configure repository access through Argo CD's supported credential mechanisms. Never commit tokens or passwords to this YAML."]}],"\n"]}]
