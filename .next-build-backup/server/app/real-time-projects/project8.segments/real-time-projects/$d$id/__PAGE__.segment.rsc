43:["$","pre","pre-6",{"children":["$","code","code-0",{"className":"language-python","children":"from http.server import BaseHTTPRequestHandler, HTTPServer\r\nimport json\r\nimport os\r\n\r\n\r\nclass Handler(BaseHTTPRequestHandler):\r\n    def do_GET(self):\r\n        if self.path == \"/health\":\r\n            status_code = 200\r\n            response = {\"status\": \"healthy\"}\r\n        else:\r\n            status_code = 200\r\n            response = {\r\n                \"application\": \"project-08-web-app\",\r\n                \"message\": \"Running on Kubernetes\",\r\n                \"environment\": os.getenv(\"APP_ENV\", \"development\"),\r\n            }\r\n\r\n        body = json.dumps(response).encode(\"utf-8\")\r\n        self.send_response(status_code)\r\n        self.send_header(\"Content-Type\", \"application/json\")\r\n        self.send_header(\"Content-Length\", str(len(body)))\r\n        self.end_headers()\r\n        self.wfile.write(body)\r\n\r\n    def log_message(self, format_string, *args):\r\n        print(\"%s - %s\" % (self.address_string(), format_string % args))\r\n\r\n\r\nHTTPServer((\"0.0.0.0\", 8080), Handler).serve_forever()\n"}]}]
44:["$","p","p-14",{"children":["Create ",["$","code","code-0",{"children":"app/requirements.txt"}]," as an empty file; this sample uses only the Python standard library."]}]
