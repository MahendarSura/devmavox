61:["$","pre","pre-16",{"children":["$","code","code-0",{"className":"language-yaml","children":"apiVersion: v1\r\nkind: Service\r\nmetadata:\r\n  name: {{ include \"web-app.fullname\" . }}\r\nspec:\r\n  type: {{ .Values.service.type }}\r\n  selector:\r\n    app.kubernetes.io/name: {{ include \"web-app.name\" . }}\r\n    app.kubernetes.io/instance: {{ .Release.Name }}\r\n  ports:\r\n    - name: http\r\n      port: {{ .Values.service.port }}\r\n      targetPort: http\r\n      protocol: TCP\n"}]}]
62:["$","h3","h3-13",{"children":["$","code","code-0",{"children":"helm/web-app/templates/ingress.yaml"}]}]
63:["$","pre","pre-17",{"children":["$","code","code-0",{"className":"language-yaml","children":"{{- if .Values.ingress.enabled }}\r\napiVersion: networking.k8s.io/v1\r\nkind: Ingress\r\nmetadata:\r\n  name: {{ include \"web-app.fullname\" . }}\r\nspec:\r\n  ingressClassName: {{ .Values.ingress.className }}\r\n  rules:\r\n    - host: {{ .Values.ingress.host | quote }}\r\n      http:\r\n        paths:\r\n          - path: {{ .Values.ingress.path }}\r\n            pathType: {{ .Values.ingress.pathType }}\r\n            backend:\r\n              service:\r\n                name: {{ include \"web-app.fullname\" . }}\r\n                port:\r\n                  number: {{ .Values.service.port }}\r\n{{- end }}\n"}]}]
