77:T584,services:
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --web.enable-lifecycle
    ports:
      - "9090:9090"
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./prometheus/alerts.yml:/etc/prometheus/alerts.yml:ro
      - prometheus_data:/prometheus
    restart: unless-stopped
    networks: [monitoring]

  alertmanager:
    image: prom/alertmanager:latest
    container_name: alertmanager
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
    ports:
      - "9093:9093"
    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
    restart: unless-stopped
    networks: [monitoring]

  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    ports:
      - "3000:3000"
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: change-this-local-password
      GF_USERS_ALLOW_SIGN_UP: "false"
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro
    restart: unless-stopped
    networks: [monitoring]

volumes:
  prometheus_data:
  grafana_data:

networks:
  monitoring:
    driver: bridge
2e:["$","pre","pre-4",{"children":["$","code","code-0",{"className":"language-yaml","children":"$77"}]}]
2f:["$","blockquote","blockquote-1",{"children":["\n",["$","p","p-0",{"children":["[!WARNING]\r\nThis Compose file uses ",["$","code","code-0",{"children":"latest"}]," tags and a sample Grafana password for convenient local learning. Pin image versions and use secrets or an appropriate secret manager before using it beyond a disposable lab. Do not expose these ports directly to the public internet."]}],"\n"]}]
30:["$","h3","h3-7",{"children":["3️⃣ Create ",["$","code","code-0",{"children":"prometheus/prometheus.yml"}]]}]
31:["$","pre","pre-5",{"children":["$","code","code-0",{"className":"language-yaml","children":"global:\r\n  scrape_interval: 15s\r\n  evaluation_interval: 15s\r\n\r\nrule_files:\r\n  - /etc/prometheus/alerts.yml\r\n\r\nalerting:\r\n  alertmanagers:\r\n    - static_configs:\r\n        - targets:\r\n            - alertmanager:9093\r\n\r\nscrape_configs:\r\n  - job_name: prometheus\r\n    static_configs:\r\n      - targets: [\"prometheus:9090\"]\n"}]}]
32:["$","p","p-6",{"children":"This minimal configuration monitors Prometheus itself. Add exporters or application targets when they are available on the same Docker network or reachable from the Prometheus container."}]
33:["$","h3","h3-8",{"children":["4️⃣ Create ",["$","code","code-0",{"children":"prometheus/alerts.yml"}]]}]
34:["$","pre","pre-6",{"children":["$","code","code-0",{"className":"language-yaml","children":"groups:\r\n  - name: monitoring-stack\r\n    rules:\r\n      - alert: PrometheusTargetMissing\r\n        expr: up == 0\r\n        for: 1m\r\n        labels:\r\n          severity: warning\r\n        annotations:\r\n          summary: \"A Prometheus scrape target is down\"\r\n          description: \"Target {{ $labels.job }} at {{ $labels.instance }} has been unreachable for more than one minute.\"\r\n\r\n      - alert: PrometheusConfigReloadFailed\r\n        expr: prometheus_config_last_reload_successful == 0\r\n        for: 2m\r\n        labels:\r\n          severity: critical\r\n        annotations:\r\n          summary: \"Prometheus configuration reload failed\"\r\n          description: \"Prometheus has not successfully reloaded its configuration.\"\n"}]}]
35:["$","h3","h3-9",{"children":["5️⃣ Create ",["$","code","code-0",{"children":"alertmanager/alertmanager.yml"}]]}]
