db:["$","blockquote","blockquote-5",{"children":["\n",["$","p","p-0",{"children":"“I am building an end-to-end DevSecOps platform for a three-tier application on AWS EKS. Terraform is used to define the cloud infrastructure. The application is containerized with Docker, and Jenkins automates checkout, testing, image build and security scanning. Approved images are stored in Amazon ECR. The deployment configuration is maintained in Git, and Argo CD synchronizes that desired state to Kubernetes. Prometheus and Grafana are used for monitoring, and I document health checks, troubleshooting and rollback procedures. I validate each stage and capture evidence from the actual environment.”"}],"\n"]}]
dc:["$","h2","h2-36",{"children":"Interview questions to practice"}]
dd:["$","ol","ol-17",{"children":["\n",["$","li","li-0",{"children":"Why did you choose EKS instead of running containers directly on EC2?"}],"\n",["$","li","li-1",{"children":"Terraform state ante enti? Why should it not be committed to public Git?"}],"\n",["$","li","li-2",{"children":"Docker image and running container madhya difference enti?"}],"\n",["$","li","li-3",{"children":"Jenkins and Argo CD roles ela different?"}],"\n",["$","li","li-4",{"children":"GitOps ante enti? Git and cluster state differ ayithe em chestaru?"}],"\n",["$","li","li-5",{"children":"Kubernetes Deployment and Service enduku separate?"}],"\n",["$","li","li-6",{"children":"Readiness probe and liveness probe difference enti?"}],"\n",["$","li","li-7",{"children":[["$","code","code-0",{"children":"CrashLoopBackOff"}]," ni ela troubleshoot chestaru?"]}],"\n",["$","li","li-8",{"children":[["$","code","code-0",{"children":"ImagePullBackOff"}]," ki possible causes enti?"]}],"\n",["$","li","li-9",{"children":"ECR access ni secure ga ela configure chestaru?"}],"\n",["$","li","li-10",{"children":"Secrets ni Jenkins/Kubernetes lo ela handle chestaru?"}],"\n",["$","li","li-11",{"children":"Trivy scan fail ayithe release process em chestundi?"}],"\n",["$","li","li-12",{"children":"Prometheus and Grafana roles enti?"}],"\n",["$","li","li-13",{"children":"High latency and high CPU ni ela investigate chestaru?"}],"\n",["$","li","li-14",{"children":"Rollback chesetappudu database migrations enduku careful ga handle cheyyali?"}],"\n",["$","li","li-15",{"children":"AWS cost unexpected ga perigite first em check chestaru?"}],"\n",["$","li","li-16",{"children":"Production-ready ani claim cheyyadaniki additional ga em evidence kavali?"}],"\n"]}]
