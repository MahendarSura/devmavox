    { command: "enable -n printf", description: "Disable a Bash built-in temporarily. Built-in command disable చేస్తుంది.", level: "Advanced" },
    { command: "enable printf", description: "Re-enable a disabled Bash built-in. Disabled built-in మళ్లీ enable చేస్తుంది.", level: "Advanced" },
    { command: "bind -P", description: "List Readline key bindings. Readline keyboard shortcuts చూపిస్తుంది.", level: "Advanced" },
    { command: "compgen -c", description: "List available shell commands. Available commands list చేస్తుంది.", level: "Advanced" },
    { command: "complete -W 'start stop' service", description: "Define simple command completion. Command completion options define చేస్తుంది.", level: "Advanced" },
    { command: "shopt -p", description: "Print current shell option settings. Shell options status చూపిస్తుంది.", level: "Advanced" },
    { command: "set -- one two three", description: "Set positional parameters. Positional arguments set చేస్తుంది.", level: "Advanced" },
    { command: "shift", description: "Shift positional parameters. Arguments positions మార్చుతుంది.", level: "Advanced" },
    { command: "getopts ':f:v' opt", description: "Parse short command-line options. Short options parse చేస్తుంది.", level: "Advanced" },
    { command: "[[ -f file.txt ]]", description: "Test whether a regular file exists. Regular file ఉందో లేదో check చేస్తుంది.", level: "Advanced" },
    { command: "[[ $value =~ ^[0-9]+$ ]]", description: "Validate a value using regex. Value numbers మాత్రమేనా check చేస్తుంది.", level: "Advanced" },
    { command: "(( count += 1 ))", description: "Perform arithmetic evaluation. Arithmetic calculation చేస్తుంది.", level: "Advanced" },
    { command: "printf -v result '%s' \"$value\"", description: "Store formatted output in a variable. Formatted output variable లో store చేస్తుంది.", level: "Advanced" },
    { command: "exec {fd}>output.log", description: "Allocate a dynamic file descriptor. Dynamic file descriptor allocate చేస్తుంది.", level: "Advanced" },
    { command: "unset -v variable", description: "Unset a shell variable. Shell variable తొలగిస్తుంది.", level: "Advanced" },

    // ==================== TROUBLESHOOTING (60) ====================
    { command: "bash -n script.sh", description: "Check for syntax errors. Syntax errors ఉన్నాయా check చేస్తుంది.", level: "Troubleshooting" },
    { command: "bash -x script.sh", description: "Trace each executed command. ప్రతి command execution చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "set -x", description: "Enable execution tracing. Script tracing enable చేస్తుంది.", level: "Troubleshooting" },
    { command: "set +x", description: "Disable execution tracing. Script tracing disable చేస్తుంది.", level: "Troubleshooting" },
    { command: "type -a python", description: "Find all command resolutions. Command ఎక్కడ resolve అవుతుందో చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "command -v python", description: "Check whether a command is available. Command available ఉందో check చేస్తుంది.", level: "Troubleshooting" },
    { command: "echo \"$PATH\"", description: "Inspect the executable search path. PATH లో సమస్య ఉందో పరిశీలిస్తుంది.", level: "Troubleshooting" },
    { command: "printf '<%s>\\n' \"$variable\"", description: "Reveal whitespace in a variable. Variable లో spaces ఉన్నాయో చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "declare -p variable", description: "Inspect variable value and attributes. Variable value, attributes పరిశీలిస్తుంది.", level: "Troubleshooting" },
    { command: "env | sort", description: "Inspect sorted environment variables. Environment variables పరిశీలిస్తుంది.", level: "Troubleshooting" },
    { command: "set -u", description: "Detect references to unset variables. Unset variable errors గుర్తిస్తుంది.", level: "Troubleshooting" },
    { command: "set -e", description: "Stop after an unhandled command failure. Command failure తర్వాత script stop అవుతుంది.", level: "Troubleshooting" },
    { command: "set -o pipefail", description: "Detect failed commands in pipelines. Pipeline failure గుర్తిస్తుంది.", level: "Troubleshooting" },
    { command: "echo $?", description: "Inspect the previous exit status. Previous command exit status చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "trap -p", description: "Inspect installed signal traps. Signal traps పరిశీలిస్తుంది.", level: "Troubleshooting" },
    { command: "ulimit -a", description: "Inspect process resource limits. Process resource limits చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "jobs -l", description: "Inspect background job process IDs. Background job PIDs చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "ps -ef", description: "Inspect running processes. Running processes పరిశీలిస్తుంది.", level: "Troubleshooting" },
    { command: "kill -0 1234", description: "Check whether a process exists and is accessible. Process ఉందో check చేస్తుంది.", level: "Troubleshooting" },
    { command: "lsof -p 1234", description: "Inspect files opened by a process. Process open చేసిన files చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "fuser file.txt", description: "Find processes using a file. File ని వాడుతున్న processes చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "df -h", description: "Check available disk space. Disk space సమస్య పరిశీలిస్తుంది.", level: "Troubleshooting" },
    { command: "du -sh .", description: "Check current directory size. Current folder size చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "free -h", description: "Check available memory. Available memory చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "date -u", description: "Check system time in UTC. UTC time పరిశీలిస్తుంది.", level: "Troubleshooting" },
    { command: "locale", description: "Inspect locale configuration. Locale settings పరిశీలిస్తుంది.", level: "Troubleshooting" },
    { command: "file script.sh", description: "Identify script file format. Script file format గుర్తిస్తుంది.", level: "Troubleshooting" },
    { command: "dos2unix script.sh", description: "Convert Windows line endings to Unix. Windows line endings సమస్య సరిచేస్తుంది.", level: "Troubleshooting" },
    { command: "sed -n '1,20l' script.sh", description: "Reveal hidden characters in lines. Hidden characters చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "od -c script.sh", description: "Inspect file characters and bytes. File characters పరిశీలిస్తుంది.", level: "Troubleshooting" },
    { command: "bash --version", description: "Check the installed Bash version. Bash version చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "bash -c 'echo test'", description: "Test Bash command execution. Bash execution పని చేస్తుందో check చేస్తుంది.", level: "Troubleshooting" },
    { command: "printf '%q\\n' \"$variable\"", description: "Display shell-escaped variable content. Variable escaped format చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "shopt -s inherit_errexit", description: "Propagate errexit into command substitutions where supported. Command substitution error handling మెరుగుపరుస్తుంది.", level: "Troubleshooting" },
    { command: "set -o", description: "List shell option states. Shell options states చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "shopt", description: "List Bash shell options. Bash options పరిశీలిస్తుంది.", level: "Troubleshooting" },
    { command: "type command_name", description: "Check alias, function, or executable resolution. Command alias లేదా executable ఏదో గుర్తిస్తుంది.", level: "Troubleshooting" },
    { command: "alias", description: "Inspect configured aliases. Aliases పరిశీలిస్తుంది.", level: "Troubleshooting" },
    { command: "hash -r", description: "Clear cached command paths. Cached command paths clear చేస్తుంది.", level: "Troubleshooting" },
    { command: "hash -l", description: "List cached command locations. Cached command locations చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "pwd -P", description: "Display the physical working directory. Physical directory path చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "readlink -f script.sh", description: "Resolve a file's absolute path. File actual path తెలుసుకుంటుంది.", level: "Troubleshooting" },
    { command: "ls -lb", description: "Reveal escaped filenames. Special characters ఉన్న filenames చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "stat -c '%A %U %G' script.sh", description: "Inspect permissions and ownership. File permissions, ownership చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "test -r file.txt", description: "Check read permission. Read permission ఉందో check చేస్తుంది.", level: "Troubleshooting" },
    { command: "test -w file.txt", description: "Check write permission. Write permission ఉందో check చేస్తుంది.", level: "Troubleshooting" },
    { command: "test -x script.sh", description: "Check execute permission. Execute permission ఉందో check చేస్తుంది.", level: "Troubleshooting" },
    { command: "find . -type f -empty", description: "Find empty files. Empty files వెతుకుతుంది.", level: "Troubleshooting" },
    { command: "grep -nE 'ERROR|FATAL' app.log", description: "Locate serious log messages. Error, fatal messages వెతుకుతుంది.", level: "Troubleshooting" },
    { command: "tail -n 100 app.log", description: "Inspect the latest log entries. Latest log entries చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "tail -F app.log", description: "Follow a log across file rotation. Log rotation తర్వాత కూడా follow చేస్తుంది.", level: "Troubleshooting" },
    { command: "journalctl -n 100", description: "Inspect recent system journal entries. Recent system logs చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "logger 'Bash diagnostic test'", description: "Write a diagnostic message to the system log. Diagnostic message system log లో రాస్తుంది.", level: "Troubleshooting" },
    { command: "timeout 10s ./script.sh", description: "Stop a command after a time limit. Time limit తర్వాత command stop చేస్తుంది.", level: "Troubleshooting" },
    { command: "command time ./script.sh", description: "Measure script execution time. Script execution time కొలుస్తుంది.", level: "Troubleshooting" },
    { command: "strace -f -o trace.log bash script.sh", description: "Trace system calls made by a script. Script system calls trace చేస్తుంది.", level: "Troubleshooting" },
    { command: "shellcheck script.sh", description: "Analyze a shell script for common issues. Shell script mistakes గుర్తిస్తుంది.", level: "Troubleshooting" },
    { command: "bash -O extdebug -n script.sh", description: "Run an extended Bash syntax check. Extended syntax diagnostics చేస్తుంది.", level: "Troubleshooting" },
    { command: "printf '%s\\n' \"${BASH_VERSION}\"", description: "Inspect the Bash version variable. Bash version variable చూపిస్తుంది.", level: "Troubleshooting" },
    { command: "ulimit -c", description: "Inspect the core dump size limit. Core dump limit చూపిస్తుంది.", level: "Troubleshooting" }
  ]
};

