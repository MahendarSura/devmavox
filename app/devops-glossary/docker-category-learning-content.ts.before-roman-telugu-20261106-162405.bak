import type { GlossaryLearningSection } from "./glossary-data";

const bi = (te: string, en: string) =>
  `Telugu Answer:\n${te}\n\nEnglish Explanation:\n${en}`;

type Entry = {
  title: string;
  te: string;
  en: string;
  commands?: string[];
  details?: string[];
  example?: string;
};

const sections = (
  name: string,
  entries: Entry[]
): GlossaryLearningSection[] =>
  entries.map((e, i) => ({
    title: [
      "1. Purpose – Why Is It Used?",
      "2. How It Works",
      "3. Real-Time Project Example",
      "4. Architecture / Components",
      "5. Step-by-Step Workflow",
      "6. Practical Commands",
      "7. Configuration Examples",
      "8. Common Mistakes",
      "9. Troubleshooting",
      "10. Best Practices",
      "11. Security Considerations",
      "12. Interview Points",
      "13. Related Concepts"
    ][i],
    items: [{
      title: e.title,
      explanation: bi(e.te, e.en),
      ...(e.commands ? { commands: e.commands } : {}),
      ...(e.details ? { details: e.details } : {}),
      ...(e.example ? { example: e.example } : {})
    }]
  }));

export const dockerCategoryLearningContent:
  Record<string, GlossaryLearningSection[]> = {

"Docker Engine": sections("Docker Engine", [
{title:"Docker Engine Purpose",te:"Docker Engine అనేది containers ను create చేయడానికి, run చేయడానికి, manage చేయడానికి ఉపయోగించే ప్రధాన container runtime platform. Developer application ను container రూపంలో అమలు చేయడానికి ఇది అవసరం.",en:"Docker Engine is the platform responsible for building, running and managing containers. It provides the client interface, daemon and runtime integration needed to manage container workloads.",details:["Runs and manages containers","Manages images, networks and volumes"]},
{title:"Client and Daemon Communication",te:"Docker CLI command ఇచ్చినప్పుడు అది Docker daemon కు API request పంపుతుంది. Daemon ఆ request ను process చేసి container లేదా image operation నిర్వహిస్తుంది.",en:"The Docker CLI communicates with the Docker daemon through the Docker API. The daemon processes requests such as image builds, container creation, networking and volume management.",details:["Docker CLI: command-line client","dockerd: background daemon","Docker API: communication interface"]},
{title:"Production Container Host",te:"Production Linux server లో Docker Engine install చేసి application image ను pull చేసి container run చేయవచ్చు. Health checks, logs మరియు restart behaviour ద్వారా application ను monitor చేయాలి.",en:"A production team can install Docker Engine on a Linux host, pull a tested application image and run the service as a container. The team monitors health, logs and restart behaviour.",example:"docker pull nginx:stable\ndocker run -d --name web -p 8080:80 nginx:stable"},
{title:"Engine Architecture",te:"Docker Engine లో Docker CLI, Docker daemon, REST API, containerd మరియు OCI runtime వంటి భాగాలు కలిసి పనిచేస్తాయి. వీటి responsibilities వేర్వేరుగా ఉంటాయి.",en:"Docker Engine uses a client-server architecture. The CLI sends API requests to dockerd. Container lifecycle work is coordinated with containerd and an OCI runtime such as runc.",details:["Docker CLI","Docker daemon (dockerd)","Docker REST API","containerd","OCI runtime such as runc"]},
{title:"Engine Operational Workflow",te:"ముందుగా Docker service status చూడాలి. తర్వాత image pull చేసి container create చేయాలి. Container status, logs మరియు application response verify చేయాలి.",en:"Check the daemon, retrieve the required image, create the container with the required settings, and validate its state and application response.",commands:["sudo systemctl status docker","docker pull nginx:stable","docker run -d --name web -p 8080:80 nginx:stable","docker ps","docker logs web"]},
{title:"Engine Diagnostic Commands",te:"Docker Engine health మరియు configuration తెలుసుకోవడానికి version, info, ps మరియు system service logs commands ఉపయోగించాలి.",en:"Use Docker CLI and Linux service commands to inspect engine version, daemon configuration, running containers and service logs.",commands:["docker version","docker info","docker ps -a","sudo journalctl -u docker -n 100","sudo systemctl status docker"]},
{title:"Daemon Configuration",te:"Docker daemon settings ను సాధారణంగా /etc/docker/daemon.json లో configure చేస్తారు. JSON syntax valid గా ఉందో check చేసి, change తర్వాత service restart చేయాలి.",en:"On Linux, daemon settings can be configured in /etc/docker/daemon.json. Validate the JSON and understand the impact before restarting the Docker service.",example:"{\n  \"log-driver\": \"local\",\n  \"live-restore\": true\n}",details:["Back up daemon.json before editing","Validate JSON syntax","Restart Docker only during an approved change window"]},
{title:"Engine Configuration Mistakes",te:"daemon.json లో invalid JSON, conflicting options, incorrect storage configuration లేదా restart చేయకపోవడం వల్ల Docker Engine సమస్యలు రావచ్చు.",en:"Common failures include invalid JSON, conflicting daemon flags, incorrect storage settings and changes that were never loaded because the daemon was not restarted.",details:["Check commas and quotation marks in JSON","Review daemon startup errors","Avoid changing storage drivers without a migration plan"]},
{title:"Engine Troubleshooting",te:"Docker service start కాకపోతే systemctl status మరియు journalctl logs పరిశీలించాలి. Disk space, daemon configuration, socket permissions మరియు storage availability కూడా check చేయాలి.",en:"When Docker fails to start, inspect systemd status and daemon logs. Check disk capacity, daemon configuration, socket permissions and storage availability before attempting recovery.",commands:["sudo systemctl status docker","sudo journalctl -u docker --since '30 minutes ago'","df -h","sudo dockerd --validate --config-file=/etc/docker/daemon.json"]},
{title:"Engine Best Practices",te:"Docker Engine ను supported version లో maintain చేయాలి. Logs, storage మరియు resource usage monitor చేయాలి. Production లో changes కు backup మరియు rollback plan ఉండాలి.",en:"Keep Docker Engine on a supported release, monitor storage and resource usage, centralize logs, and test daemon configuration changes before production rollout.",details:["Use supported engine versions","Monitor disk and inode usage","Set container resource limits","Document daemon configuration"]},
{title:"Engine Security",te:"Docker socket కు unrestricted access ఇవ్వకూడదు. Rootful daemon access చాలా powerful. అవసరమైన users కు మాత్రమే access ఇవ్వాలి; rootless mode కూడా అవసరాన్ని బట్టి పరిశీలించాలి.",en:"Access to the Docker daemon socket can provide host-level control. Restrict membership and socket access, evaluate rootless mode, and avoid exposing the daemon API over an unprotected network.",details:["Restrict /var/run/docker.sock access","Use rootless mode where appropriate","Never expose an unauthenticated Docker API endpoint"]},
{title:"Engine Interview Points",te:"Interview లో Docker Engine client-server architecture, dockerd, containerd, OCI runtime మరియు Docker API గురించి వివరించాలి. Container create చేసినప్పుడు request ఎలా process అవుతుందో explain చేయాలి.",en:"Explain Docker Engine's client-server model, the role of dockerd, containerd and an OCI runtime, and how the Docker API connects the CLI to the daemon.",details:["Differentiate Docker CLI and Docker daemon","Explain containerd and runc responsibilities","Describe daemon troubleshooting"]},
{title:"Engine Related Concepts",te:"Docker Engine కు Docker CLI, Docker API, containerd, runc, Docker Image, Docker Container మరియు Docker Network సంబంధం కలిగి ఉంటాయి.",en:"Related concepts include the Docker CLI, Docker API, containerd, OCI runtimes, images, containers, networks and volumes.",details:["Docker CLI","Docker API","containerd","runc","Docker Image","Docker Container"]}
]),

"Docker Registry": sections("Docker Registry", [
{title:"Registry Purpose",te:"Docker Registry అనేది container images ను store చేయడానికి మరియు teams మధ్య distribute చేయడానికి ఉపయోగించే service. Build చేసిన image ను registry లో push చేసి deployment servers నుంచి pull చేయవచ్చు.",en:"A Docker Registry stores and distributes container images. CI pipelines push built images to a registry, and deployment environments pull approved images from it.",details:["Central image storage","Image distribution between environments","Private image access control"]},
{title:"Registry Workflow",te:"Developer image build చేసిన తర్వాత registry authentication చేసి image కు registry path మరియు tag ఇవ్వాలి. తర్వాత push చేస్తే registry image layers ను store చేస్తుంది.",en:"A client authenticates to a registry, tags an image with the registry and repository path, and pushes its layers. Other clients authenticate and pull the image when deploying.",details:["Authenticate","Tag image","Push image","Pull image"]},
{title:"CI/CD Registry Example",te:"CI pipeline application image build చేసి private registry లో push చేస్తుంది. Deployment pipeline అదే versioned image ను Kubernetes cluster లో deploy చేస్తుంది.",en:"A CI pipeline builds an application image, tags it with a commit identifier and pushes it to a private registry. A deployment pipeline then references that exact image version.",example:"docker build -t registry.example.com/payments/api:v1.4.2 .\ndocker push registry.example.com/payments/api:v1.4.2"},
{title:"Registry Components",te:"Registry లో registry server, repository, image manifest, layers, tags మరియు digest ఉంటాయి. Repository ఒక application image versions ను organize చేస్తుంది.",en:"A registry contains repositories, manifests and image layers. Tags provide human-readable references, while digests identify image content by its cryptographic hash.",details:["Registry endpoint","Repository","Image manifest","Image layers","Tag","Content digest"]},
{title:"Registry Push and Pull Workflow",te:"ముందుగా registry login చేయాలి. Image కు సరైన registry URL తో tag ఇవ్వాలి. Push తర్వాత deployment host లో login చేసి required image pull చేయాలి.",en:"Authenticate to the registry, tag the local image with the correct repository path, push it, and verify that the target environment can pull the intended version.",commands:["docker login registry.example.com","docker tag api:latest registry.example.com/team/api:v1","docker push registry.example.com/team/api:v1","docker pull registry.example.com/team/api:v1"]},
{title:"Registry Commands",te:"Registry images manage చేయడానికి login, logout, tag, push, pull మరియు image inspect commands ఉపయోగిస్తారు.",en:"These commands authenticate, label images, transfer them to and from a registry, and inspect local image metadata.",commands:["docker login","docker logout","docker image ls","docker image inspect api:v1","docker push registry.example.com/team/api:v1","docker pull registry.example.com/team/api:v1"]},
{title:"Registry Naming Configuration",te:"Image reference లో registry hostname, repository path మరియు tag ఉంటాయి. Production deployments లో latest tag బదులుగా release version లేదా commit identifier ఉపయోగించాలి.",en:"An image reference typically includes a registry hostname, repository path and tag. Use immutable release identifiers or digests for reliable deployments.",example:"registry.example.com/platform/payments-api:1.4.2\nregistry.example.com/platform/payments-api@sha256:<digest>"},
{title:"Registry Mistakes",te:"Wrong repository path, invalid credentials, missing permissions, incorrect tag మరియు network/TLS problems వల్ల push లేదా pull fail అవుతాయి.",en:"Typical mistakes include incorrect image names, missing repository permissions, expired credentials, wrong tags and TLS trust problems.",details:["Confirm the registry hostname","Check repository and tag spelling","Verify push or pull permissions"]},
{title:"Registry Troubleshooting",te:"Unauthorized error వస్తే credentials మరియు permissions check చేయాలి. Image not found వస్తే repository path, tag మరియు registry hostname verify చేయాలి. TLS error వస్తే certificate trust check చేయాలి.",en:"For unauthorized errors, verify credentials and repository permissions. For missing images, confirm the registry path and tag. For TLS failures, inspect certificate validity and trust configuration.",commands:["docker login registry.example.com","docker image inspect registry.example.com/team/api:v1","docker pull registry.example.com/team/api:v1","docker logout registry.example.com"]},
{title:"Registry Best Practices",te:"Versioned tags ఉపయోగించాలి. Production image digest pin చేయాలి. Old images కు retention policy ఉండాలి. CI pipeline లో image scan మరియు approval steps పెట్టాలి.",en:"Use meaningful version tags, pin production deployments to digests where appropriate, configure retention policies, and scan images before promoting them to production.",details:["Avoid relying on latest for production","Use immutable tags where supported","Apply retention and cleanup policies","Scan images before release"]},
{title:"Registry Security",te:"Registry కు HTTPS ఉపయోగించాలి. Access tokens లేదా IAM permissions ద్వారా access control చేయాలి. Credentials ను source code లో పెట్టకూడదు. Private repositories కు least privilege ఇవ్వాలి.",en:"Protect registry traffic with TLS, use scoped access tokens or IAM-based authentication, store credentials securely, and grant only the repository permissions each identity requires.",details:["Enforce TLS","Use short-lived or scoped credentials","Enable repository-level access control","Audit image pushes and pulls"]},
{title:"Registry Interview Points",te:"Docker Registry మరియు Docker Engine మధ్య తేడా explain చేయాలి. Registry images store చేస్తుంది; Engine containers run చేస్తుంది. Tag మరియు digest మధ్య తేడా కూడా చెప్పాలి.",en:"Explain that a registry stores and distributes images, while Docker Engine runs containers. Describe repositories, tags, manifests, layers, digests and authentication.",details:["Registry versus Docker daemon","Tag versus digest","Push and pull workflow","Private registry authentication"]},
{title:"Registry Related Concepts",te:"Docker Registry కు Docker Image, Dockerfile, CI/CD pipeline, image scanning, image signing మరియు Kubernetes imagePullSecrets సంబంధం కలిగి ఉంటాయి.",en:"Related concepts include Docker images, Dockerfiles, CI/CD pipelines, image scanning and signing, Kubernetes imagePullSecrets and cloud container registries.",details:["Docker Image","Dockerfile","CI/CD Pipeline","Image Scanning","Kubernetes imagePullSecrets","Amazon ECR"]}
]),

"Docker Volume": sections("Docker Volume", [
{title:"Volume Purpose",te:"Docker Volume container data ను container lifecycle నుంచి వేరుగా persist చేయడానికి ఉపయోగిస్తారు. Container remove చేసినా volume లోని data సాధారణంగా అలాగే ఉంటుంది.",en:"Docker volumes persist container data independently of a container's writable layer. They are useful for databases, uploads and application state that must survive container replacement.",details:["Persistent container data","Data reuse across containers","Docker-managed storage"]},
{title:"Volume Operation",te:"Docker Engine volume create చేసి host storage లో manage చేస్తుంది. Container run చేసేటప్పుడు volume ను mount path కు attach చేస్తారు. Application ఆ path లో data write చేస్తుంది.",en:"Docker creates and manages a volume, then mounts it into a container at a specified path. The application reads and writes data through that mount point.",details:["Volume creation","Mount into container","Application writes data","Data remains after container removal"]},
{title:"Database Project Example",te:"Production database container లో database files ను named volume లో store చేయవచ్చు. Container recreate చేసినప్పుడు అదే volume attach చేస్తే data కొనసాగుతుంది.",en:"A database container can store its data directory in a named volume. Replacing the container while reusing the volume allows the database files to persist.",example:"docker volume create postgres_data\ndocker run -d --name postgres -v postgres_data:/var/lib/postgresql/data -e POSTGRES_PASSWORD=change-me postgres:16"},
{title:"Volume Components",te:"Volume name, Docker storage driver, host-side storage location మరియు container mount destination ప్రధాన భాగాలు. Container లో mount path application కు కనిపిస్తుంది.",en:"A volume has a name, is managed by Docker through a volume driver, and is mounted at a destination path inside the container.",details:["Volume name","Volume driver","Host-side data location","Container mount destination"]},
{title:"Volume Workflow",te:"ముందుగా named volume create చేయాలి. Container కు mount చేయాలి. Application data write చేసిన తర్వాత container remove చేసి కొత్త container లో అదే volume mount చేసి persistence verify చేయాలి.",en:"Create a named volume, mount it into the application container, write test data, replace the container, and confirm that the data remains available.",commands:["docker volume create app_data","docker volume ls","docker run -d --name app -v app_data:/data nginx","docker inspect app","docker volume inspect app_data"]},
{title:"Volume Commands",te:"Volumes list, inspect, create మరియు remove చేయడానికి docker volume commands ఉపయోగిస్తారు. Data delete అయ్యే అవకాశం ఉన్నందున prune command జాగ్రత్తగా వాడాలి.",en:"Use Docker volume commands to create, list, inspect and remove volumes. Review attached containers and backups before deleting persistent data.",commands:["docker volume create app_data","docker volume ls","docker volume inspect app_data","docker volume rm app_data","docker volume prune"]},
{title:"Volume Mount Configuration",te:"Docker run లో -v లేదా --mount option తో volume mount చేయవచ్చు. Compose లో volumes section ద్వారా named volume define చేసి service కు attach చేయవచ్చు.",en:"Volumes can be mounted with docker run options or declared in Docker Compose. Named volumes should be defined explicitly for persistent services.",example:"services:\n  database:\n    image: postgres:16\n    volumes:\n      - database_data:/var/lib/postgresql/data\nvolumes:\n  database_data:"},
{title:"Volume Mistakes",te:"Container లో wrong destination mount చేయడం, anonymous volumes ఉపయోగించి వాటి names మర్చిపోవడం, backup లేకుండా volume delete చేయడం సాధారణ తప్పులు.",en:"Common mistakes include mounting to the wrong application path, losing track of anonymous volumes, deleting data without backups and assuming a volume automatically provides database consistency.",details:["Verify the container mount destination","Use named volumes for important data","Do not treat a volume as a backup"]},
{title:"Volume Troubleshooting",te:"Data కనిపించకపోతే docker inspect ద్వారా Mounts check చేయాలి. Permissions, mount destination మరియు application data directory పరిశీలించాలి.",en:"If data is missing, inspect the container mounts, verify the volume name and destination, and check filesystem ownership and application directory settings.",commands:["docker inspect <container>","docker volume inspect <volume>","docker exec <container> ls -la <mount-path>","docker logs <container>"]},
{title:"Volume Best Practices",te:"Important data కోసం named volumes ఉపయోగించాలి. Regular backups మరియు restore tests చేయాలి. Database consistency కోసం application-aware backup విధానం ఉపయోగించాలి.",en:"Use named volumes for important data, schedule backups, test restores, monitor storage capacity and use application-aware backup methods for databases.",details:["Use explicit volume names","Back up persistent data","Test restore procedures","Monitor disk usage"]},
{title:"Volume Security",te:"Volume permissions ను restrict చేయాలి. Sensitive data కు host access control అమలు చేయాలి. అవసరం లేని containers కు volume attach చేయకూడదు.",en:"Restrict host and container access to sensitive volumes. Avoid mounting secrets or database files into unrelated containers, and protect backups with encryption and access controls.",details:["Apply least privilege","Protect host storage paths","Encrypt sensitive backups","Avoid unnecessary shared mounts"]},
{title:"Volume Interview Points",te:"Docker Volume ఎందుకు అవసరం, container writable layer తో దాని తేడా, named volume ఎలా create చేయాలి, container delete చేసిన తర్వాత data ఎలా persist అవుతుంది explain చేయాలి.",en:"Explain volume persistence, named versus anonymous volumes, volume mounts, backup requirements and the difference between volumes and bind mounts.",details:["Container lifecycle independence","Named and anonymous volumes","Volume backup and restore","Volume versus bind mount"]},
{title:"Volume Related Concepts",te:"Docker Volume కు Docker Container, bind mount, storage driver, Docker Compose మరియు database persistence సంబంధం కలిగి ఉంటాయి.",en:"Related concepts include containers, bind mounts, storage drivers, Docker Compose and database persistence.",details:["Docker Container","Docker Bind Mount","Docker Compose","Storage Driver"]}
]),

"Docker Bind Mount": sections("Docker Bind Mount", [
{title:"Bind Mount Purpose",te:"Host machine లో ఉన్న specific directory లేదా file ను container లో access చేయడానికి bind mount ఉపయోగిస్తారు. Development సమయంలో source code changes container లో కనిపించడానికి ఇది ఉపయోగపడుతుంది.",en:"A bind mount exposes a specific host file or directory inside a container. It is commonly used for development workflows and controlled access to host files.",details:["Share host files with containers","Support local development","Expose selected configuration files"]},
{title:"Bind Mount Operation",te:"Docker host path ను container destination కు mount చేస్తుంది. Container లో ఆ path పై చేసే changes host directory లో కూడా reflect అవుతాయి.",en:"Docker maps a host path to a path inside the container. Both environments access the same underlying files, subject to mount permissions and filesystem behaviour.",details:["Host source path","Container destination path","Read-write or read-only mount mode"]},
{title:"Development Example",te:"Developer local source code ను container లో mount చేసి application run చేయవచ్చు. Code edit చేసినప్పుడు container లో updated files కనిపిస్తాయి.",en:"A developer mounts a local application directory into a development container. Code changes on the host become visible inside the container without rebuilding the image for every edit.",example:"docker run --rm -it --mount type=bind,source=\"$PWD\",target=/app node:22"},
{title:"Bind Mount Components",te:"Bind mount లో host source path, container target path మరియు mount mode ఉంటాయి. Source path తప్పుగా ఉంటే container లో unexpected directory కనిపించవచ్చు.",en:"A bind mount consists of a host source path, a container destination path and access mode such as read-write or read-only.",details:["Host source","Container target","Read-write or read-only mode","Host filesystem permissions"]},
{title:"Bind Mount Workflow",te:"Host directory ఉందో check చేసి container కు mount చేయాలి. Container లో file visibility verify చేయాలి. అవసరమైతే read-only mode తో mount చేయాలి.",en:"Confirm the host path exists, mount it to the intended container path, inspect the mount configuration, and verify file access from inside the container.",commands:["pwd","ls -la","docker run --rm --mount type=bind,source=\"$PWD\",target=/app alpine ls -la /app","docker inspect <container>"]},
{title:"Bind Mount Commands",te:"--mount syntax bind mounts కు clear configuration ఇస్తుంది. Read-only mount కోసం readonly option ఉపయోగించవచ్చు.",en:"The --mount option explicitly defines bind mounts. Use readonly when the container only needs to read host files.",commands:["docker run --rm --mount type=bind,source=/opt/app,target=/app alpine ls /app","docker run --rm --mount type=bind,source=/opt/config,target=/config,readonly alpine ls /config","docker inspect <container>"]},
{title:"Bind Mount Configuration",te:"Docker Compose లో type bind, source మరియు target define చేయవచ్చు. Production configuration files ను అవసరమైనప్పుడు మాత్రమే read-only గా mount చేయాలి.",en:"Docker Compose can declare bind mounts with an explicit type, source and target. Use read-only mounts for configuration that containers should not modify.",example:"services:\n  web:\n    image: nginx:stable\n    volumes:\n      - type: bind\n        source: ./nginx.conf\n        target: /etc/nginx/nginx.conf\n        read_only: true"},
{title:"Bind Mount Mistakes",te:"Host path తప్పుగా ఇవ్వడం, read-only అవసరమైన చోట read-write ఇవ్వడం, host permissions మర్చిపోవడం మరియు sensitive host directories mount చేయడం ప్రమాదకరం.",en:"Common mistakes include incorrect source paths, excessive write access, host permission mismatches and mounting sensitive host directories into containers.",details:["Validate the source path","Avoid mounting the entire host filesystem","Use read-only access when possible"]},
{title:"Bind Mount Troubleshooting",te:"Container లో files కనిపించకపోతే source path, target path, Docker Desktop file-sharing permissions మరియు host filesystem permissions check చేయాలి.",en:"When files are missing or inaccessible, verify the source path, target path, host permissions and any platform-specific file-sharing restrictions.",commands:["docker inspect <container>","ls -ld <host-path>","docker exec <container> ls -la <container-path>","docker logs <container>"]},
{title:"Bind Mount Best Practices",te:"Development లో bind mounts ఉపయోగించాలి. Production లో అవసరం లేకపోతే avoid చేయాలి. Mount scope చిన్నదిగా ఉంచి read-only option ఉపయోగించాలి.",en:"Use bind mounts primarily for controlled host-file access and development workflows. Keep mount scope narrow and prefer read-only access when modification is unnecessary.",details:["Mount only required directories","Use read-only mounts","Document host path dependencies","Avoid host-specific paths in portable deployment definitions"]},
{title:"Bind Mount Security",te:"Host files container కు expose అవుతాయి కాబట్టి sensitive directories mount చేయకూడదు. Docker socket లేదా host system directories ను అవసరం లేకుండా mount చేయకూడదు.",en:"Bind mounts expose host filesystem content to containers. Never mount sensitive host directories or the Docker socket unless the security implications are explicitly understood.",details:["Restrict host directory permissions","Avoid mounting secrets into unrelated containers","Prefer read-only access","Review privileged host paths"]},
{title:"Bind Mount Interview Points",te:"Bind mount మరియు Docker Volume మధ్య తేడా చెప్పాలి. Bind mount host path ను ఉపయోగిస్తుంది; Docker Volume ను Docker manage చేస్తుంది.",en:"Explain that bind mounts use an explicit host path, while Docker volumes are managed by Docker. Discuss use cases, portability, permissions and security implications.",details:["Bind mount versus named volume","Read-only mount","Host path dependency","Development use case"]},
{title:"Bind Mount Related Concepts",te:"Bind mount కు Docker Volume, Docker Compose, container filesystem మరియు host permissions సంబంధం కలిగి ఉంటాయి.",en:"Related concepts include Docker volumes, Compose mount declarations, container filesystems and Linux filesystem permissions.",details:["Docker Volume","Docker Compose","Container filesystem","Linux permissions"]}
]),

"Docker Network": sections("Docker Network", [
{title:"Network Purpose",te:"Docker Network containers మధ్య మరియు అవసరమైనప్పుడు external systems తో communication కోసం ఉపయోగిస్తారు. Application tiers ను network ద్వారా connect చేయవచ్చు.",en:"Docker networks provide connectivity between containers and, where required, external systems. They allow application components to communicate through defined network boundaries.",details:["Container-to-container communication","Network isolation","Service discovery"]},
{title:"Network Operation",te:"Docker network create చేసినప్పుడు containers కు network interfaces మరియు addressing అందిస్తుంది. User-defined bridge network లో containers names ద్వారా communicate చేయగలవు.",en:"Docker attaches containers to networks and provides connectivity through the selected driver. User-defined bridge networks support container-name-based service discovery.",details:["Network driver","Container endpoint","IP addressing","DNS-based service discovery on user-defined networks"]},
{title:"Three-Tier Application Example",te:"Web container మరియు API container ఒక application network లో ఉంటాయి. Database container ను వేరే internal network లో ఉంచి అవసరమైన services కు మాత్రమే access ఇవ్వవచ్చు.",en:"A three-tier application can connect the web and API services on an application network while keeping the database on a restricted internal network.",example:"docker network create app-net\ndocker run -d --name api --network app-net nginx:stable\ndocker run --rm --network app-net busybox nslookup api"},
{title:"Network Components",te:"Docker network drivers, bridge interfaces, container endpoints, IP addresses, DNS మరియు port publishing networking లో ప్రధాన భాగాలు.",en:"Docker networking includes drivers, virtual bridges, container endpoints, IP addressing, embedded DNS and host port publishing.",details:["Bridge driver","Host driver","Overlay driver","Container endpoint","Published host ports"]},
{title:"Network Workflow",te:"ముందుగా అవసరమైన network create చేయాలి. Containers ను attach చేసి name resolution test చేయాలి. తర్వాత అవసరమైన host ports మాత్రమే publish చేయాలి.",en:"Create the required network, attach services, verify name resolution and connectivity, and publish only the ports that must be reachable from outside the host.",commands:["docker network create app-net","docker network ls","docker network connect app-net api","docker network inspect app-net","docker exec api getent hosts database"]},
{title:"Network Commands",te:"Network list, inspect, create, connect మరియు disconnect commands ద్వారా container connectivity manage చేయవచ్చు.",en:"Use Docker network commands to create networks, inspect endpoints, connect or disconnect containers, and remove unused networks.",commands:["docker network ls","docker network create app-net","docker network inspect app-net","docker network connect app-net api","docker network disconnect app-net api"]},
{title:"Network Configuration",te:"Docker Compose లో services కు networks define చేసి అవసరమైన network కు attach చేయవచ్చు. Internal network తో external access తగ్గించవచ్చు.",en:"Compose allows services to join named networks. An internal network can restrict external connectivity for backend components.",example:"services:\n  api:\n    image: nginx:stable\n    networks: [frontend, backend]\n  database:\n    image: postgres:16\n    networks: [backend]\nnetworks:\n  frontend: {}\n  backend:\n    internal: true"},
{title:"Network Mistakes",te:"Containers ను different networks లో ఉంచి communication ఆశించడం, wrong port publish చేయడం, localhost ను container-to-container address గా ఉపయోగించడం సాధారణ తప్పులు.",en:"Common mistakes include placing services on unrelated networks, publishing the wrong port, and using localhost when a container should connect to another service by its network name.",details:["Use service DNS names between containers","Distinguish container ports from host ports","Check network membership"]},
{title:"Network Troubleshooting",te:"Connectivity fail అయితే network inspect, container inspect, DNS resolution మరియు listening ports check చేయాలి. Application bind address కూడా పరిశీలించాలి.",en:"Investigate connectivity by inspecting network membership, resolving service names, checking listening ports and verifying that the application listens on the expected interface.",commands:["docker network inspect app-net","docker inspect <container>","docker exec <container> getent hosts <service-name>","docker exec <container> ss -lnt"]},
{title:"Network Best Practices",te:"Application tiers ను అవసరానికి అనుగుణంగా separate networks లో ఉంచాలి. అవసరమైన ports మాత్రమే publish చేయాలి. Network configuration ను version control లో ఉంచాలి.",en:"Separate application tiers where appropriate, publish only required ports, use meaningful network names and maintain repeatable network configuration.",details:["Minimize published ports","Use user-defined networks","Separate sensitive backend services","Document network dependencies"]},
{title:"Network Security",te:"Database వంటి sensitive services కు public port publish చేయకూడదు. Internal networks, firewall rules మరియు least-privilege connectivity ఉపయోగించాలి.",en:"Avoid exposing sensitive services such as databases directly to public interfaces. Use internal networks, host firewalls and narrowly scoped connectivity.",details:["Do not publish database ports unnecessarily","Restrict host ingress","Separate trusted and untrusted services","Review network access during deployments"]},
{title:"Network Interview Points",te:"Bridge, host మరియు overlay drivers మధ్య తేడా వివరించాలి. Container DNS ఎలా పనిచేస్తుంది, port publishing ఏం చేస్తుంది అనే విషయాలు explain చేయాలి.",en:"Explain bridge, host and overlay network drivers, container DNS, port publishing and how network isolation supports application architecture.",details:["Bridge versus host networking","Overlay networking","Container DNS","Port mapping"]},
{title:"Network Related Concepts",te:"Docker Network కు Docker Compose, container ports, DNS, firewall, Kubernetes Service మరియు ingress concepts సంబంధం కలిగి ఉంటాయి.",en:"Related concepts include Docker Compose, ports, DNS, firewalls, Kubernetes Services and ingress networking.",details:["Docker Compose","DNS","Port mapping","Kubernetes Service","Ingress"]}
]),

"Docker Compose": sections("Docker Compose", [
{title:"Compose Purpose",te:"Docker Compose ద్వారా multiple related containers ను ఒక YAML file లో define చేసి ఒకే workflow తో manage చేయవచ్చు. Local development మరియు multi-container applications కు ఉపయోగపడుతుంది.",en:"Docker Compose defines and manages multi-container applications using a declarative YAML file. It simplifies local development, testing and repeatable application environments.",details:["Define multiple services","Manage networks and volumes","Repeatable application startup"]},
{title:"Compose Operation",te:"Compose YAML లో services, images, ports, volumes, networks మరియు environment values define చేస్తారు. Compose ఆ definitions ఆధారంగా containers మరియు supporting resources create చేస్తుంది.",en:"Compose reads the project YAML, resolves service dependencies and creates the required containers, networks and volumes. It can recreate services when configuration changes.",details:["Compose file parsing","Service configuration","Network and volume creation","Container lifecycle management"]},
{title:"Application Stack Example",te:"Developer web application మరియు database ను compose file లో define చేసి local environment లో start చేయవచ్చు. Production deployment కు ముందు configuration review చేయాలి.",en:"A development team can define a web service and database in one Compose project, allowing engineers to start a consistent application stack with a single command.",example:"services:\n  web:\n    image: nginx:stable\n    ports:\n      - \"8080:80\"\n  cache:\n    image: redis:7\n"},
{title:"Compose Components",te:"Compose project లో services, networks, volumes, configs, secrets మరియు environment configuration ఉంటాయి. ప్రతి service ఒక container లేదా related container workload ను represent చేస్తుంది.",en:"Compose files define services and may also define networks, volumes, configs and secrets. Each service describes how a containerized component should run.",details:["Services","Networks","Volumes","Environment variables","Health checks","Dependency conditions"]},
{title:"Compose Workflow",te:"Compose YAML create చేసి config validate చేయాలి. తర్వాత up command తో stack start చేసి ps, logs మరియు application health verify చేయాలి. పని పూర్తయిన తర్వాత down ఉపయోగించవచ్చు.",en:"Create and validate the Compose file, start the project, inspect service state, review logs and test application behaviour. Stop and remove project resources when appropriate.",commands:["docker compose config","docker compose up -d","docker compose ps","docker compose logs -f","docker compose down"]},
{title:"Compose Commands",te:"Compose commands తో services start, stop, rebuild, logs మరియు status manage చేయవచ్చు.",en:"These commands manage the lifecycle of a Compose project and help diagnose service failures.",commands:["docker compose up -d","docker compose ps","docker compose logs web","docker compose restart web","docker compose build","docker compose down"]},
{title:"Compose YAML Example",te:"Compose file లో image, ports, environment, volumes మరియు healthcheck define చేయవచ్చు. Secrets మరియు passwords ను plain text లో commit చేయకూడదు.",en:"A Compose service can define its image, published ports, environment, mounts and health check. Protect credentials and avoid committing real secrets to source control.",example:"services:\n  web:\n    image: nginx:stable\n    ports:\n      - \"8080:80\"\n    healthcheck:\n      test: [\"CMD\", \"nginx\", \"-t\"]\n      interval: 30s\n      timeout: 5s\n      retries: 3"},
{title:"Compose Mistakes",te:"YAML indentation తప్పు, wrong service name, port conflict, missing environment variable మరియు dependency readiness ను పట్టించుకోకపోవడం సాధారణ తప్పులు.",en:"Common problems include invalid YAML indentation, incorrect service references, host port conflicts, missing variables and assuming that service startup means application readiness.",details:["Validate YAML before startup","Check host port availability","Use health checks for readiness"]},
{title:"Compose Troubleshooting",te:"Service start కాకపోతే compose ps మరియు logs పరిశీలించాలి. Configuration render చేసి ports, mounts, environment values మరియు health status verify చేయాలి.",en:"When a service fails, inspect project state and logs, render the effective configuration, and check port bindings, mounts, environment variables and health checks.",commands:["docker compose config","docker compose ps -a","docker compose logs --tail=100","docker compose exec web sh","docker compose events"]},
{title:"Compose Best Practices",te:"Compose file ను version control లో ఉంచాలి. Environment-specific overrides వాడాలి. Health checks, named volumes మరియు fixed image versions ఉపయోగించాలి.",en:"Keep Compose definitions in version control, separate environment-specific settings, define health checks, use named volumes for persistent data and pin tested image versions.",details:["Use explicit image tags","Keep secrets out of Git","Add health checks","Document startup dependencies"]},
{title:"Compose Security",te:"Containers కు అవసరమైన permissions మాత్రమే ఇవ్వాలి. Secrets ను protect చేయాలి. Privileged mode avoid చేయాలి. Unnecessary ports publish చేయకూడదు.",en:"Apply least privilege to Compose services, protect secrets, avoid privileged containers and publish only the ports required by the application.",details:["Avoid privileged mode unless required","Use read-only filesystems where possible","Restrict published ports","Protect environment secrets"]},
{title:"Compose Interview Points",te:"Docker Compose ఎందుకు ఉపయోగిస్తారు, Compose file లో services ఎలా define చేస్తారు, up మరియు down commands మధ్య తేడా ఏమిటి explain చేయాలి.",en:"Explain how Compose defines multi-container applications, how services share networks and volumes, and how common lifecycle commands operate.",details:["Compose versus Docker CLI","Service dependencies","Networks and volumes","Compose troubleshooting"]},
{title:"Compose Related Concepts",te:"Docker Compose కు Docker Engine, Dockerfile, Docker Image, Docker Network, Docker Volume మరియు container orchestration సంబంధం కలిగి ఉంటాయి.",en:"Related concepts include Docker Engine, Dockerfiles, images, networks, volumes and container orchestration platforms such as Kubernetes.",details:["Docker Engine","Dockerfile","Docker Image","Docker Network","Docker Volume","Kubernetes"]}
]),

"Multi-stage Build": sections("Multi-stage Build", [
{title:"Multi-stage Build Purpose",te:"Multi-stage Docker build ద్వారా build tools మరియు dependencies ఉన్న build environment ను final runtime image నుంచి వేరు చేయవచ్చు. దీనివల్ల final image size మరియు attack surface తగ్గుతాయి.",en:"Multi-stage builds use multiple stages in one Dockerfile so build tools and intermediate files can be excluded from the final runtime image.",details:["Smaller runtime images","Separate build and runtime dependencies","Reduce unnecessary packages"]},
{title:"Multi-stage Operation",te:"Dockerfile లో multiple FROM instructions ఉంటాయి. ఒక stage లో application build చేసి, మరో final stage లో అవసరమైన artifacts మాత్రమే COPY చేస్తారు.",en:"Each FROM instruction starts a new build stage. A later stage can copy selected artifacts from an earlier stage while leaving compilers and temporary files behind.",details:["Builder stage","Artifact generation","Final runtime stage","Selective COPY --from"]},
{title:"Java Application Example",te:"Java application ను Maven builder stage లో package చేసి, final stage లో JRE మరియు generated JAR మాత్రమే ఉంచవచ్చు.",en:"A Java service can be compiled in a Maven builder stage, then copied into a smaller runtime stage containing only the required Java runtime and application artifact.",example:"FROM maven:3.9-eclipse-temurin-21 AS build\nWORKDIR /app\nCOPY pom.xml .\nCOPY src ./src\nRUN mvn -DskipTests package\n\nFROM eclipse-temurin:21-jre\nWORKDIR /app\nCOPY --from=build /app/target/*.jar app.jar\nENTRYPOINT [\"java\", \"-jar\", \"app.jar\"]"},
{title:"Build Components",te:"Multi-stage build లో builder image, build commands, intermediate artifacts, final base image మరియు COPY --from instruction ఉంటాయి.",en:"The key components are the builder stage, build dependencies, generated artifacts, final runtime base image and cross-stage COPY instructions.",details:["Named build stage","Build dependencies","Generated artifact","Runtime base image","COPY --from"]},
{title:"Multi-stage Workflow",te:"ముందుగా builder stage లో source copy చేసి dependencies install చేయాలి. Application build తర్వాత final stage కు required artifact మాత్రమే copy చేయాలి. Final image test చేయాలి.",en:"Prepare the builder stage, install build dependencies, compile the application, copy only required artifacts into the runtime stage, and test the final image.",commands:["docker build -t payments-api:latest .","docker image inspect payments-api:latest","docker history payments-api:latest","docker run --rm payments-api:latest"]},
{title:"Build Commands",te:"BuildKit output తో image build చేయవచ్చు. Build logs, image size మరియు image history inspect చేయాలి.",en:"Use Docker build commands to build, inspect and compare images. BuildKit can improve build performance through caching and parallel execution.",commands:["DOCKER_BUILDKIT=1 docker build -t app:latest .","docker build --target build -t app-builder .","docker image ls","docker history app:latest"]},
{title:"Multi-stage Dockerfile",te:"ప్రతి stage కు meaningful name ఇవ్వాలి. Final stage లో runtime కు అవసరమైన files మాత్రమే copy చేయాలి.",en:"Name stages explicitly and copy only the artifacts required at runtime. Use a suitable runtime base image and keep build-only dependencies out of the final stage.",example:"FROM node:22 AS build\nWORKDIR /app\nCOPY package*.json ./\nRUN npm ci\nCOPY . .\nRUN npm run build\n\nFROM node:22-alpine AS runtime\nWORKDIR /app\nCOPY --from=build /app/package*.json ./\nCOPY --from=build /app/.next ./.next\nCMD [\"npm\", \"start\"]"},
{title:"Multi-stage Mistakes",te:"Wrong stage name, incorrect artifact path, runtime dependencies copy చేయకపోవడం మరియు builder లో ఉన్న files final stage లో ఉంటాయని assume చేయడం సాధారణ తప్పులు.",en:"Common mistakes include incorrect stage names, wrong artifact paths, missing runtime dependencies and assuming that files from the builder stage automatically exist in the final image.",details:["Verify COPY --from source paths","Include required runtime libraries","Test the final stage independently"]},
{title:"Multi-stage Troubleshooting",te:"Build fail అయితే stage-specific logs పరిశీలించాలి. Artifact path, build output మరియు final image లో required files ఉన్నాయో verify చేయాలి.",en:"Troubleshoot by identifying the failing stage, reviewing its logs, checking artifact paths and inspecting the final image filesystem and runtime dependencies.",commands:["docker build --progress=plain -t app:test .","docker build --target build -t app:builder .","docker run --rm --entrypoint sh app:test","docker history app:test"]},
{title:"Multi-stage Best Practices",te:"Build cache ఉపయోగించాలి. Dependency files ముందుగా copy చేయాలి. Final image ను చిన్నదిగా ఉంచాలి. Production image ను vulnerability scan చేయాలి.",en:"Optimize build caching by copying dependency manifests before source files, use trusted base images, keep the final stage minimal and scan the released image.",details:["Use named stages","Use .dockerignore","Pin base image versions or digests","Scan final images"]},
{title:"Multi-stage Security",te:"Build tools, source credentials మరియు temporary secrets final image లో ఉండకూడదు. Build secrets ను secure BuildKit secret mounts ద్వారా అందించాలి.",en:"Keep build credentials and temporary secrets out of image layers. Use BuildKit secret mounts, trusted base images and security scanning for the final runtime image.",details:["Do not pass secrets through ARG or ENV","Use BuildKit secret mounts","Avoid copying build caches into runtime","Scan the final image"]},
{title:"Multi-stage Interview Points",te:"Multi-stage build ఎందుకు అవసరం, multiple FROM instructions ఎలా పని చేస్తాయి, COPY --from ఉపయోగం ఏమిటి, final image size మరియు security పై ప్రభావం ఏమిటి explain చేయాలి.",en:"Explain how multiple build stages separate compilation from runtime, how COPY --from transfers artifacts, and how this reduces image size and unnecessary attack surface.",details:["Single-stage versus multi-stage build","Builder and runtime stages","Build cache","Artifact copying"]},
{title:"Multi-stage Related Concepts",te:"Multi-stage build కు Dockerfile, Docker Image, build cache, BuildKit, image scanning మరియు container security సంబంధం కలిగి ఉంటాయి.",en:"Related concepts include Dockerfiles, images, build cache, BuildKit, image scanning and container security.",details:["Dockerfile","Docker Image","BuildKit","Docker Registry","Image Scanning"]}
])
};
