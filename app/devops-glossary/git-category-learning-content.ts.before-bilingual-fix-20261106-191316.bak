r("Branch ki Commit, Merge, Rebase, Pull Request, Clone, Fork and Git Tag sambandham kaligi untayi.", "Related concepts include commits, merge, rebase, pull requests, clone, fork and Git tags.")
]),

"Merge": makeSections("Merge", [
r("Merge two development histories ni combine chestundi. Feature branch changes ni main branch ki integrate cheyyadaniki use chestaru. Existing commits preserve chestu fast-forward or merge commit create cheyyavachchu.", "Merge combines development histories. It integrates feature work into a target branch and may fast-forward the branch or create a merge commit."),
r("Target branch checkout chesi source branch merge chestaru. Histories compatible ayithe fast-forward possible. Divergent histories unte Git merge commit create chestundi; conflicting files manual resolution require cheyyavachchu.", "Switch to the target branch and merge the source branch. Git may fast-forward or create a merge commit. Conflicting changes require manual resolution."),
r("Feature team payment module develop chestundi. Pull request approval and CI checks complete ayyaka feature branch main lo merge avutundi. Deployment pipeline main branch update ni process chestundi.", "After review and CI checks, a payment feature branch is merged into main. The resulting main-branch commit can trigger the release pipeline.", ["git switch main", "git pull --ff-only origin main", "git merge --no-ff feature/payment", "git push origin main"]),
r("Merge operation source and target commit histories inspect chestundi. Fast-forward merge pointer move chestundi. Three-way merge common ancestor use chesi combined result create chestundi.", "A fast-forward merge moves the target reference forward. A three-way merge uses the common ancestor and both branch tips to create a combined result."),
r("Target branch latest changes fetch cheyyali. Target branch checkout chesi source branch merge cheyyali. Conflicts unte resolve chesi tests run cheyyali. Merge commit push cheyyali.", "Fetch updates, check out the target branch, merge the source branch, resolve conflicts if needed, run tests and push the integrated result."),
r("Merge history and conflict state inspect cheyyadaniki commands use cheyyali.", "Use Git commands to perform merges and inspect their results.", ["git fetch origin", "git switch main", "git merge feature/login", "git status", "git log --oneline --graph --all"]),
r("Team policy batti merge commit, squash merge or rebase merge choose cheyyavachchu. Pull request platform lo allowed merge methods configure cheyyali.", "Teams can choose merge commits, squash merges or rebase merges according to their history policy. Configure allowed merge methods in the hosting platform.", undefined, "git merge --no-ff feature/login\n\n# Abort an unresolved merge\n git merge --abort"),
r("Wrong target branch merge cheyyadam, tests run cheyyakunda merge cheyyadam, conflict markers commit cheyyadam and shared history force rewrite cheyyadam mistakes.", "Common mistakes include merging into the wrong branch, skipping tests, committing conflict markers and rewriting shared history carelessly."),
r("Merge conflict ayithe git status lo affected files identify cheyyali. Conflict markers resolve chesi staged files inspect cheyyali. Merge complete cheyyadaniki commit create cheyyali.", "For merge conflicts, inspect affected files, resolve conflict markers, stage the resolved files and complete the merge with a commit.", ["git status", "git diff", "git diff --check", "git add <resolved-file>", "git commit"]),
r("Merge mundu latest target branch update cheyyali. Small pull requests and automated checks use cheyyali. Conflict resolution review chesi tests rerun cheyyali.", "Update the target branch before integration, keep pull requests focused, require automated checks and review conflict resolutions before completing the merge."),
r("Merge permissions branch protection tho restrict cheyyali. CI checks and reviewer approval require cheyyali. Merge pipeline lo secrets or untrusted code exposure prevent cheyyali.", "Use branch protection, reviewer approval and required checks. Ensure merge-triggered workflows do not expose privileged secrets to untrusted code."),
r("Fast-forward versus three-way merge, merge commit, squash merge, conflict resolution and merge abort explain cheyyali.", "Explain fast-forward and three-way merges, merge commits, squash merges, conflict resolution and merge abort."),
r("Merge ki Branch, Commit, Rebase, Pull Request, Merge Conflict and GitOps sambandham kaligi untayi.", "Related concepts include branches, commits, rebase, pull requests, merge conflicts and GitOps.")
]),

"Rebase": makeSections("Rebase", [
r("Rebase current branch commits ni new base commit meeda replay chestundi. Feature branch history ni updated main branch meeda linear ga maintain cheyyadaniki use chestaru.", "Rebase replays commits from one branch onto a new base. It can produce a linear history for feature branches."),
r("Git common ancestor nunchi feature commits identify chestundi. Target base meeda commits one by one replay chestundi. Replay conflict ayithe developer resolve chesi rebase continue cheyyali.", "Git identifies commits to replay and applies them onto the new base one at a time. Conflicts pause the operation until they are resolved."),
r("Developer feature branch lo work chestunnappudu main branch update avutundi. Feature branch ni main meeda rebase chesi conflicts resolve chestadu; tests pass ayyaka pull request update chestadu.", "When main advances, a developer rebases a private feature branch onto the latest main, resolves conflicts and updates the pull request."),
r("Rebase commit history rewrite chestundi. Replayed commits ki new commit IDs generate avutayi. Interactive rebase lo commits reorder, squash, edit or drop cheyyavachchu.", "Rebase rewrites commit history by creating new commit IDs for replayed commits. Interactive rebase can reorder, squash, edit or drop commits."),
r("Feature branch checkout chesi latest main fetch cheyyali. Rebase run chesi conflicts resolve cheyyali. Tests run chesi branch push cheyyali; previously pushed branch ki safe force-with-lease avasaram avvachu.", "Check out the feature branch, fetch main, rebase onto it, resolve conflicts, test and update the remote branch carefully if history changed."),
r("Rebase status and progress inspect cheyyali. Conflict resolution tarvata continue cheyyavachchu; incorrect operation ayithe abort cheyyavachchu.", "Git provides commands to perform and inspect rebase operations and continue or abort after conflicts.", ["git fetch origin", "git switch feature/login", "git rebase origin/main", "git status", "git rebase --continue", "git rebase --abort"]),
r("Interactive rebase lo pick, reword, edit, squash and drop commands use cheyyavachchu. Shared branch history rewrite cheyyakunda private feature branch lo matrame use cheyyali.", "Interactive rebase supports actions such as pick, reword, edit, squash and drop. It is best suited to private or coordinated branch history."),
r("Already shared commits ni team coordination lekunda rebase cheyyadam, force push careless ga use cheyyadam and conflicts resolve cheyyakunda continue cheyyadam common mistakes.", "Common mistakes include rebasing shared history without coordination, careless force pushes and continuing before resolving conflicts."),
r("Rebase stuck ayithe git status and conflict files inspect cheyyali. Wrong changes ayithe rebase --abort use cheyyali. Push rejected ayithe remote history and force-with-lease safety verify cheyyali.", "If rebase pauses, inspect status and resolve conflicts. Abort when necessary. If pushing rewritten history, inspect remote changes and use force-with-lease rather than blind force."),
r("Private feature branches lo rebase use cheyyali. Rebase mundu working tree clean ga undali. Team shared branch policies follow avvali and tests rerun cheyyali.", "Use rebase mainly on private feature branches, start with a clean working tree, follow team history policies and rerun tests after replaying commits."),
r("Rebase process lo credentials or sensitive content commit history lo undakunda check cheyyali. Force updates ki protected branch restrictions respect cheyyali.", "Check that rewritten commits do not contain secrets. Respect protected-branch rules and coordinate any required force updates with collaborators."),
r("Merge and rebase difference, rewritten commit IDs, interactive rebase, rebase continue and abort, force-with-lease explain cheyyali.", "Explain merge versus rebase, rewritten commit IDs, interactive rebase, continue and abort operations, and safe force updates."),
r("Rebase ki Branch, Commit, Merge, Pull Request, Merge Conflict and Git history sambandham kaligi untayi.", "Related concepts include branches, commits, merge, pull requests, merge conflicts and Git history.")
]),

"Pull Request": makeSections("Pull Request", [
r("Pull Request proposed code changes ni review and merge cheyyadaniki collaboration mechanism. Developers changes explain chesi reviewers feedback pondi automated checks pass ayyaka target branch lo integrate chestaru.", "A pull request proposes changes for review before integration into a target branch. It supports discussion, approval and automated validation."),
r("Developer branch push chesi pull request open chestadu. Platform changed files and commits display chestundi. Review comments, CI checks and approvals complete ayyaka allowed merge method tho changes integrate avutayi.", "A developer pushes a branch and opens a pull request. Reviewers inspect commits and diffs, CI runs checks, and approved changes are merged."),
r("Production bug fix branch create chesi tests add chestaru. Pull request lo issue reference, root cause and test evidence include chestaru. Review and checks pass ayyaka main branch merge chestaru.", "A production bug fix is submitted through a pull request containing the issue reference, explanation and test evidence. Review and required checks gate merging."),
r("Pull request lo source branch, target branch, commits, diff, reviewers, comments, status checks, approvals and merge strategy untayi.", "A pull request includes source and target branches, commits, file differences, reviewers, comments, status checks, approvals and a merge method."),
r("Feature branch push cheyyali. Pull request create chesi title and description add cheyyali. Reviewers assign chesi feedback address cheyyali. Required CI checks pass ayyaka merge cheyyali.", "Push a feature branch, open a pull request, describe the change, request reviewers, address feedback and merge only after required checks pass."),
r("Pull request status hosting platform UI or CLI dwara inspect cheyyavachchu. Local Git commands changed files and commits inspect cheyyadaniki help chestayi.", "Use the hosting platform to inspect review and check status, and Git commands to inspect the local branch and diff.", ["git status", "git diff origin/main...HEAD", "git log --oneline origin/main..HEAD", "git fetch origin"]),
r("Pull request template lo summary, motivation, implementation details, test plan and risk add cheyyavachchu. Branch protection lo approvals and status checks require cheyyavachchu.", "A pull-request template can request a summary, motivation, implementation details, test plan and risk assessment. Branch protection can require approvals and checks.", undefined, "## Summary\nDescribe the change.\n\n## Testing\n- Unit tests\n- Integration tests\n\n## Risk and rollback\nDescribe deployment impact and rollback plan."),
r("Large unrelated changes, vague descriptions, missing tests, reviewers assign cheyyakapovadam and failing checks ignore cheyyadam common mistakes.", "Common mistakes include oversized unrelated changes, vague descriptions, missing tests, no reviewers and ignoring failed checks."),
r("PR merge block ayithe required checks, review approvals and branch divergence inspect cheyyali. Conflict unte source branch update chesi conflicts resolve cheyyali.", "If merging is blocked, inspect required checks, approvals and branch divergence. Update the source branch and resolve conflicts when needed."),
r("Small PRs create cheyyali. Clear context and screenshots or logs where useful provide cheyyali. Automated tests and code owners use cheyyali. Review feedback respectful ga address cheyyali.", "Keep pull requests focused, provide clear context and useful evidence, use automated checks and code owners, and address reviewer feedback constructively."),
r("Untrusted pull request code ki production secrets expose avvakoodadu. Third-party action permissions and workflow triggers carefully review cheyyali.", "Do not expose production secrets to untrusted pull-request code. Carefully review workflow triggers, action permissions and fork-related execution."),
r("Pull request versus merge request terminology, reviewer, approval, status check, draft PR, base branch and compare branch explain cheyyali.", "Explain pull requests and merge requests, reviewers, approvals, status checks, draft pull requests and source versus target branches."),
r("Pull Request ki Branch, Commit, Merge, Rebase, GitHub Actions, Webhook and CI/CD Pipeline sambandham kaligi untayi.", "Related concepts include branches, commits, merge, rebase, GitHub Actions, webhooks and CI/CD pipelines.")
]),

"Clone": makeSections("Clone", [
r("Git clone remote repository complete working copy and history local machine ki download chestundi. Developers project start cheyyadaniki and remote tracking setup cheyyadaniki use chestaru.", "Git clone creates a local copy of a remote repository, including its history and remote-tracking configuration."),
r("Clone remote URL contact chesi repository objects and references download chestundi. Working tree checkout create chestundi. Usually origin ane remote default ga configure avutundi.", "Git contacts the remote URL, downloads repository data and checks out a working tree. The cloned remote is normally configured as origin."),
r("New developer company repository URL receive chesi clone command run chestadu. Project files local ga available avutayi; branch switch chesi development start chestadu.", "A new team member clones the project repository, obtains its files and history, then switches to the required development branch."),
r("Clone operation repository URL, remote refs, objects, working tree and local configuration create chestundi. Full clone history download chestundi; shallow clone limited history download cheyyavachchu.", "A clone establishes remote references, downloads Git objects and checks out files. A shallow clone limits the history depth."),
r("Repository URL verify chesi clone run cheyyali. Correct branch checkout chesi dependencies install and tests run cheyyali. Remote URL and branch status verify cheyyali.", "Verify the repository URL, clone it, check out the correct branch, install project dependencies and validate the setup."),
r("Clone and remote configuration inspect cheyyadaniki Git commands use cheyyali.", "Git commands help inspect repository origin, branch state and available remote references.", ["git clone https://github.com/example/project.git", "git remote -v", "git branch -a", "git status", "git log --oneline -5"]),
r("HTTPS or SSH URL use cheyyavachchu. Shallow clone kosam depth option use cheyyavachchu. Specific branch clone cheyyadaniki branch option specify cheyyavachchu.", "Clone can use HTTPS or SSH URLs. Shallow and single-branch options can reduce the downloaded history when appropriate.", undefined, "git clone --branch main --single-branch https://github.com/example/project.git\n\ngit clone --depth 1 https://github.com/example/project.git"),
r("Wrong URL, missing access, DNS issues, large history and submodule omission valla clone problems ravachchu.", "Common problems include incorrect URLs, missing permissions, network failures, large histories and forgetting to initialize submodules."),
r("Clone fail ayithe URL and network check cheyyali. Authentication error vaste credential method inspect cheyyali. Submodules missing ayithe recursive update run cheyyali.", "For clone failures, verify URL, network and credentials. If submodule content is missing, initialize and update the submodules.", ["git remote -v", "git ls-remote <repository-url>", "git submodule update --init --recursive", "git status"]),
r("SSH keys or credential manager use cheyyali. Required branch and history matrame shallow clone cheyyali. Production work kosam repository origin and branch verify cheyyali.", "Use SSH keys or a secure credential manager. Use shallow clones only when limited history is acceptable, and verify the origin and branch before making changes."),
r("Public and private repository access differences understand cheyyali. Credentials command history or scripts lo store cheyyakoodadu. SSH private keys secure ga protect cheyyali.", "Understand access requirements for public and private repositories. Never place credentials in command scripts, and protect private SSH keys."),
r("Clone versus fork, clone versus pull, origin remote, shallow clone and submodule initialization explain cheyyali.", "Explain clone versus fork, clone versus pull, the origin remote, shallow clones and submodule initialization."),
r("Clone ki Repository, Remote, Fork, Branch, Git Fetch and Git Pull sambandham kaligi untayi.", "Related concepts include repositories, remotes, forks, branches, fetch and pull.")
]),

"Fork": makeSections("Fork", [
r("Fork hosting platform lo original repository nunchi own account or organization ki separate repository copy create chestundi. External contributors original repository permissions lekunda changes propose cheyyadaniki use chestaru.", "A fork creates a separate repository under another user or organization account, allowing contributions without direct write access to the original repository."),
r("Contributor upstream repository fork chestadu. Own fork clone chesi branch create chestadu. Changes push chesi upstream project ki pull request open chestadu.", "A contributor forks the upstream repository, clones their fork, creates a branch, pushes changes and opens a pull request to the original project."),
r("Open-source contributor bug fix kosam project fork chestadu. Local changes test chesi own fork ki push chestadu. Upstream maintainers pull request review chesi accept chestaru.", "An open-source contributor fixes a bug in a fork, pushes the tested branch and submits a pull request for upstream maintainers to review."),
r("Fork workflow lo upstream repository, forked origin repository, local clone, feature branch and pull request untayi. Upstream remote original project ni refer chestundi.", "A fork workflow involves the upstream repository, personal fork, local clone, feature branch and pull request. The upstream remote points to the original project."),
r("Hosting platform lo fork create cheyyali. Fork clone chesi upstream remote add cheyyali. Feature branch lo changes commit chesi origin ki push cheyyali. Upstream ki pull request open cheyyali.", "Create a fork, clone it, add the original project as upstream, make changes on a branch, push to your fork and submit a pull request."),
r("Origin and upstream remotes inspect chesi fetch and synchronization commands use cheyyali.", "Use Git commands to configure and inspect the fork and upstream remotes and synchronize changes.", ["git clone https://github.com/myuser/project.git", "git remote add upstream https://github.com/original/project.git", "git remote -v", "git fetch upstream", "git push origin feature/fix"]),
r("Origin own fork ni, upstream original repository ni identify chestayi. Remote names convention matrame; URLs correct ga configure cheyyali.", "The conventional origin remote points to your fork and upstream points to the original repository. These names are conventions and their URLs must be verified.", undefined, "git remote add upstream https://github.com/original/project.git\ngit fetch upstream\ngit switch main\ngit merge upstream/main"),
r("Upstream remote configure cheyyakapovadam, fork stale ga undadam, wrong remote ki push cheyyadam and upstream ki direct push try cheyyadam common mistakes.", "Common mistakes include missing upstream configuration, stale forks, pushing to the wrong remote and attempting unauthorized direct pushes."),
r("Pull request outdated ayithe upstream fetch chesi branch update cheyyali. Push rejected ayithe origin permissions and remote branch state inspect cheyyali.", "If a pull request becomes outdated, fetch upstream and update the branch. For rejected pushes, inspect fork permissions and remote branch state."),
r("Fork sync regular ga cheyyali. Feature branches separate ga maintain cheyyali. Upstream changes integrate chesetappudu tests run cheyyali and contribution guidelines follow avvali.", "Synchronize forks regularly, isolate feature work in branches, test upstream updates and follow the project's contribution guidelines."),
r("Fork lo original repository secrets automatically share avutayani assume cheyyakoodadu. CI workflows fork pull requests nunchi privileged secrets expose cheyyakunda protect cheyyali.", "Do not assume secrets transfer safely between forks. Protect CI workflows from exposing privileged credentials to code submitted through external forks."),
r("Fork versus clone, origin versus upstream, open-source contribution flow and fork synchronization explain cheyyali.", "Explain fork versus clone, origin versus upstream, the contribution workflow and how to synchronize a fork."),
r("Fork ki Repository, Clone, Remote, Branch, Pull Request and GitHub Actions sambandham kaligi untayi.", "Related concepts include repositories, clone, remotes, branches, pull requests and GitHub Actions.")
]),

"Merge Conflict": makeSections("Merge Conflict", [
r("Merge conflict anedi Git automatic ga changes combine cheyyalekapoyinappudu occur avutundi. Same lines different branches lo modify ayinappudu developer intended final content decide cheyyali.", "A merge conflict occurs when Git cannot automatically combine changes, commonly because branches modify overlapping lines differently."),
r("Git common ancestor and branch changes compare chestundi. Automatic merge possible kakapothe conflicting file mark chestundi. Developer conflict markers resolve chesi result stage and merge continue chestadu.", "Git compares the common ancestor with both branch versions. When automatic resolution is impossible, it marks the file for manual resolution."),
r("Developer and teammate same API configuration line modify chestaru. Feature branch merge appudu conflict vastundi. Team correct timeout value decide chesi file resolve chesi tests rerun chestundi.", "Two developers change the same API setting. During integration, the team agrees on the correct value, resolves the file and reruns tests."),
r("Conflict lo current branch version, incoming branch version and common ancestor changes untayi. Git conflict markers HEAD and incoming commit sections ni show chestayi.", "A conflict involves the current branch, incoming branch and their common ancestor. Conflict markers identify the competing sections in the file."),
r("Merge or rebase start chesi conflict identify cheyyali. File open chesi correct combined content create cheyyali. Markers remove chesi tests run cheyyali. Resolved files stage chesi operation complete cheyyali.", "Start the merge or rebase, inspect conflicted files, create the intended combined content, remove markers, test, stage the resolution and complete the operation."),
r("Conflict status and diff inspect cheyyadaniki Git commands use cheyyali.", "Git commands identify conflicted paths and show the conflict state.", ["git status", "git diff --name-only --diff-filter=U", "git diff", "git diff --check", "git add <resolved-file>", "git merge --continue"]),
r("Conflict markers file lo `<<<<<<<`, `=======` and `>>>>>>>` lines ga appear avutayi. Resolution tarvata ee markers source file lo undakoodadu.", "Conflict markers separate the competing versions. They must be removed from the final source file after the intended result is selected.", undefined, "<<<<<<< HEAD\ncurrent branch content\n=======\nincoming branch content\n>>>>>>> feature-branch"),
r("Blind ga ours or theirs select cheyyadam, conflict markers leave cheyyadam, tests run cheyyakunda merge complete cheyyadam and generated files manual ga wrong edit cheyyadam mistakes.", "Common mistakes include blindly choosing one side, leaving conflict markers, skipping tests and incorrectly editing generated files."),
r("Conflict resolution unclear ayithe original branches and diff inspect cheyyali. Operation cancel cheyyali ante merge --abort or rebase --abort use cheyyali. Correct resolution tarvata tests run cheyyali.", "If resolution is uncertain, inspect both branches and the diff. Abort the operation when necessary, then retry with a clear resolution and tests."),
r("Frequent integration and small pull requests conflicts reduce chestayi. Shared configuration changes coordinate cheyyali. Conflict resolution reviewer verify cheyyali.", "Frequent integration and focused pull requests reduce conflicts. Coordinate shared-file changes and have reviewers verify important resolutions."),
r("Conflict lo sensitive data accidentally combine avvakunda review cheyyali. Conflict resolution process lo secrets or credentials expose ayithe rotate cheyyali.", "Review conflict resolutions for accidentally introduced sensitive data. Rotate credentials if a conflict exposes secrets."),
r("Merge conflict causes, conflict markers, ours versus theirs, merge abort, rebase continue and why tests must rerun explain cheyyali.", "Explain common conflict causes, conflict markers, ours and theirs, abort operations and why tests must run after resolution."),
r("Merge Conflict ki Merge, Rebase, Branch, Commit, Pull Request and Git diff sambandham kaligi untayi.", "Related concepts include merge, rebase, branches, commits, pull requests and Git diff.")
]),

"Git Tag": makeSections("Git Tag", [
r("Git tag specific commit ki named reference create chestundi. Release versions and important milestones identify cheyyadaniki use chestaru. Tags branches laga normal development lo move avvavu.", "A Git tag names a specific commit, commonly identifying releases and important milestones. Tags are generally intended to remain fixed."),
r("Tag commit object or commit reference ni identify chestundi. Lightweight tag simple reference; annotated tag metadata, message and optional signature contain chestundi.", "A lightweight tag is a simple reference to a commit. An annotated tag is a Git object containing metadata, a message and optionally a signature."),
r("Team version 2.5.0 release approve chestundi. Main branch tested commit meeda annotated tag create chesi remote ki push chestaru. CI release pipeline tag event tho package publish chestundi.", "A team marks a tested release commit with an annotated version tag and pushes it. The release pipeline can build and publish that tagged version."),
r("Tag architecture lo tag name, target commit, optional tag object, tagger identity, timestamp, message and optional signature untayi.", "A tag can include its name, target commit and, for annotated tags, tagger identity, timestamp, message and optional signature."),
r("Release commit identify chesi annotated tag create cheyyali. Tag inspect chesi remote ki push cheyyali. Release pipeline output and artifact version verify cheyyali.", "Identify the release commit, create an annotated tag, inspect it, push it to the remote and verify the resulting release artifacts."),
r("Tag list, details and target commit inspect cheyyadaniki Git commands use cheyyali.", "Use Git commands to list tags, inspect tag metadata and push tags to a remote.", ["git tag", "git tag -n", "git show v2.5.0", "git tag -a v2.5.0 -m \"Release 2.5.0\"", "git push origin v2.5.0", "git push origin --tags"]),
r("Semantic versioning format vMAJOR.MINOR.PATCH commonly use chestaru. Annotated tags release notes and signing metadata store cheyyadaniki suitable.", "Semantic versioning commonly uses major, minor and patch components. Annotated tags are useful for release descriptions and signatures.", undefined, "git tag -a v1.4.2 -m \"Release version 1.4.2\""),
r("Wrong commit meeda tag create cheyyadam, tag push cheyyakapovadam, release tag overwrite cheyyadam and all tags blindly push cheyyadam common mistakes.", "Common mistakes include tagging the wrong commit, forgetting to push tags, moving released tags and pushing unintended tags."),
r("Tag mismatch ayithe git show and commit SHA compare cheyyali. Remote lo tag missing ayithe specific tag push cheyyali. Existing tag update cheyyadam mundu release policy verify cheyyali.", "If a tag points to the wrong commit, compare its target SHA. If missing remotely, push the specific tag. Follow release policy before changing an existing tag."),
r("Annotated tags use cheyyali. Release tag immutable ga maintain cheyyali. Tag and artifact version align cheyyali. Release commit, build ID and checksum record cheyyali.", "Prefer annotated release tags, keep them immutable, align tag and artifact versions, and record the release commit, build ID and checksum."),
r("Release tags signed and verified cheyyavachchu. Tag creation permissions restrict cheyyali. Tag pipeline lo privileged secrets untrusted code ki expose avvakunda protect cheyyali.", "Sign and verify release tags where required, restrict who can create release tags and protect release workflows and credentials."),
r("Lightweight versus annotated tags, tag versus branch, semantic versioning, tag push and release pipeline trigger explain cheyyali.", "Explain lightweight and annotated tags, tags versus branches, semantic versions, pushing tags and tag-triggered release workflows."),
r("Git Tag ki Commit, Branch, Release, Artifact, GitHub Actions and CI/CD Pipeline sambandham kaligi untayi.", "Related concepts include commits, branches, releases, artifacts, GitHub Actions and CI/CD pipelines.")
]),

"GitOps": makeSections("GitOps", [
r("GitOps anedi Git repository ni desired system state ki source of truth ga use chese operational approach. Infrastructure and application configuration changes Git review and automation dwara deploy avutayi.", "GitOps is an operating model where Git stores the desired state of systems. Automated controllers reconcile actual environments with reviewed configuration in Git."),
r("Developer Git lo desired Kubernetes manifests change chestadu. Pull request review and merge ayyaka GitOps controller repository state observe chesi cluster actual state ni desired state tho reconcile chestundi.", "A developer changes desired Kubernetes configuration in Git. After review and merge, a GitOps controller observes the repository and reconciles the cluster."),
r("Team Kubernetes application replica count 3 nunchi 5 ki change chestundi. Manifest pull request approve ayyaka Argo CD sync process cluster lo five replicas maintain chestundi.", "A team changes a Kubernetes deployment from three replicas to five in Git. After approval, Argo CD synchronizes the cluster to the desired replica count."),
r("GitOps architecture lo Git repository, desired manifests, reconciliation controller, deployment target, health status and observability untayi. Pull-based model cluster nunchi desired state fetch chestundi.", "GitOps architecture includes a Git source of truth, desired manifests, reconciliation controller, target environment and health monitoring. Pull-based controllers retrieve desired state."),
r("Application manifests Git lo maintain cheyyali. GitOps tool repository and target cluster configure cheyyali. Sync policy define chesi initial reconciliation validate cheyyali.", "Store application manifests in Git, configure the GitOps controller and target cluster, define synchronization policy and validate the first reconciliation."),
r("Git repository status and Kubernetes live state inspect cheyyali. Argo CD CLI and kubectl use chesi application sync, health and resources verify cheyyavachchu.", "Inspect Git state and live cluster resources. Argo CD tools show synchronization and health, while kubectl verifies actual Kubernetes objects.", ["git status", "git log --oneline -5", "argocd app get <app-name>", "argocd app diff <app-name>", "kubectl get applications -A", "kubectl get pods -A"]),
r("GitOps repository lo environment-specific directories or overlays maintain cheyyavachchu. Argo CD Application source path and destination cluster/namespace define chestayi.", "Organize GitOps configuration with environment-specific directories or overlays. An Argo CD Application identifies the source path and destination cluster and namespace.", undefined, "apiVersion: argoproj.io/v1alpha1\nkind: Application\nmetadata:\n  name: payments\n  namespace: argocd\nspec:\n  source:\n    repoURL: https://github.com/example/platform-config.git\n    targetRevision: main\n    path: apps/payments/overlays/staging\n  destination:\n    server: https://kubernetes.default.svc\n    namespace: payments"),
r("Manual cluster changes Git lo update cheyyakapovadam, unclear environment separation, excessive sync permissions and secrets plain text lo store cheyyadam common mistakes.", "Common mistakes include changing live clusters without updating Git, poor environment separation, excessive controller permissions and storing plaintext secrets in repositories."),
r("Git and cluster state mismatch ayithe Argo CD diff inspect cheyyali. Sync fail ayithe controller logs, manifest validation and Kubernetes events check cheyyali.", "When Git and live state differ, inspect the application diff. For failed syncs, review controller logs, manifest validation and Kubernetes events.", ["argocd app diff <app-name>", "argocd app get <app-name>", "kubectl get events -n <namespace> --sort-by=.lastTimestamp", "kubectl describe application <app-name> -n argocd"]),
r("Git changes review and audit cheyyali. Environment overlays separate ga maintain cheyyali. Reconciliation and drift alerts enable cheyyali. Rollback kosam known-good Git revision preserve cheyyali.", "Review and audit Git changes, separate environment configuration, alert on reconciliation drift and preserve known-good revisions for rollback."),
r("GitOps repository lo passwords and tokens commit cheyyakoodadu. Secret encryption or external secret management use cheyyali. Controller service account ki least privilege ivvali.", "Do not commit plaintext credentials. Use encryption or external secret management and grant the GitOps controller only the permissions required for reconciliation."),
r("GitOps versus traditional push deployment, desired versus actual state, reconciliation loop, pull-based deployment, drift and rollback explain cheyyali.", "Explain GitOps versus push-based deployment, desired and actual state, reconciliation loops, pull-based delivery, drift detection and rollback."),
r("GitOps ki Git, Argo CD, Kubernetes, Helm, Pull Request, Configuration Drift and CI/CD Pipeline sambandham kaligi untayi.", "Related concepts include Git, Argo CD, Kubernetes, Helm, pull requests, configuration drift and CI/CD pipelines.")
])

};
