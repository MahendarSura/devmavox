import type { GlossaryLearningSection } from "./glossary-data";

type Entry = { te: string; en: string; commands?: string[]; example?: string };

const headings = [
  "1. Purpose – Why Is It Used?",
  "2. How It Works",
  "3. Real-Time Project Example",
  "4. Architecture / Components",
  "5. Step-by-Step Workflow",
  "6. Practical Commands",
  "7. Configuration Examples",
  "8. Common Mistakes",
  "9. Troubleshooting",
  "10. Best Practices",
  "11. Security Considerations",
  "12. Interview Points",
  "13. Related Concepts"
];

const r = (te: string, en: string, commands?: string[], example?: string): Entry => ({
  te, en,
  ...(commands ? { commands } : {}),
  ...(example ? { example } : {})
});

function makeSections(name: string, rows: Entry[]): GlossaryLearningSection[] {
  if (rows.length !== 13) throw new Error(`${name}: expected 13 sections, got ${rows.length}`);
  return rows.map((x, i) => ({
    title: headings[i],
    items: [{
      title: `${name} – ${headings[i].replace(/^\d+\.\s*/, "")}`,
      explanation: `Telugu Answer:\n${x.te}\n\nEnglish Explanation:\n${x.en}`,
      ...(x.commands ? { commands: x.commands } : {}),
      ...(x.example ? { example: x.example } : {})
    }]
  }));
}

export const gitCategoryLearningContent: Record<string, GlossaryLearningSection[]> = {

"Git": makeSections("Git", [
r("Git anedi distributed version control system. Developers code changes ni track cheyyadaniki, branches create cheyyadaniki, team tho collaborate cheyyadaniki use chestaru.", "Git is a distributed version control system that tracks source-code changes and supports branching, merging and collaboration."),
r("Developer working directory lo files modify chestadu. Changes staging area ki add chesi commit create chestadu. Commit local repository lo save avutundi; push dwara remote repository ki share chestadu.", "Git tracks changes through a working directory, staging area and repository. Commits save snapshots locally, and push sends commits to a remote repository."),
r("Team members microservice code meeda work chestaru. Prathi developer separate branch lo changes commit chesi remote ki push chestadu. Pull request review tarvata changes main branch lo merge avutayi.", "Developers work on separate branches, commit their changes and push them to a shared remote. Reviewed pull requests are merged into the main branch.", ["git status", "git add .", "git commit -m \"Add payment validation\"", "git push origin feature/payment-validation"]),
r("Git architecture lo working tree, staging area, local repository, remote repository, commits, branches and references untayi. Git commit history content and metadata ni identify chestundi.", "Git uses a working tree, staging area, local object database and references such as branches and tags. Commits record project snapshots and metadata."),
r("Repository clone chesi branch create cheyyali. Files modify chesi status inspect cheyyali. Required changes stage chesi meaningful commit create chesi remote ki push cheyyali.", "Clone the repository, create a working branch, modify files, inspect changes, stage intended files, commit and push the branch."),
r("Git status current changes chupistundi. Git log history chupistundi. Diff changes compare chestundi. Branch and remote commands collaboration ki use avutayi.", "Git provides commands to inspect working-tree state, history, differences, branches and remotes.", ["git status", "git log --oneline --graph --all", "git diff", "git branch -a", "git remote -v", "git fetch", "git push"]),
r("Git identity configure cheyyadaniki user.name and user.email set cheyyali. Repository-specific configuration global configuration ni override cheyyagaladu.", "Configure commit identity with user.name and user.email. Repository-level settings can override global settings.", ["git config --global user.name \"Developer Name\"", "git config --global user.email \"developer@example.com\"", "git config --list"]),
r("Changes inspect cheyyakunda git add . cheyyadam, unclear commit messages, wrong branch lo commit cheyyadam and secrets commit cheyyadam common mistakes.", "Common mistakes include staging unintended files, unclear commit messages, committing on the wrong branch and accidentally committing secrets."),
r("Unexpected changes unte git status and git diff inspect cheyyali. Commit missing ayithe git log and reflog check cheyyali. Remote mismatch ayithe git remote -v verify cheyyali.", "Use status and diff to inspect unexpected changes. Use log and reflog to locate commits, and verify remote configuration when synchronization fails.", ["git status", "git diff", "git log --oneline --all", "git reflog", "git remote -v"]),
r("Small logical commits create cheyyali. Feature branches use cheyyali. Pull request review and automated tests enforce cheyyali. Important branches ki protection rules configure cheyyali.", "Create focused commits, use feature branches, require review and automated checks, and protect important branches."),
r("Git repository lo API keys, passwords and private certificates commit cheyyakoodadu. Secret scanning enable cheyyali. Accidentally committed secret ni delete chesina tarvata kuda rotate cheyyali.", "Never commit credentials or private keys. Enable secret scanning. If a secret is committed, rotate it because removing the file does not invalidate exposed credentials."),
r("Git distributed architecture, staging area, commit, branch, merge, fetch versus pull and reset versus revert explain cheyyali.", "Explain Git's distributed model, staging area, commits, branches, merge, fetch versus pull and reset versus revert."),
r("Git ki Repository, Commit, Branch, Merge, Rebase, Pull Request, Git Tag and GitOps concepts sambandham kaligi untayi.", "Related concepts include repositories, commits, branches, merges, rebases, pull requests, tags and GitOps.")
]),

"Repository": makeSections("Repository", [
r("Git repository project history and files ni manage chestundi. Local repository developer machine lo untundi; remote repository team members madhya collaboration ki central sharing point ga work chestundi.", "A Git repository stores project content and version history. Local repositories support offline work, while remote repositories enable collaboration and sharing."),
r("Repository lo Git objects and references store avutayi. Commits objects ni reference chestayi; branches commit history lo movable pointers laga work chestayi. Remote repository changes fetch or push dwara exchange avutayi.", "A repository stores Git objects and references. Commits identify snapshots, branches point to commit history, and remotes exchange changes through fetch and push."),
r("Company application GitHub repository lo maintain chestaru. Developer clone chesi feature branch create chestadu. Pull request review tarvata approved changes shared repository main branch lo merge avutayi.", "A team hosts an application in a remote Git repository. Developers clone it, work on feature branches and merge reviewed changes through pull requests."),
r("Repository lo working tree, .git metadata directory, object database, refs, configuration and optional remotes untayi. Bare repositories usually central hosting and server-side workflows kosam use chestaru.", "A repository contains the working tree, Git metadata, object database, references and configuration. Bare repositories omit a checked-out working tree and are common on servers."),
r("New project ki git init run cheyyali leda existing project git clone cheyyali. Remote add chesi initial commit push cheyyali. Access and branch policies configure cheyyali.", "Initialize a new repository or clone an existing one. Configure remotes, create commits, push changes and establish access and branch policies.", ["git init", "git clone https://example.com/team/app.git", "git remote add origin https://example.com/team/app.git", "git push -u origin main"]),
r("Repository status, history and remotes inspect cheyyadaniki Git commands use cheyyali. .git directory presence repository metadata indicate chestundi.", "Use Git commands to inspect repository state, history, remotes and configuration.", ["git status", "git log --oneline --all", "git remote -v", "git config --local --list", "git rev-parse --show-toplevel"]),
r("Remote URL HTTPS or SSH format lo configure cheyyavachchu. .gitignore generated files and local-only files ni tracking nunchi exclude chestundi.", "A remote can use HTTPS or SSH. A .gitignore file excludes matching untracked files from normal staging operations.", undefined, "git remote add origin git@github.com:company/project.git\n\n# .gitignore example\nnode_modules/\n.env\n*.log\ndist/"),
r("Wrong remote URL, nested repository, missing .git metadata and incorrect permissions valla clone or push failures ravachchu.", "Common problems include incorrect remote URLs, accidental nested repositories, missing metadata and insufficient repository permissions."),
r("Clone fail ayithe URL, DNS, network and authentication check cheyyali. Push reject ayithe remote history and branch protection inspect cheyyali.", "For clone failures, inspect the URL, network and authentication. For rejected pushes, inspect remote history and branch protection rules.", ["git remote -v", "git ls-remote origin", "git fetch --all", "git status", "git log --oneline --all"]),
r("Repository access roles define cheyyali. Branch protection, pull request review, backup and retention policies maintain cheyyali. README and contribution guidelines clear ga undali.", "Define repository access roles, protect important branches, require reviews and checks, and maintain backups, retention policies and contribution documentation."),
r("Private repository lo sensitive files commit cheyyakoodadu. Least-privilege access and SSO or MFA use cheyyali. Deploy keys and tokens scope restrict cheyyali.", "Protect private repositories with least-privilege access, strong authentication and scoped tokens. Do not treat private visibility as a substitute for secret management."),
r("Local versus remote repository, bare repository, .git directory, origin remote and clone versus init differences explain cheyyali.", "Explain local and remote repositories, bare repositories, the .git directory, origin and the difference between clone and init."),
r("Repository ki Git, Commit, Branch, Remote, Clone, Fork, Pull Request and Git hosting platforms sambandham kaligi untayi.", "Related concepts include Git, commits, branches, remotes, clone, fork, pull requests and Git hosting platforms.")
]),

"Commit": makeSections("Commit", [
r("Commit anedi Git repository lo saved snapshot. Developer chesina logical code change ni history lo record chestundi. Commit message and author metadata valla changes trace cheyyavachchu.", "A commit is a saved snapshot in Git history. It records a logical set of changes along with author, timestamp and message metadata."),
r("Files first staging area lo add avutayi. Git commit staged content ni snapshot ga save chestundi. New commit previous commit ni parent ga reference chestundi, thereby history form avutundi.", "Files are first staged. Git creates a commit from staged content and links it to its parent commit, forming a history graph."),
r("Developer login bug fix chesi tests run chestadu. Relevant files stage chesi `Fix login token validation` message tho commit create chestadu. Reviewer commit history lo exact change inspect chestadu.", "A developer fixes a login issue, tests the change, stages the relevant files and creates a descriptive commit that reviewers can inspect.", ["git status", "git add src/auth.ts", "git diff --cached", "git commit -m \"Fix login token validation\""]),
r("Commit lo tree reference, parent reference, author, committer, timestamp and message untayi. Git content-addressed objects use chestundi; commit ID content and metadata meeda depend avutundi.", "A commit references a tree and parent commit and records author, committer, timestamps and a message. Its object ID is derived from its content and metadata."),
r("Changes inspect chesi tests run cheyyali. Only intended files stage cheyyali. Staged diff review chesi clear message tho commit create cheyyali. Push chesi remote history verify cheyyali.", "Review changes and run tests, stage only intended files, inspect the staged diff, write a meaningful message, commit and push."),
r("Commit history, changed files and commit details inspect cheyyadaniki log and show commands use cheyyali.", "Use Git history and inspection commands to review commits, changed files and metadata.", ["git status", "git diff", "git diff --cached", "git log --oneline -10", "git show --stat HEAD", "git show HEAD"]),
r("Commit message convention team standard batti define cheyyavachchu. Conventional Commits lo feat, fix, docs and chore prefixes use chestaru.", "Teams can standardize commit messages. Conventional Commits commonly use prefixes such as feat, fix, docs and chore.", undefined, "feat(auth): add refresh-token validation\nfix(api): handle missing customer ID\ndocs: update deployment guide"),
r("Unrelated files one commit lo include cheyyadam, empty messages, generated secrets commit cheyyadam and staged changes verify cheyyakunda commit cheyyadam common mistakes.", "Common mistakes include mixing unrelated changes, vague messages, committing secrets and failing to review the staged diff."),
r("Wrong commit create ayithe reflog and status inspect cheyyali. Commit push ayindha leda check chesi safe recovery method choose cheyyali. Shared history ni force rewrite cheyyakoodadu.", "If a commit is incorrect, inspect status and reflog. Determine whether it has been shared, then choose a safe correction method without unexpectedly rewriting shared history.", ["git status", "git log --oneline -5", "git reflog -10", "git show HEAD"]),
r("One commit one logical purpose follow avvali. Tests include cheyyali. Commit message why change chesaro explain cheyyali. Small commits review and rollback easy chestayi.", "Keep each commit focused on one logical change, include appropriate tests and explain why the change was made. Small commits are easier to review and revert."),
r("Commit lo secrets undakoodadu. Commit author identity correct ga configure cheyyali. Signed commits policy use chesthe signing keys secure ga maintain cheyyali.", "Do not include secrets in commits. Configure identity correctly and protect signing keys when commit-signing policies are used."),
r("Commit versus push, staged versus unstaged changes, parent commit, commit hash, amend and revert difference explain cheyyali.", "Explain commit versus push, staged versus unstaged changes, parent commits, commit IDs, amend and revert."),
r("Commit ki Git Repository, Staging Area, Branch, Merge, Rebase, Git Tag and Pull Request sambandham kaligi untayi.", "Related concepts include Git repositories, staging, branches, merges, rebases, tags and pull requests.")
]),

"Branch": makeSections("Branch", [
r("Branch anedi commit history lo independent development line. Feature, bug fix and release work ni main branch disturb cheyyakunda parallel ga develop cheyyadaniki use chestaru.", "A branch is an independent line of development. It allows features, fixes and releases to progress without directly changing the main branch."),
r("Git branch movable reference ga oka commit ni point chestundi. New commit create chesinappudu current branch pointer advance avutundi. Checkout or switch branch working tree ni selected branch state ki update chestundi.", "A branch is a movable reference to a commit. New commits advance that reference, while switching branches updates the working tree to the selected branch."),
r("Payments feature kosam developer feature/payments branch create chestadu. Changes commit and push chesi pull request open chestadu. Review complete ayyaka main branch lo merge chestaru.", "A developer creates a feature branch for payment work, commits and pushes changes, then opens a pull request for review and merging.", ["git switch -c feature/payments", "git status", "git add .", "git commit -m \"Add payment endpoint\"", "git push -u origin feature/payments"]),
r("Repository lo local branches and remote-tracking branches untayi. HEAD current checkout location ni identify chestundi. Branch protection server-side rules dwara important branches ni protect chestundi.", "A repository has local branches and remote-tracking references. HEAD identifies the current checkout, while hosting platforms enforce branch protection policies."),
r("Latest main fetch cheyyali. Feature branch create chesi work commit cheyyali. Remote ki push chesi pull request create cheyyali. Merge tarvata local branch cleanup cheyyali.", "Fetch the latest base branch, create a feature branch, commit work, push it, open a pull request and clean up the branch after merging."),
r("Branch list, current branch and merged branches inspect cheyyadaniki commands use cheyyali.", "Git commands list local and remote branches and identify merged branches.", ["git branch", "git branch -a", "git branch --merged", "git switch main", "git fetch --prune"]),
r("Branch naming convention consistent ga maintain cheyyali. Feature, bugfix and release prefixes use cheyyavachchu. Main branch protection hosting platform lo configure cheyyali.", "Use consistent names such as feature, bugfix and release prefixes. Configure main-branch protection in the repository hosting platform.", undefined, "feature/payment-validation\nbugfix/login-timeout\nrelease/2.4.0"),
r("Wrong branch lo work cheyyadam, stale branch nunchi development, direct main commits and remote branch cleanup miss avvadam common mistakes.", "Common mistakes include working on the wrong branch, starting from stale history, bypassing main-branch review and leaving obsolete remote branches."),
r("Branch wrong ayithe current changes status inspect chesi safe ga correct branch create cheyyali. Remote branch kanipinchakapothe fetch and remote tracking references check cheyyali.", "If work is on the wrong branch, inspect uncommitted changes before moving them. If a remote branch is missing, fetch and inspect remote-tracking references.", ["git status", "git branch -vv", "git fetch --all --prune", "git branch -a", "git log --oneline --decorate --all"]),
r("Short-lived feature branches prefer cheyyali. Frequent integration, branch protection, review and automated tests use cheyyali. Branch divergence ekkuva avvakunda latest base sync cheyyali.", "Prefer short-lived branches, integrate frequently, require reviews and automated checks, and avoid allowing branches to diverge for long periods."),
r("Branch protection unauthorized direct changes prevent chestundi. Sensitive release branches ki restricted write access and mandatory review enforce cheyyali.", "Branch protection reduces unauthorized changes. Restrict write access and require review for sensitive release branches."),
