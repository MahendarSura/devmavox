  "Ansible Playbook": makeSections([
    r("Ansible Playbook multiple hosts meeda repeatable automation tasks ni YAML format lo define chestundi.", "An Ansible playbook is a YAML document that describes one or more plays and the tasks to execute on selected managed hosts."),
    r("Play target hosts select chestundi; tasks modules invoke chestayi; variables customize behavior; handlers notified changes tarvata run avuthayi.", "A playbook selects hosts, runs module-based tasks, uses variables to customize behavior, and can notify handlers when a task reports a change."),
    r("Application deployment playbook package install chesi configuration template copy chesi service restart and health verification perform chestundi.", "A deployment playbook can install dependencies, render application configuration, deploy files, restart a service through a handler, and verify service health."),
    r("Playbook lo plays, hosts, tasks, modules, variables, handlers, become settings, and roles use avuthayi.", "A playbook is built from plays, host patterns, tasks, modules, variables, handlers, privilege-escalation settings, and optional role references."),
    r("Playbook YAML write cheyyali, syntax check run cheyyali, limited hosts target chesi test cheyyali, tarvata approved environment lo execute cheyyali.", "Write the YAML playbook, run syntax validation, test against a limited host group, review task results, and then execute it against the approved inventory."),
    r("Commands: ansible-playbook site.yml --syntax-check, --list-hosts, --list-tasks, --check, and -i inventory.ini.", "Use syntax-check to validate parsing, list-hosts and list-tasks to preview scope, check mode for supported dry runs, and -i to select an inventory."),
    r("Playbook example lo hosts: webservers, become: true, tasks: package installation and service state declarations use cheyyachu.", "A play can target webservers, enable privilege escalation where required, and declare package and service tasks with explicit desired states."),
    r("Invalid YAML indentation, missing colon, wrong module parameters, undefined variables, and shell-heavy tasks common mistakes.", "Common mistakes include invalid YAML indentation, misspelled module arguments, undefined variables, incorrect host patterns, and unnecessary shell commands."),
    r("Failure ayithe failed task name, module output, remote permissions, variable values, and host connectivity inspect cheyyali.", "Troubleshoot by locating the failed task, reading module output, checking remote permissions and variables, and confirming the target host is reachable."),
    r("Idempotent modules, meaningful task names, handlers, roles, tags, and staged testing playbook quality improve chestayi.", "Use idempotent modules, descriptive task names, handlers for service restarts, reusable roles, meaningful tags, and staged testing."),
    r("Secrets plain text lo avoid cheyyali, become scope limit cheyyali, untrusted variables validate cheyyali, and execution access audit cheyyali.", "Protect secrets, limit privilege escalation, validate untrusted input, restrict playbook execution permissions, and audit automation runs."),
    r("Playbook orchestration document; task individual operation; module task implementation; handler notified change ki response.", "A playbook orchestrates plays, tasks describe operations, modules implement them, and handlers respond to notifications from changed tasks."),
