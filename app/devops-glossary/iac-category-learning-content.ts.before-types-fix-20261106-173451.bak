import type { GlossaryLearningSection } from "./glossary-data";

const sectionTitles = [
  "Purpose - Why Is It Used?",
  "How It Works",
  "Real-Time Project Example",
  "Architecture / Components",
  "Step-by-Step Workflow",
  "Practical Commands",
  "Configuration Examples",
  "Common Mistakes",
  "Troubleshooting",
  "Best Practices",
  "Security Considerations",
  "Interview Points",
  "Related Concepts",
];

function r(telugu: string, english: string) {
  return { telugu, english };
}

function makeSections(rows: ReturnType<typeof r>[]): GlossaryLearningSection {
  return sectionTitles.map((title, index) => ({
    title,
    items: [{
      title: "Technical Explanation",
      explanation: rows[index].english,
      teluguExplanation: rows[index].telugu,
    }],
  }));
}

export const iacCategoryLearningContent: Record<string, GlossaryLearningSection[]> = {
  "Infrastructure as Code": makeSections([
    r("Infrastructure ni manual ga create cheyyakunda code files dwara define chesi repeatable ga provision cheyyadam IaC.", "Infrastructure as Code defines servers, networks, storage, and cloud resources in machine-readable files so environments can be created consistently and repeatedly."),
    r("IaC engine configuration files ni read chesi desired infrastructure state ni provider APIs dwara actual resources ga convert chestundi.", "An IaC tool reads configuration, compares desired state with available state, and calls provider APIs to create, update, or remove infrastructure."),
    r("Team development, testing, staging, production environments kosam same infrastructure pattern ni version-controlled code nunchi deploy chestundi.", "A team defines a VPC, subnets, security rules, and compute resources once, then uses reviewed code and environment-specific inputs to create consistent development and production environments."),
    r("IaC lo configuration files, providers, state data, modules, variables, outputs, and execution engine important components.", "Typical IaC architecture includes configuration files, providers, reusable modules, input variables, state or inventory data, execution plans, and cloud or infrastructure APIs."),
    r("Requirements identify chesi resources define cheyyali, code review cheyyali, plan inspect chesi apply cheyyali, tarvata infrastructure verify cheyyali.", "The workflow starts with infrastructure requirements, defines resources in code, validates and reviews changes, previews the execution plan, applies approved changes, and verifies the resulting environment."),
    r("Terraform workflow lo terraform init, terraform fmt, terraform validate, terraform plan, terraform apply commands use chestaru.", "Common Terraform commands include terraform init to initialize providers, terraform fmt to format files, terraform validate to check configuration, terraform plan to preview changes, and terraform apply to execute them."),
    r("Example ga VPC, subnet, security group, EC2 resources ni HCL files lo define chesi variables dwara region and instance size control cheyyachu.", "A typical configuration defines a VPC, subnet, security group, and EC2 instance in HCL, while variables control region, instance size, and environment-specific values."),
    r("Manual infrastructure changes, hardcoded credentials, missing state backup, and unreviewed applies environment differences and outages create chestayi.", "Common failures include configuration drift, hardcoded secrets, missing state protection, overly broad permissions, unreviewed changes, and inconsistent provider versions."),
    r("Resource create avvakapothe plan output, provider authentication, API permissions, quotas, dependency order, and state consistency inspect cheyyali.", "Troubleshooting should examine validation errors, provider authentication, API permissions, resource quotas, dependency references, state consistency, and the exact plan output."),
    r("Infrastructure code ni Git lo maintain cheyyali, modules reuse cheyyali, plans review cheyyali, state secure ga store cheyyali.", "Use version control, reusable modules, code reviews, automated validation, protected state storage, pinned provider versions, and controlled deployment permissions."),
    r("IaC repository lo secrets commit cheyyakudadhu. Least-privilege cloud roles, encrypted state, secure CI credentials, and audit logs use cheyyali.", "Protect infrastructure code and state with least-privilege identities, encrypted remote storage, secret-management systems, restricted CI credentials, and auditable change approvals."),
    r("IaC declarative or imperative approach lo implement cheyyachu. Terraform declarative configuration use chestundi; automation tools tasks execute cheyyagalavu.", "Infrastructure as Code makes infrastructure reproducible and reviewable. Declarative tools describe the desired result, while imperative automation can describe the steps used to reach it."),
    r("Terraform, Ansible, CloudFormation, Pulumi, provider, resource, module, state, and configuration management IaC ki related concepts.", "Related concepts include Terraform, Ansible, AWS CloudFormation, Pulumi, providers, resources, modules, state management, and configuration management."),
  ]),

  "Terraform": makeSections([
    r("Terraform cloud and infrastructure resources ni declarative configuration files dwara provision and manage cheyyadaniki use chestaru.", "Terraform is an infrastructure provisioning tool that uses declarative configuration to create and manage resources across cloud and other supported platforms."),
    r("Terraform HCL configuration read chesi dependency graph build chestundi, state compare chestundi, plan generate chesi provider APIs call chestundi.", "Terraform parses HCL, builds a dependency graph, compares configuration with state and remote objects, creates a plan, and uses providers to perform approved changes."),
    r("Production project lo Terraform AWS VPC, private subnets, EC2, load balancer, and database infrastructure create cheyyadaniki use avuthundi.", "A production team can use Terraform to provision a VPC, private subnets, security groups, load balancer, and database resources with reviewed environment-specific configuration."),
    r("Terraform architecture lo CLI, HCL configuration, providers, resources, modules, state file, backend, and dependency graph untayi.", "Core Terraform components include the CLI, HCL files, providers, resources, modules, variables, outputs, state, backends, and dependency graph."),
    r("terraform init run chesi configuration prepare cheyyali; validate, plan, review, apply, and post-deployment verification follow avvali.", "Initialize the working directory, validate configuration, generate and review a plan, apply approved changes, and verify the provisioned resources."),
    r("Commands: terraform init, terraform fmt, terraform validate, terraform plan, terraform apply, terraform output, terraform state list.", "Useful commands include terraform init, terraform fmt, terraform validate, terraform plan, terraform apply, terraform output, and terraform state list. Review destructive plans before approval."),
    r("Example: provider AWS region configure chesi aws_instance resource define cheyyachu; AMI and instance_type variables nunchi provide cheyyachu.", "A Terraform AWS configuration can declare the AWS provider and an aws_instance resource, with the AMI, instance type, and region supplied through variables."),
    r("Provider initialize cheyyakapovadam, wrong resource references, unpinned versions, and state file delete cheyyadam common mistakes.", "Common mistakes include missing initialization, invalid resource references, unpinned provider versions, incorrect variable values, and accidental loss or exposure of state."),
    r("Terraform error vaste init output, validate errors, provider version, credentials, plan diff, and state references check cheyyali.", "Diagnose Terraform failures by checking initialization output, syntax validation, provider compatibility, credentials, API permissions, plan differences, and state references."),
    r("Provider versions pin cheyyali, modules reuse cheyyali, remote backend enable cheyyali, plan approvals and CI validation enforce cheyyali.", "Pin provider versions, use reusable modules, protect remote state, review plans, automate formatting and validation, and separate environments safely."),
    r("State file sensitive values contain cheyyachu. Encryption, access restrictions, locking, secure credentials, and secret scanning mandatory.", "Terraform state may contain sensitive values. Encrypt storage, restrict access, enable locking where supported, avoid committing state, and use secure identity federation."),
    r("Terraform desired infrastructure ni declare chestundi. Plan changes preview chestundi; apply approved changes execute chestundi.", "Terraform is declarative. The plan command previews proposed changes, while apply executes the approved plan against the configured provider."),
    r("Terraform Provider, Resource, State, Module, Plan, Apply, and Infrastructure as Code concepts Terraform ki closely related.", "Related concepts include Terraform providers, resources, state, modules, variables, outputs, plans, applies, and infrastructure lifecycle management."),
  ]),

  "Terraform Provider": makeSections([
    r("Provider anedi Terraform ni AWS, Azure, Kubernetes lanti platform APIs tho connect chese plugin.", "A Terraform provider is a plugin that allows Terraform to interact with a platform or service through its API, such as AWS, Azure, or Kubernetes."),
    r("Provider configuration credentials and endpoint details use chesi resource operations ni remote platform API ki translate chestundi.", "Terraform loads the selected provider, configures its connection and authentication, and uses provider-defined resource and data-source operations to communicate with the platform."),
    r("AWS provider use chesi team EC2, VPC, S3, and IAM resources ni Terraform nunchi manage chestundi.", "A project configures the AWS provider for a selected region and uses AWS resource types to manage networking, compute, storage, and access-control resources."),
    r("Provider block, provider plugin, version constraint, authentication configuration, resources, and data sources main components.", "Provider architecture includes a provider block, plugin binary, version constraints, authentication configuration, resource types, and data-source types."),
    r("Required provider declare cheyyali, version constraint set cheyyali, credentials configure cheyyali, terraform init run chesi provider initialize cheyyali.", "Declare the required provider and version, configure secure authentication, initialize the working directory, and validate provider configuration before planning resources."),
    r("Commands: terraform init, terraform providers, terraform version, terraform validate, terraform plan.", "Use terraform init to install providers, terraform providers to inspect dependencies, terraform version to inspect CLI details, and validate or plan to check configuration."),
    r("required_providers block lo source and version specify cheyyachu; provider block lo region specify cheyyachu.", "A required_providers block identifies the provider source and version constraint, while the provider block configures settings such as an AWS region."),
    r("Wrong provider source, incompatible version, missing credentials, and incorrect region provider failures ki common reasons.", "Common mistakes include using an incorrect provider source address, incompatible versions, missing credentials, wrong regions, and committing credentials in configuration."),
    r("Provider initialization fail ayithe lock file, registry connectivity, proxy, version constraint, and authentication inspect cheyyali.", "Troubleshoot provider failures by inspecting initialization output, the dependency lock file, registry connectivity, proxy configuration, version constraints, and authentication."),
    r("Provider versions pin cheyyali, .terraform.lock.hcl commit cheyyali, and CI environment lo controlled credentials use cheyyali.", "Constrain provider versions, commit the dependency lock file, use controlled credentials, and test provider upgrades in a non-production environment first."),
    r("Provider credentials source code lo hardcode cheyyakudadhu. Short-lived roles, environment isolation, and restricted permissions use cheyyali.", "Do not hardcode provider credentials. Prefer short-lived identities, role assumption, restricted permissions, secure environment variables, and audited access."),
    r("Provider platform API integration istundi; resource actual infrastructure object ni represent chestundi.", "A provider supplies platform integration, while resources represent managed objects and data sources read information about existing objects."),
    r("Terraform Resource, Data Source, Provider Version, Backend, and Terraform Init related concepts.", "Related concepts include Terraform resources, data sources, provider version constraints, dependency lock files, backends, and initialization."),
  ]),

  "Terraform Resource": makeSections([
    r("Terraform resource anedi create, update, or delete cheyyalsina infrastructure object ni represent chestundi.", "A Terraform resource represents an infrastructure object that Terraform can create, update, or destroy through its provider."),
    r("Resource type and name use chesi configuration declare chestaru. Arguments desired settings define chestayi; attributes created object details expose chestayi.", "A resource block declares a provider-specific type and local name. Arguments configure the desired object, and exported attributes expose information about the managed object."),
    r("AWS project lo aws_instance resource use chesi application server create chesi security group and subnet tho connect chestaru.", "A team defines an EC2 instance resource and references a subnet and security group so the application server is created with the required network placement and access rules."),
    r("Resource block, resource type, local name, arguments, attributes, lifecycle settings, and dependency references resource structure lo untayi.", "A resource definition contains a type, local name, arguments, optional lifecycle settings, and references to other resources or data sources."),
    r("Resource define chesi arguments set cheyyali, references connect cheyyali, plan inspect cheyyali, apply chesi resulting attributes verify cheyyali.", "Define the resource, configure required arguments, establish dependencies through references, inspect the plan, apply approved changes, and verify the resulting object."),
    r("Commands: terraform validate, terraform plan, terraform apply, terraform state show, terraform state list.", "Use validate and plan before applying. Use terraform state list and terraform state show to inspect managed resource addresses and recorded attributes."),
    r("Example: resource block lo aws_s3_bucket type and logical name define chesi bucket configuration specify cheyyachu.", "An AWS S3 bucket resource can declare a bucket name, encryption configuration, versioning settings, and tags using the arguments supported by the provider version."),
    r("Duplicate resource addresses, wrong arguments, missing dependencies, and accidental resource replacement common mistakes.", "Common mistakes include duplicate resource addresses, invalid arguments, incorrect references, missing lifecycle protections, and unexpected replacement caused by immutable attributes."),
    r("Unexpected replacement vaste plan lo forces replacement indicators, changed attributes, references, and provider documentation inspect cheyyali.", "When Terraform proposes replacement, inspect the plan for replacement markers, identify changed arguments, verify provider behavior, and confirm whether replacement is safe."),
    r("Meaningful resource names, reusable modules, explicit dependencies only when needed, and plan review follow avvali.", "Use meaningful resource names, prefer implicit dependencies through references, apply lifecycle rules carefully, and review resource changes before production deployment."),
    r("Resource permissions least privilege ga undali; public exposure, encryption, deletion protection, and sensitive outputs evaluate cheyyali.", "Resource security depends on least-privilege permissions, secure network exposure, encryption, deletion safeguards, and careful handling of sensitive attributes."),
    r("Resource type provider define chestundi. Resource name Terraform configuration lo unique address create chestundi.", "The provider defines available resource types. The local resource name helps form a unique Terraform address used in references and state."),
    r("Terraform Provider, Terraform State, Terraform Plan, Terraform Module, and Data Source related concepts.", "Related concepts include providers, state addresses, plans, modules, data sources, lifecycle settings, and dependency graphs."),
