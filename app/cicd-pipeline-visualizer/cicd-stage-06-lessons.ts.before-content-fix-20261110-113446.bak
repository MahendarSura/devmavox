export type SonarQubeSection = {
  title: string;
  content: string;
  code?: string;
  practicalNotes?: string[];
};

export type SonarQubeLesson = {
  title: string;
  description: string;
  sections: SonarQubeSection[];
  exercise: string;
};

export const stageSixLessonOverrides: Record<string, SonarQubeLesson> = {
  "SonarQube Fundamentals": {
    title: "SonarQube Fundamentals",
    description: "Understand how SonarQube continuously inspects source code and helps development teams identify bugs, vulnerabilities, code smells, duplication, and maintainability risks.",
    sections: [
      {
        title: "What SonarQube Actually Does",
        content: "SonarQube is a static code analysis platform. It examines source code without executing the application. It identifies coding defects, security weaknesses, maintainability problems, and duplicated code. Developers use its findings to improve code quality before changes reach production."
      },
      {
        title: "Static Analysis Versus Runtime Testing",
        content: "Unit tests execute application code with controlled inputs. Integration tests validate communication between components. SonarQube analyzes source code structure and patterns. Static analysis can identify suspicious conditions even when a test does not execute the affected code path. It complements testing; it does not replace testing."
      },
      {
        title: "Quality Concepts and Metrics",
        content: "Understand Bugs, Vulnerabilities, Security Hotspots, Code Smells, Coverage, Duplications, Reliability Rating, Security Rating, Maintainability Rating, and Technical Debt. A bug represents code likely to behave incorrectly. A vulnerability indicates a security weakness. A code smell indicates maintainability risk rather than necessarily incorrect behavior."
      },
      {
        title: "Developer-to-CI Analysis Lifecycle",
        content: "A developer commits source code. The CI pipeline checks out the repository, compiles the project, executes tests, and generates coverage reports. SonarScanner submits source files and analysis properties to SonarQube. The server processes the report and publishes issues, metrics, and Quality Gate status."
      },
      {
        title: "First Project Analysis",
        content: "Create a project in SonarQube, generate an analysis token, configure the project key, and run the scanner from the repository root. Ensure the source directory and language configuration match the actual project. Review the analysis result in the project dashboard."
      },
      {
        title: "Understanding an Analysis Result",
        content: "Do not treat the total issue count as the only quality indicator. Review issue severity, affected files, new-code findings, coverage, duplication, and Quality Gate conditions. Prioritize exploitable security findings and defects that can affect application behavior."
      }
    ],
    exercise: "Create a sample Java repository, analyze it with SonarScanner, inspect at least one bug or code smell, and explain how the finding should be fixed."
  },

  "SonarQube Architecture": {
    title: "SonarQube Architecture",
    description: "Understand the server-side and scanner-side components involved in source analysis, report processing, database persistence, and dashboard delivery.",
    sections: [
      {
        title: "Architecture Components",
        content: "A typical SonarQube deployment includes the SonarQube server, web application, compute engine, Elasticsearch-based search capabilities, a relational database, and external scanners. The scanner runs in the build environment and communicates analysis data to the server."
      },
      {
        title: "Scanner Responsibilities",
        content: "The scanner discovers source files, reads analysis properties, applies exclusions, invokes language analyzers, and uploads the analysis report. It normally runs close to the source repository, such as on a Jenkins agent or CI runner."
      },
      {
        title: "Server and Compute Engine",
        content: "The server accepts analysis reports. The Compute Engine processes submitted reports asynchronously, calculates measures, evaluates Quality Gates, and stores analysis results. A scanner upload finishing does not always mean background processing has completed."
      },
      {
        title: "Database and Search Responsibilities",
        content: "The relational database stores persistent application and analysis information. Search infrastructure supports fast issue and project queries. Production deployments must use supported database and server versions and must follow documented backup and upgrade procedures."
      },
      {
        title: "Network Communication",
        content: "Build agents need network access to the SonarQube server. Administrators need access to the web interface. Database connectivity must be restricted to the application server. Use TLS, firewall rules, DNS, and proxy settings appropriate to the environment."
      },
      {
        title: "Production Deployment Design",
        content: "Separate development, test, and production analysis environments when required. Size CPU and memory according to project volume and concurrent analysis. Monitor server health, database performance, background task queues, disk capacity, and backup status."
      }
    ],
    exercise: "Draw the complete data flow from a Jenkins agent to SonarQube, Compute Engine, database, and dashboard. Identify the network connections required by each component."
  },

  "Installation and Setup": {
    title: "Installation and Setup",
    description: "Install and configure a supported SonarQube environment and prepare it for reliable project analysis.",
    sections: [
      {
        title: "Prerequisites and Compatibility",
        content: "Before installation, verify the SonarQube edition, supported operating system, Java requirements for the selected release, database compatibility, memory requirements, and disk capacity. Do not assume that an older installation guide applies to a newer release."
      },
      {
        title: "Database Preparation",
        content: "Provision a supported external database for production. Create a dedicated database and account with only the permissions required by SonarQube. Configure connection details securely and avoid exposing database credentials in source control."
      },
      {
        title: "Linux Host Preparation",
        content: "Prepare a dedicated Linux host, configure required operating-system limits, create a non-root service account, and allocate appropriate storage. Follow the requirements documented for the exact SonarQube version."
      },
      {
        title: "Service Configuration",
        content: "Configure the application to connect to the database. Store sensitive values in protected configuration or secret-management facilities. Start the service using the documented service-management procedure and inspect startup logs."
      },
      {
        title: "Initial Web Setup",
        content: "Open the SonarQube web interface, complete initial administrator setup, change default credentials, configure authentication, and create the first project. Restrict administrative access to authorized operators."
      },
      {
        title: "Installation Validation",
        content: "Verify that the web application is reachable, the database connection is healthy, background processing is operational, and a test project can complete an analysis. Review logs before declaring the installation production-ready."
      }
    ],
    exercise: "Install a supported SonarQube release in a non-production environment, configure its database, sign in, create a project, and capture the first successful analysis."
  },

  "Project Configuration": {
    title: "Project Configuration",
    description: "Configure project identity, source directories, language settings, branch analysis, and repository-specific analysis properties.",
    sections: [
      {
        title: "Project Key and Identity",
        content: "The project key uniquely identifies a project in SonarQube. Use a stable naming convention that maps clearly to repository and application ownership. Avoid changing project identity casually because integrations and historical analysis depend on it."
      },
      {
        title: "Analysis Properties File",
        content: "The sonar-project.properties file stores repository-specific analysis configuration. Keep non-secret project properties in version control so local and CI analysis use consistent settings."
      },
      {
        title: "Source and Test Directories",
        content: "Configure sonar.sources for production source directories and sonar.tests for test directories. Correctly identifying these paths helps SonarQube apply the right analysis rules and avoid treating test code as production code."
      },
      {
        title: "Language and Build Configuration",
        content: "Use the scanner and build integration appropriate for the project. For Maven projects, prefer the supported Sonar Maven integration. For Gradle, use the supported Gradle plugin. For other repositories, configure the scanner and required language properties."
      },
      {
        title: "Branch and Pull Request Analysis",
        content: "Configure branch and pull request analysis according to the installed SonarQube edition and CI integration. Confirm that branch names, pull request identifiers, and target branches are passed correctly."
      },
      {
        title: "Configuration Validation",
        content: "Run an analysis and inspect the analyzed file count, detected language, source paths, test paths, and project key. Incorrect paths can produce misleading coverage and issue results."
      }
    ],
    exercise: "Configure a Java project using sonar-project.properties. Set its project key, source path, test path, and coverage report location, then validate the resulting dashboard."
  },

  "Scanner Configuration": {
    title: "Scanner Configuration",
    description: "Understand scanner installation, authentication, execution, build integration, and report submission.",
    sections: [
      {
        title: "Scanner Types and Selection",
        content: "Choose the scanner that matches the build system and language. SonarScanner CLI is suitable for explicitly configured repositories. Maven and Gradle integrations connect analysis to their respective build lifecycles."
      },
      {
        title: "Scanner Installation",
        content: "Install a supported scanner version on the build agent or use an approved CI integration. Ensure the executable is available in PATH and that the agent can reach the SonarQube server."
      },
      {
        title: "Authentication Token Handling",
        content: "Generate a project analysis token or an appropriately scoped token. Supply it through a protected CI secret. Never commit tokens to sonar-project.properties, Docker images, shell scripts, or Git repositories."
      },
      {
        title: "Scanner Execution",
        content: "Run the scanner after the required build and test steps. The scanner needs access to source files and any reports that should be imported. Inspect scanner logs to confirm that the correct project and server were selected."
      },
      {
        title: "Scanner Properties",
        content: "Important properties include sonar.projectKey, sonar.host.url, sonar.sources, sonar.tests, sonar.java.binaries, and sonar.coverage.jacoco.xmlReportPaths where applicable. Property names and supported behavior depend on the scanner and analyzer version."
      },
      {
        title: "CI Scanner Reliability",
        content: "Pin or centrally manage scanner versions, inject tokens securely, preserve diagnostic logs, and configure pipeline failure behavior based on analysis status. Avoid running multiple conflicting analyses against the same project revision."
      }
    ],
    exercise: "Install SonarScanner on a test build agent, configure a project token as a secret, execute an analysis, and verify that the report appears in SonarQube."
  },

  "Quality Profiles": {
    title: "Quality Profiles",
    description: "Manage language-specific rule collections and control how static analysis rules are applied to projects.",
    sections: [
      {
        title: "Quality Profile Fundamentals",
        content: "A Quality Profile is a collection of active analysis rules for a programming language. It determines which rules are used when source code is analyzed. Different languages require different profiles."
      },
      {
        title: "Built-in and Custom Profiles",
        content: "Built-in profiles provide a starting point. Teams can create custom profiles to align analysis with engineering standards. Use a documented baseline rather than enabling arbitrary rules without understanding their impact."
      },
      {
        title: "Rule Activation and Severity",
        content: "Rules detect specific patterns such as null dereferences, insecure API usage, excessive complexity, and maintainability problems. Review rule descriptions, remediation guidance, language applicability, and severity before changing profile behavior."
      },
      {
        title: "Profile Inheritance",
        content: "Where supported, custom profiles can inherit from parent profiles. This helps teams maintain a common baseline while introducing project or organizational additions."
      },
      {
        title: "Profile Assignment",
        content: "Assign the correct profile to each project and language. Verify the active profile shown for the project before comparing analysis results across repositories."
      },
      {
        title: "Profile Governance",
        content: "Manage profile changes through review and version-controlled documentation. Test major rule changes against representative repositories before rolling them out across an organization."
      }
    ],
    exercise: "Create a custom Java Quality Profile from an existing profile, activate a suitable rule, assign it to a test project, and analyze a code sample that violates the rule."
  },

  "Quality Gates": {
    title: "Quality Gates",
    description: "Define measurable acceptance conditions that determine whether analyzed code meets an organization's quality standards.",
    sections: [
      {
        title: "Quality Gate Purpose",
        content: "A Quality Gate evaluates analysis measures against configured conditions. It provides a consistent pass or fail decision for a project or code change. It should represent enforceable engineering standards rather than an arbitrary score."
      },
      {
        title: "Conditions on New Code",
        content: "Common conditions include coverage on new code, duplicated lines, reliability issues, security issues, and maintainability issues. New-code conditions help teams prevent additional quality problems without requiring immediate cleanup of every legacy issue."
      },
      {
        title: "Gate Configuration",
        content: "Create or select a Quality Gate, configure thresholds, and assign it to projects. Choose thresholds based on the repository's maturity, testing practices, and security requirements."
      },
      {
        title: "Quality Gate Evaluation",
        content: "After report processing, SonarQube evaluates the analysis against the assigned gate. A failed condition causes the gate to fail. Review the exact failed condition instead of assuming that the overall project is unusable."
      },
      {
        title: "CI Pipeline Enforcement",
        content: "Use the CI integration or Quality Gate waiting mechanism supported by the environment. Configure the pipeline to wait for server-side processing when a reliable pass/fail decision is required. Do not treat scanner upload completion as gate success."
      },
      {
        title: "Quality Gate Governance",
        content: "Document thresholds, review changes, and communicate failures clearly. Avoid weakening a gate simply to make a pipeline green. Investigate whether the failure represents a real defect, missing report, or incorrect configuration."
      }
    ],
    exercise: "Configure a Quality Gate requiring an agreed coverage threshold on new code. Run an analysis with insufficient coverage and verify that the gate fails."
  },

  "Bug Detection": {
    title: "Bug Detection",
    description: "Identify reliability defects through static analysis and learn how to triage, reproduce, and correct findings.",
    sections: [
      {
        title: "What SonarQube Classifies as a Bug",
        content: "A bug is a coding issue that can lead to unexpected behavior or incorrect results. Examples include suspicious null handling, incorrect resource management, unreachable logic, and conditions that can produce runtime failures."
      },
      {
        title: "Common Defect Patterns",
        content: "Static analyzers can detect unsafe null dereferences, incorrect equality checks, resource leaks, suspicious control flow, and other language-specific patterns. The exact rules depend on the language analyzer and Quality Profile."
      },
      {
        title: "Issue Investigation",
        content: "Open the finding, inspect its rule description, affected line, surrounding code, severity, and remediation guidance. Follow the data flow and understand whether the reported path can occur in the real application."
      },
      {
        title: "False Positive and Accepted Status",
        content: "Some findings may not apply to the actual execution context. Use the issue workflow supported by the installed version to document false positives or accepted risks. Do not suppress findings without a clear technical reason."
      },
      {
        title: "Defect Remediation",
        content: "Fix the underlying condition rather than hiding the warning. Add or update unit tests to cover the corrected behavior. Re-run build, tests, and SonarQube analysis to verify that the issue is resolved."
      },
      {
        title: "Production Defect Prevention",
        content: "Use Quality Gates on new code, review critical findings early, and track recurring bug categories. Static analysis should be part of normal development rather than a cleanup activity performed only before release."
      }
    ],
    exercise: "Introduce a small reliability defect into a sample Java class, run analysis, inspect the reported issue, fix the code, and confirm the issue no longer appears."
  },

  "Vulnerability Analysis": {
    title: "Vulnerability Analysis",
    description: "Understand how SonarQube identifies security weaknesses and how teams investigate and remediate them.",
    sections: [
      {
        title: "Security Analysis Concepts",
        content: "Security analysis identifies code patterns that may expose applications to attacks. Findings can include unsafe input handling, insecure cryptographic usage, injection risks, and improper security controls."
      },
      {
        title: "Vulnerability Versus Security Hotspot",
        content: "A vulnerability is a detected security weakness requiring remediation. A Security Hotspot identifies security-sensitive code that needs human review to determine whether it creates a real risk in the application's context."
      },
      {
        title: "Common Application Security Risks",
        content: "Review SQL injection, command injection, path traversal, cross-site scripting, insecure deserialization, weak cryptography, and unsafe authentication or authorization patterns. Rule coverage varies by language and analyzer."
      },
      {
        title: "Triage and Risk Assessment",
        content: "Inspect the source location, data flow, input trust boundary, affected endpoint, and potential impact. Consider exploitability, exposure, privileges required, and business impact when prioritizing remediation."
      },
      {
        title: "Remediation and Verification",
        content: "Use parameterized queries, safe output encoding, strict input validation, secure APIs, and appropriate authorization controls. Add security tests and re-run analysis after fixing the issue."
      },
      {
        title: "Security Governance",
        content: "Define ownership and remediation timelines for security findings. Review hotspots before release and retain evidence of decisions. SonarQube complements dedicated security testing and should not be treated as a complete security audit."
      }
    ],
    exercise: "Analyze a sample Java endpoint containing unsafe SQL construction. Identify the security concern, replace it with parameterized access, and verify the updated analysis."
  },

  "Code Smells and Maintainability": {
    title: "Code Smells and Maintainability",
    description: "Use maintainability findings to identify complex, duplicated, poorly structured, or difficult-to-change code.",
    sections: [
      {
        title: "Understanding Code Smells",
        content: "A code smell is a pattern that makes software harder to understand, test, modify, or maintain. It may not immediately cause incorrect behavior, but it increases the risk and cost of future changes."
      },
      {
        title: "Common Maintainability Problems",
        content: "Examples include long methods, deeply nested conditions, duplicated logic, excessive parameters, unclear naming, and classes with too many responsibilities. The applicable rules vary by language."
      },
      {
        title: "Complexity and Cognitive Load",
        content: "High branching and nesting make code harder to reason about and test. Review complexity findings alongside method responsibilities, domain logic, and test coverage rather than refactoring solely to reduce a metric."
      },
      {
        title: "Technical Debt",
        content: "Technical debt estimates the effort associated with maintainability issues. It is an indicator for prioritization, not an exact prediction of project delivery time. Review high-impact findings in the context of application ownership."
      },
      {
        title: "Safe Refactoring",
        content: "Preserve observable behavior while improving structure. Add tests before changing complex logic, refactor in small steps, and compare test and analysis results after each change."
      },
      {
        title: "Maintainability Standards",
        content: "Establish code review expectations, naming conventions, complexity guidelines, and ownership. Use Quality Profiles and new-code Quality Gates to prevent maintainability from deteriorating."
      }
    ],
    exercise: "Refactor a long Java method into smaller focused methods. Preserve behavior with unit tests and compare the maintainability findings before and after the refactor."
  },

  "Code Duplication": {
    title: "Code Duplication",
    description: "Understand duplicated-block detection and reduce repeated implementation without introducing unsafe abstractions.",
    sections: [
      {
        title: "How Duplication Is Identified",
        content: "SonarQube detects repeated code blocks using language-specific duplication analysis. The analysis identifies repeated sequences and calculates duplication measures. Detection behavior differs across languages and file types."
      },
      {
        title: "Duplication Metrics",
        content: "Review duplicated lines, duplicated blocks, and duplication density. A high percentage can indicate repeated business logic, copy-pasted validation, or generated content. Metrics should be interpreted alongside repository structure."
      },
      {
        title: "Common Duplication Sources",
        content: "Repeated validation, copied service logic, repeated configuration, and duplicated test setup can create maintenance problems. Generated code and similar boilerplate may require carefully scoped exclusions."
      },
      {
        title: "Refactoring Repeated Logic",
        content: "Extract shared behavior into focused methods or components when the behavior is genuinely the same. Avoid creating a large generic abstraction merely to eliminate a small amount of duplication."
      },
      {
        title: "Duplication Exclusions",
        content: "Use supported duplication exclusion properties for generated files or content that should not be measured. Keep exclusions narrow and documented so meaningful duplicated business logic remains visible."
      },
      {
        title: "Verification",
        content: "Run analysis after refactoring and compare duplication metrics. Execute relevant tests to ensure that the shared implementation preserves the behavior of each original code path."
      }
    ],
    exercise: "Create two Java classes with repeated validation logic, refactor the shared behavior into a suitable component, and compare duplication metrics."
  },

  "Coverage Integration": {
    title: "Coverage Integration",
    description: "Import test coverage reports into SonarQube and verify that coverage measures represent the correct source and test execution.",
    sections: [
      {
        title: "Coverage Is Not Test Execution",
        content: "SonarQube does not automatically execute unit tests to generate coverage. A test framework and coverage tool must execute the tests and produce a supported report. SonarQube imports that report during analysis."
      },
      {
        title: "JaCoCo for Java Projects",
        content: "JaCoCo instruments Java execution and generates coverage reports. Configure the build to execute tests and generate the XML report required by the SonarQube Java analyzer."
      },
      {
        title: "Maven Coverage Workflow",
        content: "Configure the appropriate JaCoCo Maven plugin goals, execute the test lifecycle, and generate the XML report before SonarQube analysis. Ensure the report path matches the scanner configuration."
      },
      {
        title: "Gradle Coverage Workflow",
        content: "Configure the Gradle JaCoCo plugin, run tests, and generate the XML report. Ensure the SonarQube Gradle integration can locate the generated report."
      },
      {
        title: "Report Import Configuration",
        content: "For Java projects, configure sonar.coverage.jacoco.xmlReportPaths when a custom report location is required. Confirm that the report exists before the scanner starts."
      },
      {
        title: "Coverage Troubleshooting",
        content: "If coverage is zero or missing, inspect test execution, report generation, report format, file paths, source mappings, and scanner logs. A report generated for different source files may not map correctly."
      },
      {
        title: "Coverage Quality Gate",
        content: "Use coverage on new code as a measurable quality condition. Do not inflate coverage with meaningless assertions. Tests should verify application behavior and important edge cases."
      }
    ],
    exercise: "Configure JaCoCo in a Maven Java project, generate an XML coverage report, import it into SonarQube, and verify coverage on the dashboard."
  },

  "Exclusions and Inclusions": {
    title: "Exclusions and Inclusions",
    description: "Control which source files, test files, and analysis areas are included in a project analysis.",
    sections: [
      {
        title: "Why Scope Configuration Matters",
        content: "Correct analysis scope prevents generated files, build output, vendored dependencies, and unrelated content from distorting analysis. Overly broad exclusions can hide important application code."
      },
      {
        title: "Source and Test Scope",
        content: "Use sonar.sources and sonar.tests to define the main source and test directories. Verify that the configured paths exist in the CI workspace and match the repository layout."
      },
      {
        title: "File Pattern Exclusions",
        content: "Use supported wildcard patterns for sonar.exclusions and sonar.test.exclusions. Keep patterns specific and review their impact after analysis."
      },
      {
        title: "Coverage Exclusions",
        content: "Coverage exclusions affect which files contribute to coverage measures. They do not necessarily remove those files from all static analysis. Understand the distinction between coverage scope and source analysis scope."
      },
      {
        title: "Duplication Exclusions",
        content: "Duplication exclusions target code duplication measures. Use them for suitable generated or boilerplate content, not as a shortcut to hide repeated application logic."
      },
      {
        title: "Audit and Validate Exclusions",
        content: "Review the analysis log and project file list to verify the effective scope. Document each exclusion with an owner and reason, and periodically remove obsolete patterns."
      }
    ],
    exercise: "Configure source, test, coverage, and duplication exclusions for a sample Java repository. Verify that production code remains analyzed while generated output is handled correctly."
  },

  "Pull Request Decoration": {
    title: "Pull Request Decoration",
    description: "Connect pull request analysis to source control so developers can review new-code findings and Quality Gate results during code review.",
    sections: [
      {
        title: "Pull Request Analysis Flow",
        content: "A pull request triggers CI analysis. The scanner analyzes the proposed changes in the context of the target branch. SonarQube evaluates new-code findings and reports the result to the configured source control platform."
      },
      {
        title: "Required Integration Details",
        content: "Configure the supported source control integration, repository permissions, project binding, and CI pull request metadata. Exact requirements depend on the SonarQube edition and platform."
      },
      {
        title: "Pull Request Parameters",
        content: "Analysis may require the pull request key, source branch, and target branch. Use CI-provided values rather than hardcoding branch names. Verify parameter names and supported behavior for the installed scanner."
      },
      {
        title: "Decoration and Developer Feedback",
        content: "Pull request decoration can display Quality Gate status and analysis findings in the code review interface. Developers can address new issues before merging changes into the target branch."
      },
      {
        title: "Permission and Authentication",
        content: "Use a dedicated integration identity or supported application authorization. Grant only the repository permissions required for status reporting and decoration. Store credentials in CI or platform secret management."
      },
      {
        title: "Common Integration Failures",
        content: "Decoration may fail because of incorrect repository binding, insufficient permissions, invalid tokens, incorrect pull request metadata, or unsupported edition capabilities. Check both CI logs and SonarQube background task details."
      }
    ],
    exercise: "Connect a non-production repository to SonarQube pull request analysis. Open a test pull request, run CI analysis, and verify the reported Quality Gate status."
  },

  "Jenkins Integration": {
    title: "Jenkins Integration",
    description: "Build a secure Jenkins pipeline that compiles, tests, analyzes, and enforces SonarQube Quality Gate results.",
    sections: [
      {
        title: "Jenkins-to-SonarQube Architecture",
        content: "Jenkins orchestrates the pipeline. A Jenkins agent checks out source code, runs the build and tests, generates coverage reports, and executes SonarScanner. SonarQube processes the submitted report and evaluates the Quality Gate."
      },
      {
        title: "Configure SonarQube Server in Jenkins",
        content: "Install the appropriate Jenkins SonarQube integration, configure the SonarQube server URL, and define an authentication credential. Use Jenkins credential storage rather than placing tokens in the Jenkinsfile."
      },
      {
        title: "Configure Scanner Tools",
        content: "Configure a supported SonarScanner installation through Jenkins tool management or use the documented build-system integration. Ensure the selected agent has the required runtime and network access."
      },
      {
        title: "Pipeline Analysis Stage",
        content: "Run checkout, compile, test, coverage report generation, and SonarQube analysis in the correct order. The scanner must see the source files and generated reports from the same workspace and build."
      },
      {
        title: "Quality Gate Waiting",
        content: "Use the Jenkins integration's documented environment wrapper and Quality Gate waiting step. Configure a webhook on the SonarQube side when required by the integration. Apply a timeout so the pipeline does not wait forever."
      },
      {
        title: "Production Jenkinsfile Example",
        code: "pipeline {\n  agent any\n  stages {\n    stage('Checkout') {\n      steps { checkout scm }\n    }\n    stage('Build and Test') {\n      steps { sh 'mvn clean verify' }\n    }\n    stage('SonarQube Analysis') {\n      steps {\n        withSonarQubeEnv('SonarQube-Server') {\n          sh 'mvn sonar:sonar'\n        }\n      }\n    }\n    stage('Quality Gate') {\n      steps {\n        timeout(time: 5, unit: 'MINUTES') {\n          waitForQualityGate abortPipeline: true\n        }\n      }\n    }\n  }\n}",
      },
      {
        title: "Webhook Configuration",
        content: "Configure the SonarQube webhook to reach the Jenkins endpoint required by the installed integration. Validate DNS, firewall access, reverse proxy configuration, and webhook delivery status."
      },
      {
        title: "Secure Pipeline Practices",
        content: "Restrict token permissions, protect Jenkins credentials, avoid printing secrets, use trusted agents, pin tool versions, and retain useful analysis logs. Do not allow untrusted pull request jobs to access privileged credentials."
      },
      {
        title: "Jenkins Integration Troubleshooting",
        content: "Investigate scanner connection errors, authentication failures, missing coverage reports, incorrect project keys, webhook delivery failures, and Quality Gate timeouts. Check Jenkins console output and SonarQube background task details."
      }
    ],
    exercise: "Create a Jenkins pipeline for a Maven project. Run tests, import JaCoCo coverage, submit SonarQube analysis, wait for the Quality Gate, and verify that a failed gate stops the pipeline."
  },

  "Troubleshooting": {
    title: "Troubleshooting",
    description: "Diagnose common scanner, server, authentication, report-processing, and Quality Gate failures using logs and evidence.",
    sections: [
      {
        title: "Scanner Cannot Reach Server",
        content: "Check DNS resolution, server URL, port connectivity, TLS certificate trust, proxy settings, firewall rules, and service health. Confirm that the build agent can reach the configured endpoint."
      },
      {
        title: "Authentication and Authorization Errors",
        content: "Verify token validity, token scope, project permissions, and credential injection. Rotate exposed credentials and remove secrets from repository history when necessary."
      },
      {
        title: "Analysis Report Processing Failure",
        content: "Inspect scanner logs and the SonarQube background task details. Check server logs, available disk space, database health, memory pressure, and analyzer compatibility."
      },
      {
        title: "No Source Files Analyzed",
        content: "Verify sonar.sources, working directory, file patterns, exclusions, and repository checkout. Ensure that source files exist on the actual CI agent where the scanner executes."
      },
      {
        title: "Coverage Missing or Incorrect",
        content: "Confirm that tests executed, the coverage report was generated, the XML report path is correct, and report source paths match the analyzed repository."
      },
      {
        title: "Quality Gate Timeout",
