const statusStyles: Record<string, string> = {
  pending: "border-slate-700 bg-slate-900 text-slate-400",
  running: "border-blue-400 bg-blue-500/10 text-blue-300",
  success: "border-emerald-500/50 bg-emerald-500/10 text-emerald-300",
  failed: "border-red-500/50 bg-red-500/10 text-red-300",
  blocked: "border-amber-500/40 bg-amber-500/10 text-amber-300"
};

export default function CicdPipelineVisualizerPage() {
  const [selectedStage, setSelectedStage] = useState(0);
  const [selectedTopic, setSelectedTopic] = useState(0);
  const [builderStage, setBuilderStage] = useState(0);
  const [selectedExtraTopic, setSelectedExtraTopic] = useState(0);
  const [statuses, setStatuses] = useState<string[]>(stages.map(() => "pending"));
  const [logs, setLogs] = useState<string[]>(["Pipeline ready. Select Run Pipeline to begin."]);
  const [artifacts, setArtifacts] = useState<string[]>([]);
  const [running, setRunning] = useState(false);
  const [paused, setPaused] = useState(false);
  const [completed, setCompleted] = useState(false);
  const [failureStage, setFailureStage] = useState("none");
  const [activeTab, setActiveTab] = useState("learning");
  const [runNumber, setRunNumber] = useState(0);
  const [durations, setDurations] = useState<number[]>([]);
  const stopRef = useRef(false);
  const pauseRef = useRef(false);
  const runningRef = useRef(false);

  const stage = stages[selectedStage];
  const topic = stage.topics[selectedTopic] ?? stage.topics[0];
  const successCount = statuses.filter(s => s === "success").length;
  const failedCount = statuses.filter(s => s === "failed").length;
  const progress = Math.round((successCount / stages.length) * 100);

  useEffect(() => {
    pauseRef.current = paused;
  }, [paused]);

  const addLog = (message: string) => {
    setLogs(old => [`[${new Date().toLocaleTimeString()}] ${message}`, ...old].slice(0, 100));
  };

  const wait = async (ms: number) => {
    let elapsed = 0;
    while (elapsed < ms) {
      if (stopRef.current) return false;
      if (!pauseRef.current) elapsed += 100;
      await new Promise(resolve => setTimeout(resolve, 100));
    }
    return !stopRef.current;
  };

  const runPipeline = async (startAt = 0) => {
    if (runningRef.current) return;
    runningRef.current = true;
    stopRef.current = false;
    setRunning(true);
    setPaused(false);
    setCompleted(false);
    setRunNumber(n => n + 1);

    for (let i = startAt; i < stages.length; i++) {
      if (stopRef.current) break;

      setSelectedStage(i);
      setSelectedTopic(0);
      setStatuses(old => old.map((s, index) => index < i ? s : index === i ? "running" : "pending"));
      addLog(`Stage ${i + 1}: ${stages[i].name} started.`);

      const start = Date.now();
      const shouldFail = failureStage === String(i);

      const continued = await wait(shouldFail ? 1300 : 1100);
      if (!continued) break;

      if (shouldFail) {
        setStatuses(old => old.map((s, index) => index === i ? "failed" : index > i ? "blocked" : s));
        setDurations(old => [...old, Date.now() - start]);
        addLog(`ERROR: ${stages[i].name} failed. Downstream stages blocked.`);
        addLog(`Pipeline stopped. Fix the issue and retry from this stage.`);
        break;
      }

      setStatuses(old => old.map((s, index) => index === i ? "success" : s));
      setDurations(old => [...old, Date.now() - start]);

      if (i === 3) {
        setArtifacts(old => old.includes("payment-service.jar") ? old : [...old, "payment-service.jar"]);
        addLog("Artifact created: payment-service.jar");
      }
      if (i === 7) {
        setArtifacts(old => old.includes("payment-service:git-a1b2c3d") ? old : [...old, "payment-service:git-a1b2c3d"]);
        addLog("Docker image created: payment-service:git-a1b2c3d");
      }
      if (i === 8) {
        setArtifacts(old => old.includes("ECR image URI") ? old : [...old, "ECR image URI"]);
        addLog("Image pushed to Amazon ECR. Digest recorded.");
      }
      if (i === 9) {
        setArtifacts(old => old.includes("EKS Deployment") ? old : [...old, "EKS Deployment"]);
        addLog("Kubernetes workload deployed to EKS.");
      }
      if (i === 11) addLog("Production health checks passed. Monitoring is active.");

      addLog(`Stage ${i + 1}: ${stages[i].name} completed successfully.`);
    }

    const finalStatuses = statuses;
    runningRef.current = false;
    setRunning(false);
    setPaused(false);

    if (!stopRef.current) {
      setStatuses(current => {
        const allDone = current.every(s => s === "success");
        if (allDone) {
          setCompleted(true);
          addLog("PIPELINE SUCCESS: All 12 stages completed.");
        }
        return current;
      });
    }
  };

  const pausePipeline = () => {
    pauseRef.current = true;
    setPaused(true);
    addLog("Pipeline paused.");
  };

  const resumePipeline = () => {
    pauseRef.current = false;
    setPaused(false);
    addLog("Pipeline resumed.");
  };

  const resetPipeline = () => {
    stopRef.current = true;
    pauseRef.current = false;
    runningRef.current = false;
    setRunning(false);
    setPaused(false);
    setCompleted(false);
    setStatuses(stages.map(() => "pending"));
    setArtifacts([]);
    setDurations([]);
    setLogs(["Pipeline reset. Ready for a new execution."]);
  };

  const retryPipeline = () => {
    const failedIndex = statuses.findIndex(s => s === "failed");
    if (failedIndex < 0) {
      addLog("No failed stage to retry. Inject a failure or run the pipeline first.");
      return;
    }
    setStatuses(old => old.map((s, index) => index >= failedIndex ? "pending" : s));
    addLog(`Retry requested from ${stages[failedIndex].name}.`);
    setTimeout(() => runPipeline(failedIndex), 100);
  };

  const injectFailure = () => {
    if (running) {
      addLog("Stop or reset the current run before changing failure injection.");
      return;
    }
    if (failureStage === "none") {
      addLog("Select a stage from Failure Injection before running.");
      return;
    }
    addLog(`Failure injection armed for Stage ${Number(failureStage) + 1}: ${stages[Number(failureStage)].name}.`);
  };

  const learningModuleKey = activeTab === "fundamentals" ? "fundamentals" : "architecture";
  const learningModuleTopics = Object.entries(cicdTopicContent[learningModuleKey] ?? {});
  const selectedExtraTopicData = learningModuleTopics[selectedExtraTopic];

  const tabs = [
    ["learning", "Learning Center"],
    ["simulator", "Pipeline Simulator"],
    ["architecture", "Architecture"],
    ["config", "Configuration Library"],
    ["troubleshooting", "Troubleshooting"],
    ["deployment", "Deployment Strategies"],
    ["rollback", "Rollback Lab"],
    ["monitoring", "Monitoring Lab"],
    ["security", "Security Lab"],
    ["project", "Payment Project"],
    ["interview", "Interview Prep"],
    ["architecture-builder", "Interactive Architecture"],
    ["fundamentals", "CI/CD Fundamentals"],
    ["architecture-library", "Architecture Deep Dive"]
  ];

  return (
    <main className="min-h-screen bg-[#070b14] text-slate-100">
      <div className="mx-auto max-w-[1600px] px-4 py-6 md:px-7">
        <header className="mb-6 rounded-3xl border border-slate-800 bg-gradient-to-br from-[#111c32] via-[#101827] to-[#0b1220] p-6 md:p-8">
          <div className="flex flex-col justify-between gap-5 lg:flex-row lg:items-center">
            <div>
              <div className="mb-3 inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/10 px-3 py-1 text-xs font-semibold text-cyan-300">
                DEVOPS ENGINEERING LAB <span>•</span> END-TO-END CI/CD
              </div>
              <h1 className="text-3xl font-black tracking-tight md:text-4xl">CI/CD Pipeline Visualizer</h1>
              <p className="mt-3 max-w-3xl text-sm leading-6 text-slate-400 md:text-base">
                Learn and simulate a production-style Java payment application delivery pipeline —
                from developer commit to Kubernetes deployment and production monitoring.
              </p>
            </div>
            <div className="grid grid-cols-2 gap-3 sm:grid-cols-4">
              <Metric label="Pipeline stages" value="12" />
              <Metric label="Completed" value={`${successCount}/12`} />
              <Metric label="Progress" value={`${progress}%`} />
              <Metric label="Failed stages" value={`${failedCount}`} />
            </div>
          </div>
          <div className="mt-6 h-2 overflow-hidden rounded-full bg-slate-800">
            <div className="h-full rounded-full bg-gradient-to-r from-cyan-400 to-emerald-400 transition-all duration-500" style={{ width: `${progress}%` }} />
          </div>
          <div className="mt-2 flex justify-between text-xs text-slate-500">
            <span>Source code</span><span>Production health</span>
          </div>
        </header>

        <section className="mb-6 rounded-2xl border border-slate-800 bg-[#0c1422] p-4">
          <div className="mb-4 flex flex-wrap items-center justify-between gap-2">
            <div>
              <h2 className="text-lg font-bold">12-Stage CI/CD Pipeline</h2>
              <p className="text-xs text-slate-500">Select any stage to explore its lessons and implementation.</p>
            </div>
            <span className="rounded-lg border border-slate-700 px-3 py-1 text-xs text-slate-400">LEFT → RIGHT FLOW</span>
          </div>
          <div className="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-6">
            {stages.map((item, index) => (
              <button
                key={item.id}
                onClick={() => { setSelectedStage(index); setSelectedTopic(0); setActiveTab("learning"); }}
                className={`relative rounded-xl border p-3 text-left transition hover:-translate-y-0.5 hover:border-cyan-500/60 ${
                  selectedStage === index ? "border-cyan-400 bg-cyan-500/10 ring-1 ring-cyan-500/30" : statusStyles[statuses[index]]
                }`}
              >
                <div className="flex items-center justify-between">
                  <span className="text-xl">{item.icon}</span>
                  <span className="text-[10px] font-bold">STAGE {String(item.id).padStart(2, "0")}</span>
                </div>
                <div className="mt-2 text-sm font-bold">{item.name}</div>
                <div className="mt-1 text-[11px] text-slate-500">{item.tool}</div>
                <div className="mt-3 text-[10px] font-semibold uppercase tracking-wide">
                  {statuses[index] === "success" ? "✓ Completed" : statuses[index] === "running" ? "● Running" : statuses[index] === "failed" ? "✕ Failed" : statuses[index] === "blocked" ? "⊘ Blocked" : "○ Pending"}
                </div>
              </button>
            ))}
          </div>
          <div className="mt-4 flex flex-wrap gap-3 text-[11px] text-slate-500">
            <span>🟢 Success</span><span>🔵 Running</span><span>🔴 Failed</span><span>🟠 Blocked</span><span>⚪ Pending</span>
          </div>
        </section>

        <nav className="mb-5 flex gap-2 overflow-x-auto pb-2">
          {tabs.map(([id, label]) => (
            <button key={id} onClick={() => { setActiveTab(id); setSelectedExtraTopic(0); }} className={`shrink-0 rounded-xl border px-4 py-2.5 text-xs font-semibold transition ${activeTab === id ? "border-cyan-400 bg-cyan-500/10 text-cyan-300" : "border-slate-800 bg-slate-900 text-slate-400 hover:text-white"}`}>
              {label}
            </button>
          ))}
        </nav>

        {activeTab === "learning" && (
          <section className="grid gap-5 lg:grid-cols-[280px_minmax(0,1fr)]">
            <aside className="h-fit rounded-2xl border border-slate-800 bg-[#0c1422] p-4">
              <div className="mb-4">
                <div className="text-xs font-bold uppercase tracking-widest text-cyan-400">Course navigation</div>
                <h3 className="mt-2 text-lg font-bold">{stage.name}</h3>
                <p className="mt-1 text-xs text-slate-500">{stage.tool}</p>
              </div>
              <div className="space-y-2">
                {stage.topics.map((item, index) => (
                  <button key={item.title} onClick={() => setSelectedTopic(index)} className={`w-full rounded-xl border p-3 text-left text-sm transition ${selectedTopic === index ? "border-cyan-500/60 bg-cyan-500/10 text-cyan-200" : "border-slate-800 bg-slate-950/60 text-slate-400 hover:border-slate-600 hover:text-white"}`}>
                    <span className="mr-2 text-xs text-slate-600">{String(index + 1).padStart(2, "0")}</span>{item.title}
                  </button>
                ))}
              </div>
              <div className="mt-5 rounded-xl border border-slate-800 bg-slate-950 p-3">
                <div className="text-[10px] font-bold uppercase tracking-widest text-slate-500">Stage input</div>
                <p className="mt-1 text-xs text-slate-300">{stage.input}</p>
                <div className="mt-3 text-[10px] font-bold uppercase tracking-widest text-slate-500">Stage output</div>
                <p className="mt-1 text-xs text-emerald-300">{stage.output}</p>
              </div>
            </aside>

            <article className="min-w-0 rounded-2xl border border-slate-800 bg-[#0c1422] p-5 md:p-7">
              <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 pb-5">
                <div>
                  <div className="text-xs font-bold uppercase tracking-widest text-cyan-400">Stage {stage.id} / 12 · {stage.tool}</div>
                  <h2 className="mt-2 text-2xl font-black">{topic.title}</h2>
                  <p className="mt-2 text-sm text-slate-400">{stage.summary}</p>
                </div>
                <span className={`rounded-full border px-3 py-1 text-xs font-bold ${statusStyles[statuses[selectedStage]]}`}>{statuses[selectedStage].toUpperCase()}</span>
              </div>

              <div className="mt-6 space-y-6">
                <LessonSection title="01 · Concept and Definition" content={topic.overview} />
                <LessonSection title="02 · Purpose and Business Value" content={topic.purpose} />
                <LessonSection title="03 · Architecture" content={topic.architecture} />
                <LessonSection title="04 · Production Workflow" list={topic.workflow} />
                <LessonSection title="05 · Real Payment Application Example" content={topic.example} />
                <div>
                  <SectionHeading title="06 · Practical Commands" />
                  <div className="mt-3 space-y-2">
                    {topic.commands.map((command, i) => <div key={i} className="flex items-center justify-between gap-3 rounded-xl border border-slate-800 bg-[#070d18] p-3"><code className="overflow-x-auto text-xs text-emerald-300">{command}</code><button onClick={() => navigator.clipboard?.writeText(command)} className="shrink-0 rounded-lg border border-slate-700 px-2 py-1 text-[10px] text-slate-400 hover:text-white">Copy</button></div>)}
                  </div>
                </div>
                <LessonSection title="07 · Configuration Example" content={topic.configuration} />
                <LessonSection title="08 · Common Failures" list={topic.failures} />
                <LessonSection title="09 · Troubleshooting and Recovery" list={topic.recovery} />
                <LessonSection title="10 · Production Best Practices" list={topic.bestPractices} />
                <LessonSection title="11 · Hands-on Exercise" content={topic.exercise} />
                <LessonSection title="12 · Interview Questions" list={topic.interview} />
              </div>

              <div className="mt-8 flex flex-wrap justify-between gap-3 border-t border-slate-800 pt-5">
                <button disabled={selectedStage === 0} onClick={() => { setSelectedStage(s => s - 1); setSelectedTopic(0); }} className="rounded-xl border border-slate-700 px-4 py-2 text-sm text-slate-300 disabled:opacity-30">← Previous stage</button>
                <button onClick={() => setActiveTab("simulator")} className="rounded-xl bg-cyan-500 px-4 py-2 text-sm font-bold text-slate-950 hover:bg-cyan-400">Open simulator →</button>
                <button disabled={selectedStage === 11} onClick={() => { setSelectedStage(s => s + 1); setSelectedTopic(0); }} className="rounded-xl border border-slate-700 px-4 py-2 text-sm text-slate-300 disabled:opacity-30">Next stage →</button>
              </div>
            </article>
          </section>
        )}

        {(activeTab === "fundamentals" || activeTab === "architecture-library") && selectedExtraTopicData && (
          <section className="grid gap-5 lg:grid-cols-[300px_minmax(0,1fr)]">

            <aside className="h-fit rounded-2xl border border-slate-800 bg-[#0c1422] p-4">
              <div className="mb-4">
                <div className="text-xs font-bold uppercase tracking-widest text-cyan-400">
                  {activeTab === "fundamentals" ? "CI/CD FUNDAMENTALS" : "ARCHITECTURE DEEP DIVE"}
                </div>
                <h2 className="mt-2 text-lg font-bold">
                  {learningModuleTopics.length} Learning Lessons
                </h2>
                <p className="mt-1 text-xs text-slate-500">
                  Select a topic to explore its production implementation.
                </p>
              </div>

              <div className="space-y-2">
                {learningModuleTopics.map(([title], index) => (
                  <button
                    key={title}
                    onClick={() => setSelectedExtraTopic(index)}
                    className={`w-full rounded-xl border p-3 text-left text-sm transition ${
                      selectedExtraTopic === index
                        ? "border-cyan-500/60 bg-cyan-500/10 text-cyan-200"
                        : "border-slate-800 bg-slate-950/60 text-slate-400 hover:border-slate-600 hover:text-white"
                    }`}
                  >
                    <span className="mr-2 text-xs text-slate-600">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    {title}
                  </button>
                ))}
              </div>
            </aside>

            <article className="min-w-0 rounded-2xl border border-slate-800 bg-[#0c1422] p-5 md:p-7">
              <div className="border-b border-slate-800 pb-5">
                <div className="text-xs font-bold uppercase tracking-widest text-cyan-400">
                  {activeTab === "fundamentals" ? "CI/CD FUNDAMENTALS" : "PRODUCTION ARCHITECTURE"}
                </div>

                <h2 className="mt-2 text-2xl font-black">
                  {selectedExtraTopicData[0]}
                </h2>

                <p className="mt-2 text-sm text-slate-400">
                  Detailed concepts, practical implementation and production engineering guidance.
                </p>
              </div>

              <div className="mt-6 space-y-6">
                <LessonSection
                  title="01 · Concept and Overview"
                  content={selectedExtraTopicData[1].overview}
                />

                <LessonSection
                  title="02 · Purpose and Business Value"
                  content={selectedExtraTopicData[1].purpose}
                />

                <LessonSection
                  title="03 · Production Workflow"
                  list={selectedExtraTopicData[1].workflow}
                />

                <LessonSection
                  title="04 · Real-World Production Example"
                  content={selectedExtraTopicData[1].productionExample}
                />

                <div>
                  <SectionHeading title="05 · Practical Commands" />
                  <div className="mt-3 space-y-2">
                    {selectedExtraTopicData[1].commands.map((command, index) => (
                      <div
                        key={index}
                        className="flex items-center justify-between gap-3 rounded-xl border border-slate-800 bg-[#070d18] p-3"
                      >
                        <code className="overflow-x-auto text-xs text-emerald-300">
                          {command}
                        </code>
                        <button
                          onClick={() => navigator.clipboard?.writeText(command)}
                          className="shrink-0 rounded-lg border border-slate-700 px-2 py-1 text-[10px] text-slate-400 hover:text-white"
                        >
                          Copy
                        </button>
                      </div>
                    ))}
                  </div>
                </div>

                <LessonSection
                  title="06 · Failure Checks and Troubleshooting"
                  list={selectedExtraTopicData[1].failureChecks}
                />

                <LessonSection
                  title="07 · Production Best Practices"
                  list={selectedExtraTopicData[1].bestPractices}
                />
              </div>

              <div className="mt-8 flex justify-between gap-3 border-t border-slate-800 pt-5">
                <button
                  disabled={selectedExtraTopic === 0}
                  onClick={() => setSelectedExtraTopic(index => index - 1)}
                  className="rounded-xl border border-slate-700 px-4 py-2 text-sm text-slate-300 disabled:opacity-30"
                >
                  ← Previous Lesson
                </button>

                <button
                  disabled={selectedExtraTopic >= learningModuleTopics.length - 1}
                  onClick={() => setSelectedExtraTopic(index => index + 1)}
                  className="rounded-xl border border-cyan-500/40 bg-cyan-500/10 px-4 py-2 text-sm text-cyan-300 disabled:opacity-30"
                >
                  Next Lesson →
                </button>
              </div>
            </article>
          </section>
        )}
        {activeTab === "architecture-builder" && (
          <section className="space-y-5">
            <div className="rounded-2xl border border-cyan-500/30 bg-[#0c1422] p-5">
              <div className="text-xs font-bold uppercase tracking-widest text-cyan-400">Interactive Production Architecture</div>
              <h2 className="mt-2 text-2xl font-black">End-to-End CI/CD Pipeline</h2>
              <p className="mt-2 text-sm text-slate-400">Select any component to understand its role, inputs, outputs and production implementation.</p>
            </div>

            <div className="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
              {stages.map((item, index) => (
                <button
                  key={item.id}
                  onClick={() => setBuilderStage(index)}
                  className={`rounded-xl border p-4 text-left transition ${
                    builderStage === index
                      ? "border-cyan-400 bg-cyan-500/10 ring-1 ring-cyan-500/30"
                      : "border-slate-800 bg-[#0c1422] hover:border-cyan-500/50"
                  }`}
                >
                  <div className="text-2xl">{item.icon}</div>
                  <div className="mt-2 text-sm font-bold">{item.name}</div>
                  <div className="mt-1 text-xs text-slate-500">{item.tool}</div>
                  <div className="mt-3 text-[10px] font-bold uppercase text-cyan-400">Stage {item.id} →</div>
                </button>
              ))}
            </div>

            <div className="rounded-2xl border border-slate-800 bg-[#0c1422] p-5 md:p-7">
              <div className="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <div className="text-xs font-bold uppercase tracking-widest text-cyan-400">Selected component · Stage {stages[builderStage].id}/12</div>
                  <h3 className="mt-2 text-2xl font-black">{stages[builderStage].name}</h3>
                  <p className="mt-1 text-sm text-slate-400">{stages[builderStage].summary}</p>
                </div>
                <span className="text-3xl">{stages[builderStage].icon}</span>
              </div>

              <div className="mt-6 grid gap-3 md:grid-cols-2">
                <div className="rounded-xl border border-slate-800 bg-slate-950 p-4">
                  <div className="text-xs font-bold uppercase text-slate-500">Input</div>
                  <p className="mt-2 text-sm text-cyan-200">{stages[builderStage].input}</p>
                </div>
                <div className="rounded-xl border border-slate-800 bg-slate-950 p-4">
                  <div className="text-xs font-bold uppercase text-slate-500">Output</div>
                  <p className="mt-2 text-sm text-emerald-300">{stages[builderStage].output}</p>
                </div>
              </div>

              <div className="mt-6">
                <h4 className="font-bold">Production workflow</h4>
                <ol className="mt-3 space-y-3">
                  {stages[builderStage].topics[0].workflow.map((step, index) => (
                    <li key={index} className="flex gap-3 rounded-xl border border-slate-800 bg-slate-950 p-3">
                      <span className="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-cyan-500/10 text-xs font-bold text-cyan-300">{index + 1}</span>
                      <span className="text-sm leading-6 text-slate-300">{step}</span>
                    </li>
                  ))}
                </ol>
              </div>

              <div className="mt-6">
                <h4 className="font-bold">Related learning topics</h4>
                <div className="mt-3 grid gap-2 md:grid-cols-3">
                  {stages[builderStage].topics.map((topic, index) => (
                    <button
                      key={topic.title}
                      onClick={() => {
                        setSelectedStage(builderStage);
                        setSelectedTopic(index);
                        setActiveTab("learning");
                      }}
                      className="rounded-xl border border-slate-800 bg-slate-950 p-3 text-left text-sm text-slate-300 hover:border-cyan-500/50"
                    >
                      <span className="text-xs text-cyan-400">TOPIC {index + 1}</span>
                      <div className="mt-1 font-semibold">{topic.title}</div>
                    </button>
                  ))}
                </div>
              </div>

              <div className="mt-6 flex justify-between gap-3 border-t border-slate-800 pt-5">
                <button
                  disabled={builderStage === 0}
                  onClick={() => setBuilderStage(s => s - 1)}
                  className="rounded-xl border border-slate-700 px-4 py-2 text-sm disabled:opacity-30"
                >← Previous</button>
                <button
                  disabled={builderStage === 11}
                  onClick={() => setBuilderStage(s => s + 1)}
                  className="rounded-xl bg-cyan-500 px-4 py-2 text-sm font-bold text-slate-950 disabled:opacity-30"
                >Next Stage →</button>
              </div>
            </div>
          </section>
        )}
        {activeTab === "simulator" && (
          <section className="grid gap-5 xl:grid-cols-[minmax(0,1fr)_370px]">
            <div className="space-y-5">
              <div className="rounded-2xl border border-slate-800 bg-[#0c1422] p-5">
                <div className="flex flex-wrap items-center justify-between gap-3">
                  <div><h2 className="text-xl font-black">Pipeline Execution Simulator</h2><p className="mt-1 text-xs text-slate-500">Frontend simulation of a CI/CD execution. It does not connect to real AWS, Jenkins or EKS infrastructure.</p></div>
                  <span className={`rounded-full border px-3 py-1 text-xs ${completed ? "border-emerald-500/50 text-emerald-300" : failedCount ? "border-red-500/50 text-red-300" : "border-slate-700 text-slate-400"}`}>{completed ? "SUCCESS" : failedCount ? "FAILED" : running ? paused ? "PAUSED" : "RUNNING" : "READY"}</span>
                </div>
                <div className="mt-5 flex flex-wrap gap-2">
                  <button disabled={running} onClick={() => runPipeline(0)} className="rounded-xl bg-emerald-500 px-4 py-2.5 text-sm font-bold text-slate-950 disabled:opacity-40">▶ Run Pipeline</button>
                  <button disabled={!running || paused} onClick={pausePipeline} className="rounded-xl border border-slate-700 px-4 py-2.5 text-sm disabled:opacity-40">Ⅱ Pause</button>
                  <button disabled={!running || !paused} onClick={resumePipeline} className="rounded-xl border border-slate-700 px-4 py-2.5 text-sm disabled:opacity-40">▶ Resume</button>
                  <button onClick={resetPipeline} className="rounded-xl border border-slate-700 px-4 py-2.5 text-sm">↻ Reset</button>
                  <button disabled={running || failedCount === 0} onClick={retryPipeline} className="rounded-xl border border-amber-500/40 px-4 py-2.5 text-sm text-amber-300 disabled:opacity-40">Retry failed stage</button>
                </div>
                <div className="mt-5 grid gap-3 sm:grid-cols-3">
                  <Metric label="Run number" value={`#${runNumber}`} />
                  <Metric label="Successful stages" value={`${successCount}/12`} />
                  <Metric label="Pipeline progress" value={`${progress}%`} />
                </div>
              </div>

              <div className="rounded-2xl border border-slate-800 bg-[#0c1422] p-5">
                <h3 className="font-bold">Execution stages</h3>
                <div className="mt-4 space-y-2">
                  {stages.map((item, index) => (
                    <button key={item.id} onClick={() => { setSelectedStage(index); setSelectedTopic(0); }} className={`flex w-full items-center gap-3 rounded-xl border p-3 text-left ${statusStyles[statuses[index]]}`}>
                      <span className="text-lg">{item.icon}</span>
                      <span className="min-w-0 flex-1"><span className="block text-sm font-bold">{item.id}. {item.name}</span><span className="block truncate text-[11px] opacity-70">{item.tool}</span></span>
                      <span className="text-[10px] font-bold">{statuses[index].toUpperCase()}</span>
                    </button>
                  ))}
                </div>
              </div>

              <div className="rounded-2xl border border-slate-800 bg-[#0c1422] p-5">
                <h3 className="font-bold">Pipeline execution logs</h3>
                <div className="mt-3 max-h-80 space-y-2 overflow-y-auto rounded-xl bg-[#050911] p-4 font-mono text-xs">
                  {logs.map((log, i) => <div key={i} className={log.includes("ERROR") || log.includes("FAILED") ? "text-red-300" : log.includes("success") || log.includes("SUCCESS") ? "text-emerald-300" : "text-slate-400"}>{log}</div>)}
                </div>
              </div>
            </div>

            <aside className="space-y-5">
              <div className="rounded-2xl border border-slate-800 bg-[#0c1422] p-5">
                <h3 className="font-bold">Failure Injection Lab</h3>
                <p className="mt-2 text-xs leading-5 text-slate-500">Choose a stage. When the pipeline reaches it, the simulator will fail that stage and block every downstream stage.</p>
                <select value={failureStage} onChange={e => setFailureStage(e.target.value)} disabled={running} className="mt-4 w-full rounded-xl border border-slate-700 bg-slate-950 p-3 text-sm text-white">
                  <option value="none">No injected failure</option>
                  {stages.map((s, i) => <option key={s.id} value={String(i)}>Stage {s.id}: {s.name}</option>)}
                </select>
                <button onClick={injectFailure} disabled={running} className="mt-3 w-full rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm font-bold text-red-300 disabled:opacity-40">Arm failure injection</button>
              </div>
              <div className="rounded-2xl border border-slate-800 bg-[#0c1422] p-5">
                <h3 className="font-bold">Artifact tracking</h3>
                <p className="mt-1 text-xs text-slate-500">Artifacts created during successful stages.</p>
                <div className="mt-4 space-y-2">
                  {["payment-service.jar", "payment-service:git-a1b2c3d", "ECR image URI", "EKS Deployment"].map((item, i) => (
                    <div key={item} className={`rounded-xl border p-3 text-xs ${artifacts.includes(item) ? "border-emerald-500/40 bg-emerald-500/10 text-emerald-300" : "border-slate-800 bg-slate-950 text-slate-600"}`}>
                      <span className="mr-2">{artifacts.includes(item) ? "✓" : "○"}</span>{item}
                    </div>
                  ))}
                </div>
              </div>
              <div className="rounded-2xl border border-slate-800 bg-[#0c1422] p-5">
                <h3 className="font-bold">Pipeline rules</h3>
                <ul className="mt-3 space-y-2 text-xs leading-5 text-slate-400">
                  <li>• A failed stage blocks downstream stages.</li>
                  <li>• A retry starts from the failed stage.</li>
                  <li>• Artifacts are recorded after successful stages.</li>
                  <li>• Reset clears the simulated execution.</li>
                  <li>• This is a learning simulator, not a live deployment.</li>
                </ul>
              </div>
            </aside>
          </section>
        )}

        {activeTab === "architecture" && <InfoLab title="End-to-End Architecture Explorer" description="The complete payment delivery architecture connects developer source control, CI automation, quality and security validation, artifact storage, Kubernetes deployment and production observability." items={["Developer workstation → GitHub repository", "GitHub webhook → Jenkins controller and agents", "Maven → JAR artifact → automated test reports", "SonarQube quality gate → security scanners", "Docker build → Amazon ECR image repository", "Amazon EKS → Kubernetes Deployments, Services and Pods", "Helm release configuration → Argo CD GitOps reconciliation", "Prometheus metrics → Grafana dashboards → Alertmanager"]} />}
        {activeTab === "config" && <InfoLab title="Configuration Library" description="Core configuration files used across the 12-stage payment application pipeline." items={["Jenkinsfile — pipeline stages, agent, tools, credentials, post actions and artifact archiving.", "pom.xml — Java version, Spring Boot dependencies, Maven plugins and test configuration.", "Dockerfile — multi-stage build, runtime image, non-root user and application entrypoint.", ".dockerignore — excludes target output, Git metadata, IDE files and local secrets.", "deployment.yaml — EKS Deployment, image reference, replicas, resources and probes.", "service.yaml — stable Kubernetes service and Pod selector.", "values.yaml — Helm chart defaults for image, replica count, resources and service.", "Argo CD Application — Git repository, path, destination cluster and sync policy.", "prometheus-rules.yaml — service availability, error-rate and latency alerts."]} />}
        {activeTab === "troubleshooting" && <InfoLab title="Production Troubleshooting Center" description="Follow the evidence-first incident workflow. Identify the failing layer before changing configuration." items={["GitHub webhook not triggering Jenkins — inspect delivery response, endpoint access and job configuration.", "Jenkins agent offline — inspect agent connectivity, labels, executors and workspace permissions.", "Maven build failure — inspect compiler output, dependency resolution and test reports.", "SonarQube gate failure — inspect analysis status, webhook delivery and gate conditions.", "Trivy scan failure — inspect image reference, scanner database and vulnerability report.", "Docker build failure — inspect build context, Dockerfile instructions and artifact path.", "ECR push denied — verify AWS identity, region, repository URI and IAM permissions.", "Pod ImagePullBackOff — inspect image tag, ECR repository and node pull permissions.", "CrashLoopBackOff — inspect previous container logs, events, probes and application configuration.", "Argo CD OutOfSync — inspect Git revision, manifest diff, sync status and live drift.", "High API latency — correlate Prometheus metrics, application logs and recent deployment changes."]} />}
        {activeTab === "deployment" && <InfoLab title="Deployment Strategy Lab" description="Choose a rollout strategy according to risk, traffic control and rollback requirements." items={["Rolling Update — progressively replaces old Pods with new Pods. Configure maxSurge and maxUnavailable.", "Blue-Green — deploy a separate environment and switch traffic after validation. Keep the previous environment available for rollback.", "Canary — send a small portion of traffic to the new version, monitor metrics and gradually increase traffic.", "Readiness probes — prevent traffic from reaching containers that are not ready.", "Rollout status — use kubectl rollout status and inspect Deployment conditions.", "Release validation — verify payment API health, latency, error rate and dependency connectivity."]} />}
        {activeTab === "rollback" && <InfoLab title="Rollback Practice Lab" description="Rollback must restore a known-good application version and configuration. Database changes require a compatible migration strategy." items={["Identify the failed release using deployment history.", "Capture the current Pod status, events and application logs.", "Select the previous known-good Helm revision or image digest.", "Run helm rollback or kubectl rollout undo in the approved environment.", "Wait for rollout completion and check Pod readiness.", "Run payment API smoke tests.", "Confirm error rate and latency return to expected levels.", "Record incident cause and preventive action."]} />}
        {activeTab === "monitoring" && <InfoLab title="Production Monitoring Lab" description="Use service-level signals to validate a deployment and identify customer-impacting incidents." items={["Availability — percentage of successful health checks and requests.", "Latency — p50, p95 and p99 response-time trends.", "Traffic — request volume and payment transaction throughput.", "Errors — HTTP 5xx rate, failed transactions and dependency errors.", "Saturation — CPU, memory, Pod capacity and database connection usage.", "Prometheus — scrape application and Kubernetes metrics.", "Grafana — create dashboards for payment request rate, latency and errors.", "Alertmanager — route actionable alerts to the responsible team."]} />}
        {activeTab === "security" && <InfoLab title="DevSecOps Security Lab" description="Security validation is integrated into the delivery pipeline rather than postponed until production." items={["Dependency scanning — identify vulnerable third-party packages.", "Secret scanning — detect accidentally committed credentials.", "SonarQube — analyze bugs, vulnerabilities and maintainability issues.", "Trivy filesystem scan — inspect source dependencies and configuration.", "Trivy image scan — inspect the final container image.", "IAM least privilege — restrict Jenkins push and deployment permissions.", "Container hardening — use minimal images, non-root users and controlled capabilities.", "Kubernetes security — apply RBAC, network policies and secret-management controls.", "Exception management — document owner, reason, compensating control and expiry."]} />}
        {activeTab === "project" && <InfoLab title="Complete Hands-on Payment Application" description="Use this project as a practical learning path. Each milestone corresponds to the 12 pipeline stages." items={["Build a Java Spring Boot payment REST API.", "Create a GitHub repository and feature branch workflow.", "Configure pull request review and branch protection.", "Connect GitHub webhooks to Jenkins.", "Create a Jenkinsfile and Maven build.", "Write JUnit unit and integration tests.", "Configure SonarQube quality gate.", "Add dependency and Trivy security scans.", "Build a versioned Docker image.", "Create an ECR repository and push the image.", "Deploy to EKS using Kubernetes and Helm.", "Connect Argo CD and GitOps deployment configuration.", "Create Prometheus metrics and Grafana dashboards.", "Practice a failed rollout, rollback and production health validation."]} />}
        {activeTab === "interview" && <InfoLab title="CI/CD Interview Preparation" description="Use these questions to explain the complete delivery lifecycle from source code to production." items={["Explain the complete CI/CD workflow from a developer commit to production.", "What is the difference between continuous integration, delivery and deployment?", "How does a GitHub webhook trigger Jenkins?", "Explain Jenkins controller, agents, executors and workspaces.", "What is the difference between Maven package and verify?", "How do JUnit reports become visible in Jenkins?", "What is a SonarQube quality gate and how is it enforced?", "How do dependency and container image scans differ?", "What is the difference between a Docker image tag and digest?", "How does Jenkins authenticate to Amazon ECR?", "Explain EKS, Deployment, ReplicaSet, Pod and Service.", "How do readiness and liveness probes differ?", "What is Helm and how does Helm rollback work?", "Explain Argo CD sync, drift detection and GitOps.", "How do Prometheus and Grafana work together?", "How would you investigate a production payment API failure?"]} />}

        <footer className="mt-8 border-t border-slate-800 py-5 text-center text-xs text-slate-600">
          DevMavox · CI/CD Pipeline Visualizer · Educational simulation — connect real infrastructure separately for live deployments.
        </footer>
      </div>
    </main>
  );
}

function Metric({ label, value }: { label: string; value: string }) {
  return <div className="rounded-xl border border-slate-800 bg-slate-950/70 p-3"><div className="text-[10px] font-semibold uppercase tracking-widest text-slate-500">{label}</div><div className="mt-1 text-xl font-black text-white">{value}</div></div>;
}

function SectionHeading({ title }: { title: string }) {
  return <h3 className="text-sm font-bold text-cyan-300">{title}</h3>;
}

function LessonSection({ title, content, list }: { title: string; content?: string; list?: string[] }) {
  return (
    <section>
      <SectionHeading title={title} />
      {content && <p className="mt-3 rounded-xl border border-slate-800 bg-slate-950/60 p-4 text-sm leading-7 text-slate-300">{content}</p>}
      {list && <ol className="mt-3 space-y-2">{list.map((item, i) => <li key={i} className="flex gap-3 rounded-xl border border-slate-800 bg-slate-950/60 p-3 text-sm leading-6 text-slate-300"><span className="font-bold text-cyan-400">{String(i + 1).padStart(2, "0")}</span><span>{item}</span></li>)}</ol>}
    </section>
  );
}

function InfoLab({ title, description, items }: { title: string; description: string; items: string[] }) {
  return (
    <section className="rounded-2xl border border-slate-800 bg-[#0c1422] p-5 md:p-7">
      <div className="mb-6 border-b border-slate-800 pb-5"><div className="text-xs font-bold uppercase tracking-widest text-cyan-400">DevMavox practical lab</div><h2 className="mt-2 text-2xl font-black">{title}</h2><p className="mt-2 max-w-3xl text-sm leading-6 text-slate-400">{description}</p></div>
      <div className="grid gap-3 md:grid-cols-2">
        {items.map((item, i) => <div key={i} className="rounded-xl border border-slate-800 bg-slate-950/60 p-4"><div className="mb-2 text-xs font-bold text-cyan-400">MODULE {String(i + 1).padStart(2, "0")}</div><p className="text-sm leading-6 text-slate-300">{item}</p></div>)}
      </div>
    </section>
  );
}
