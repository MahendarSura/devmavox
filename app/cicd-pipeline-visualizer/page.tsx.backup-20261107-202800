                  onClick={() => navigate(-1)}
                  disabled={activeIndex === 0}
                  className="rounded-xl border border-slate-700 px-4 py-3 text-sm font-semibold text-slate-300 transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-30"
                >
                  ← Previous Stage
                </button>

                <span className="text-xs text-slate-500">
                  Stage {activeIndex + 1} of {stages.length}
                </span>

                <button
                  onClick={() => navigate(1)}
                  disabled={activeIndex === stages.length - 1}
                  className="rounded-xl bg-cyan-400 px-4 py-3 text-sm font-bold text-slate-950 transition hover:bg-cyan-300 disabled:cursor-not-allowed disabled:opacity-30"
                >
                  Next Stage →
                </button>
              </div>

            </div>
          </article>
        </section>

        <footer className="mt-8 rounded-2xl border border-slate-800 bg-slate-900 p-5">
          <h2 className="text-lg font-bold text-white">
            Complete Developer to Production Workflow
          </h2>
          <p className="mt-2 text-sm leading-7 text-slate-400">
            This is a representative production architecture. Organizations
            may use different build systems, CI platforms, registries and
            deployment tools. Required build, test, quality and security gates
            must pass before their dependent release stages proceed.
          </p>
        </footer>

      </div>
    </main>
  );
}
